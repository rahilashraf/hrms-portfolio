POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_dev_password
POSTGRES_PORT=5436

REDIS_PORT=6380

DATABASE_URL=postgresql://hrms:hrms_dev_password@localhost:5436/hrms?schema=public

REDIS_URL=redis://localhost:6380

# Frontend API origin; set this to the HTTPS API origin in production.
NEXT_PUBLIC_API_URL=http://localhost:3001

# PORT is not set locally (the API defaults to 3001, the web app to 3000). In production the
# API refuses to start without it; hosting platforms usually set it; see docs/deployment.md.

# Generate a unique secret for this environment, for example:
# openssl rand -base64 48
JWT_ACCESS_SECRET=
WEB_ORIGIN=http://localhost:3000
# In production, set deliberately to the trusted proxy hop count for your
# hosting topology. Do not use trust-all forwarded-header behavior.
TRUST_PROXY_HOPS=

# Password hashing defaults: 65536 KiB memory, 3 iterations, 1 thread.
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Browser refresh cookies use SameSite=Lax. Production frontend and API
# should be same-site, e.g. hr.example.com and api.example.com. Two unrelated
# hosting-provider default domains are not the intended setup.

# Google Workspace integration (optional). Create an OAuth client (type: Web
# application) in your own Google Cloud project; the redirect URI is the API callback, e.g.
# https://api.example.com/integrations/google/oauth/callback. Leave all three empty to disable
# OAuth connections (the endpoints answer 503).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# AES-256-GCM key for integration credentials: base64 of exactly 32 bytes, e.g.
# openssl rand -base64 32
# Keep it in your secret store only; it is never written to the database. Without it no
# Google credentials can be stored. When rotating, move the old key to
# INTEGRATION_ENCRYPTION_PREVIOUS_KEYS (comma-separated) until connections are re-saved.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_PREVIOUS_KEYS=

# The deployment's SMTP server, for account and notification email when an
# organization has no Google Workspace Gmail connection (any standard provider: your mail
# server, Microsoft 365, Amazon SES, SendGrid, Postmark, Mailgun...). Leave SMTP_HOST empty to
# disable. Set the same values for the API and the worker. SMTP_SECURITY: tls (port 465),
# starttls (587, the default) or none (development only, e.g. Mailpit on port 1025).
# SMTP_FROM is a plain sender address; SMTP_USER and SMTP_PASSWORD go together.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Worker only. "true" enables the daily deletion of sessions revoked or expired over 90
# days ago and account links used or expired over 30 days ago. Empty or "false" (the default)
# keeps the job scheduled but it deletes nothing.
AUTH_RECORD_RETENTION_ENABLED=

# Worker only. "true" schedules attendance automation (daily period generation and
# no-show detection); each organization still opts in through its time policy. Empty or "false"
# (the default) schedules neither. Any other value stops the worker at start-up.
TIME_ATTENDANCE_AUTOMATION_ENABLED=

# Worker only. "true" schedules employee lifecycle automation (hourly: apply due
# scheduled terminations, end assignments past their end date). Empty or "false" (the default)
# schedules neither; authorized users then apply due transitions by hand. Any other value stops
# the worker at start-up.
EMPLOYEE_LIFECYCLE_AUTOMATION_ENABLED=

# Worker only. The retained-grant reconciliation job
# (employee.reconcile-retained-grants) disables a terminated person's login once an approved
# KEEP grant stops being effective. It runs whatever EMPLOYEE_LIFECYCLE_AUTOMATION_ENABLED says.
# Empty or "true" (the default) schedules it every 15 minutes; "false" removes the schedule on
# the next worker start (rollback switch only). Any other value stops the worker at start-up.
RETAINED_GRANT_RECONCILIATION_ENABLED=
# Optional five-field cron expression (UTC) replacing the default "7,22,37,52 * * * *"; an
# invalid expression stops the worker at start-up.
RETAINED_GRANT_RECONCILIATION_CRON=

# API, optional. Kiosk identification failure limits; empty keeps the defaults
# (device 30/300 s, device+employee 5/900 s, employee 15/900 s, organization 300/300 s).
KIOSK_DEVICE_FAILURE_LIMIT=
KIOSK_DEVICE_FAILURE_WINDOW_SECONDS=
KIOSK_DEVICE_EMPLOYEE_FAILURE_LIMIT=
KIOSK_DEVICE_EMPLOYEE_FAILURE_WINDOW_SECONDS=
KIOSK_EMPLOYEE_FAILURE_LIMIT=
KIOSK_EMPLOYEE_FAILURE_WINDOW_SECONDS=
KIOSK_ORGANIZATION_FAILURE_LIMIT=
KIOSK_ORGANIZATION_FAILURE_WINDOW_SECONDS=

# Observability. API logs are JSON lines in production and text elsewhere; override
# with LOG_FORMAT=json|text. Probes: GET /health (liveness) and GET /ready (PostgreSQL + Redis).
LOG_FORMAT=
# Worker: jobs processed in parallel per process (1-10, default 1), an optional HTTP health
# server (GET /health, GET /ready) on this port, and how long SIGTERM waits for active jobs.
# The worker also writes a heartbeat to the Redis key hrms:worker:heartbeat every 15 seconds.
WORKER_CONCURRENCY=
WORKER_HEALTH_PORT=
WORKER_SHUTDOWN_TIMEOUT_MS=

# Document file storage (API and worker: the worker's hourly documents.cleanup-uploads job
# removes unattached uploads with the same settings). DOCUMENT_STORAGE_DRIVER: none (the default; uploads
# are refused and documents stay links or references), local (a directory, for development and
# tests; refused when NODE_ENV=production unless DOCUMENT_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true)
# or s3 (any private S3-compatible bucket; https endpoint in production). PostgreSQL stays the
# source of truth; object keys are generated by the server.
DOCUMENT_STORAGE_DRIVER=
DOCUMENT_STORAGE_LOCAL_DIR=
DOCUMENT_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=
# Signs local download links (HMAC-SHA256, 60 seconds): at least 32 bytes, e.g.
# openssl rand -base64 32. Keep it in your secret store only.
DOCUMENT_URL_SIGNING_KEY=
# S3-compatible storage: the bucket must be private (no public access); path-style addressing
# for providers that need it. Credentials stay on the server; browsers only receive presigned
# 60-second download links.
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_REGION=
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ACCESS_KEY_ID=
DOCUMENT_S3_SECRET_ACCESS_KEY=
DOCUMENT_S3_FORCE_PATH_STYLE=
# Upload size limit in bytes: 10485760 (10 MB) by default, at most 26214400 (25 MB).
DOCUMENT_UPLOAD_MAX_BYTES=
# Optional hardening: when true, files are refused unless a malware scanner is configured, and
# unscanned files are never downloadable. No scanner ships with this release.
DOCUMENT_REQUIRE_MALWARE_SCAN=
