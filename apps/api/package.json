  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:db": "vitest run --config ./vitest.config.db.ts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "authz:sync-permissions": "node dist/authorization/cli.js sync-permissions",
    "authz:bootstrap-owner": "node dist/authorization/cli.js bootstrap-owner",
    "authz:create-initial-user": "node dist/authorization/cli.js create-initial-user",
    "db:seed": "tsx prisma/seed.ts",
    "demo": "tsx demo/demo-cli.ts",
    "scheduling:extend-generated-shifts": "node dist/scheduling/cli.js extend-generated-shifts",
    "leave:process-entitlements": "node dist/leave/cli.js process-entitlements",
    "dev": "nest start --watch"
  },
  "dependencies": {
    "@hrms/config": "workspace:*",
    "@hrms/validation": "workspace:*",
    "@nestjs/common": "^12.3.3",
