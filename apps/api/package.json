    "aws4fetch": "1.0.20",
    "bullmq": "^6.3.10",
    "busboy": "1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.3",
