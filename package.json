{
  "name": "hrms",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Full-stack Human Resource Management System",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:worker": "turbo run build --filter=worker",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "pnpm --dir apps/api run db:seed",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo.mjs reset"
  },
  "devDependencies": {
    "dotenv": "^18.0.5",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  }
}
