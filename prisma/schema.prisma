generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
  LOCKED
  ARCHIVED
}

enum AccountTokenType {
  INVITATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum RoleAssignmentScopeType {
  SYSTEM
  ORGANIZATION
  ORGANIZATIONAL_UNIT
  DEPARTMENT
  TEAM
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
  CONTRACT
}

/// Batch 5A — an employee-wide termination: scheduled for a future last day, applied once every
/// affected assignment has ended in its own time zone, or cancelled / superseded before that.
enum EmployeeTerminationStatus {
  SCHEDULED
  APPLIED
  CANCELLED
  SUPERSEDED
}

/// Security remediation M3 — what happens to one role grant when a termination applies.
enum TerminationGrantDecisionKind {
  REVOKE
  KEEP
}

/// M3 — a KEEP is REQUESTED, then APPROVED or REJECTED by someone else (or CANCELLED by a
/// manager); a REVOKE is DECIDED. CANCELLED also marks decisions of a cancelled termination.
enum TerminationGrantDecisionStatus {
  DECIDED
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// M3 — what the application did: REVOKED, RETAINED (an expiring replacement grant), or
/// ALREADY_REVOKED (someone revoked it first).
enum TerminationGrantOutcome {
  REVOKED
  RETAINED
  ALREADY_REVOKED
}

/// Batch 5A — what a termination does to one assignment when it applies.
enum EmployeeTerminationAssignmentAction {
  END
  CANCEL
}

enum EmploymentAssignmentStatus {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}

enum TimeEntryStatus {
  OPEN
  CLOSED
  VOIDED
}

/// LIVE_CLOCK: live capture through the employee's authenticated self-service (web). KIOSK:
/// live capture at a trusted onsite attendance device (Phase 9.5). MANUAL: recorded or
/// corrected by an authorized user. SYSTEM: generated by the system (resolutions, auto-close).
enum TimeEntrySource {
  LIVE_CLOCK
  MANUAL
  SYSTEM
  KIOSK
}

enum TimePunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

/// Same meanings as TimeEntrySource; also the source of an AttendanceSignIn. A KIOSK punch or
/// sign-in always names its AttendanceDevice (database-enforced).
enum TimePunchSource {
  LIVE_CLOCK
  MANUAL
  SYSTEM
  KIOSK
}

enum BreakPayType {
  PAID
  UNPAID
}

enum AttendanceExceptionType {
  MISSING_CLOCK_OUT
  AUTO_CLOSED_CLOCK_OUT
  OPEN_BREAK_AUTO_CLOSED
  LONG_SHIFT
  LATE_ARRIVAL
  EARLY_DEPARTURE
  UNSCHEDULED_WORK
  SCHEDULE_CHANGED_AFTER_ATTENDANCE
  /// Phase 9.5 — presence (SIGN_IN_ONLY) signals; never raised for time entries.
  LATE_SIGN_IN
  UNSCHEDULED_SIGN_IN
  /// Batch 4A — time recorded in approved or locked time; outside the approved payroll snapshot
  /// until the timesheet is reopened and approved again.
  RECORDED_AFTER_APPROVAL
  /// Batch 4C — a published shift with no attendance on its assignment (review, non-blocking).
  NO_SHOW
}

enum AttendanceExceptionSeverity {
  INFO
  REVIEW
  ACTION_REQUIRED
}

enum AttendanceExceptionWorkflowImpact {
  NON_BLOCKING
  SUBMISSION_BLOCKING
}

enum AttendanceExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED
  SUPERSEDED
}

enum AttendanceExceptionResolutionMethod {
  SYSTEM_AUTO_RESOLUTION
  EMPLOYEE_RESOLUTION
  MANAGER_RESOLUTION
  ADMIN_RESOLUTION
}

enum TimeCorrectionType {
  ADD_MISSING_CLOCK_IN
  ADD_MISSING_CLOCK_OUT
  CHANGE_CLOCK_IN
  CHANGE_CLOCK_OUT
  CHANGE_BREAK_START
  CHANGE_BREAK_END
  ADD_BREAK
  REMOVE_BREAK
  CHANGE_ASSIGNMENT
  ADD_MISSING_TIME_ENTRY
  CHANGE_COVERAGE
}

enum TimeCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum TimeAdjustmentSource {
  EMPLOYEE_APPROVED
  EMPLOYEE_AUTO_APPROVED
  MANAGER_DIRECT
  ADMIN_DIRECT
}

enum TimePeriodStatus {
  UPCOMING
  OPEN
  CLOSED
  LOCKED
}

enum TimePeriodCadence {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  CUSTOM
}

enum TimesheetStatus {
  OPEN
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  LOCKED
}

enum TimesheetSegmentStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum TimesheetEventType {
  SUBMITTED
  SEGMENT_APPROVED
  CHANGES_REQUESTED
  LOCKED
  REOPENED
  /// Batch 4C — the timesheet itself became APPROVED (every segment approved).
  APPROVED
}

enum TimeAttendancePolicyScopeType {
  SYSTEM
  ORGANIZATION
  ORGANIZATIONAL_UNIT
  DEPARTMENT
  TEAM
  EMPLOYMENT_ASSIGNMENT
}

enum TimeAttendancePolicyInheritanceMode {
  INHERIT
  OVERRIDE
}

enum ScheduleScopeType {
  ORGANIZATION
  ORGANIZATIONAL_UNIT
  DEPARTMENT
  TEAM
}

enum ScheduleType {
  STANDARD
  AD_HOC
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum ScheduledShiftStatus {
  ACTIVE
  CANCELLED
}

enum ScheduledShiftSourceType {
  MANUAL
  PATTERN
}

enum ScheduledShiftRevisionType {
  PUBLISHED_BASELINE
  CORRECTED
  CANCELLED
}

/// ISO weekday order (Monday first); never a locale or runtime-specific number.
enum ScheduleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleConflictType {
  SAME_ASSIGNMENT_OVERLAP
  EMPLOYEE_ASSIGNMENT_OVERLAP
  MINIMUM_REST_VIOLATION
  MAXIMUM_SHIFT_DURATION_EXCEEDED
}

/// How Schedules are segmented into periods. Only weekly (Monday–Sunday) is supported today.
enum SchedulePeriodType {
  WEEKLY
}

/// What happens when an employee clocks in with no matching published shift (Batch 9).
enum UnscheduledWorkMode {
  ALLOW_UNSCHEDULED
  WARN_UNSCHEDULED
  REQUIRE_SCHEDULED_SHIFT
}

/// Severity a policy may assign to a configurable conflict; ERROR is never overrideable.
enum SchedulePolicyConflictSeverity {
  WARNING
  ERROR
}

model Person {
  id                    String                 @id @default(uuid()) @db.Uuid
  firstName             String?
  middleName            String?
  lastName              String?
  preferredName         String?
  personalEmail         String?
  phone                 String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  archivedAt            DateTime?              @db.Timestamptz(6)
  user                  User?
  employee              Employee?
  recruitmentCandidates RecruitmentCandidate[] @relation("RecruitmentCandidatePerson")
  recruitmentHires      RecruitmentHire[]      @relation("RecruitmentHirePerson")
}

model Employee {
  id                           String                    @id @default(uuid()) @db.Uuid
  personId                     String                    @unique @db.Uuid
  employeeNumber               String                    @unique
  status                       EmployeeStatus            @default(ACTIVE)
  hireDate                     DateTime                  @db.Date
  terminationDate              DateTime?                 @db.Date
  createdAt                    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                  @updatedAt @db.Timestamptz(6)
  archivedAt                   DateTime?                 @db.Timestamptz(6)
  person                       Person                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  benefitDependents            BenefitDependent[]        @relation("EmployeeBenefitDependents")
  performanceReviewsAsReviewer PerformanceReview[]       @relation("PerformanceReviewer")
  performanceEvidence          PerformanceEvidence[]     @relation("EmployeePerformanceEvidence")
  assignments                  EmploymentAssignment[]
  timeEntries                  TimeEntry[]
  timePunches                  TimePunch[]
  timeExceptions               AttendanceException[]
  correctionRequests           TimeCorrectionRequest[]
  timeAdjustments              TimeAdjustment[]
  timesheets                   Timesheet[]
  leaveAccounts                LeaveAccount[]
  leaveRequests                LeaveRequest[]
  attendanceCredentials        AttendanceCredential[]
  attendanceSignIns            AttendanceSignIn[]
  payrollRunEmployees          PayrollRunEmployee[]
  hiringManagerOpenings        JobOpening[]              @relation("JobOpeningHiringManager")
  recruitmentCandidacies       RecruitmentCandidate[]    @relation("RecruitmentInternalCandidates")
  recruitmentHires             RecruitmentHire[]         @relation("RecruitmentHireEmployee")
  documents                    EmployeeDocument[]        @relation("EmployeeDocuments")
  documentAcknowledgements     DocumentAcknowledgement[] @relation("EmployeeDocumentAcknowledgements")
  terminations                 EmployeeTermination[]

  @@index([status, hireDate])
  @@index([terminationDate])
}

model EmploymentAssignment {
  id                           String                          @id @default(uuid()) @db.Uuid
  employeeId                   String                          @db.Uuid
  positionId                   String                          @db.Uuid
  employmentType               EmploymentType
  status                       EmploymentAssignmentStatus      @default(PLANNED)
  startDate                    DateTime                        @db.Date
  endDate                      DateTime?                       @db.Date
  isPrimary                    Boolean                         @default(false)
  managerAssignmentId          String?                         @db.Uuid
  createdAt                    DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                        @updatedAt @db.Timestamptz(6)
  employee                     Employee                        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position                     Position                        @relation("PositionAssignments", fields: [positionId], references: [id], onDelete: Restrict)
  manager                      EmploymentAssignment?           @relation("AssignmentManager", fields: [managerAssignmentId], references: [id], onDelete: Restrict)
  benefitEnrollments           BenefitEnrollment[]             @relation("AssignmentBenefitEnrollments")
  performanceReviews           PerformanceReview[]             @relation("AssignmentPerformanceReviews")
  performanceGoals             PerformanceGoal[]               @relation("AssignmentPerformanceGoals")
  performanceEvidence          PerformanceEvidence[]           @relation("AssignmentPerformanceEvidence")
  reports                      EmploymentAssignment[]          @relation("AssignmentManager")
  timeEntries                  TimeEntry[]
  payrollRetroRequirements     PayrollRetroRequirement[]
  payrollRetroResolutions      PayrollRetroResolution[]
  timeEntryAssignmentCoverages TimeEntryAssignmentCoverage[]
  timePunches                  TimePunch[]
  timePolicies                 TimeAttendancePolicy[]
  timeExceptions               AttendanceException[]
  correctionRequests           TimeCorrectionRequest[]         @relation("TimeCorrectionAffectedAssignment")
  targetCorrectionRequests     TimeCorrectionRequest[]         @relation("TimeCorrectionTargetAssignment")
  timeAdjustments              TimeAdjustment[]
  timesheetSegments            TimesheetSegment[]
  scheduledShifts              ScheduledShift[]                @relation("AssignmentScheduledShifts")
  scheduledShiftRevisions      ScheduledShiftRevision[]        @relation("AssignmentScheduledShiftRevisions")
  schedulePatterns             EmployeeSchedulePattern[]       @relation("AssignmentSchedulePatterns")
  leavePolicies                LeavePolicy[]                   @relation("LeavePolicyAssignment")
  leaveAccounts                LeaveAccount[]
  leaveRequests                LeaveRequest[]
  compensationRecords          CompensationRecord[]
  attendanceSignIns            AttendanceSignIn[]
  payrollRunAssignments        PayrollRunAssignment[]
  payrollAdjustments           PayrollAdjustment[]
  recruitmentHires             RecruitmentHire[]               @relation("RecruitmentHireAssignment")
  employeeWorkflows            EmployeeWorkflow[]              @relation("AssignmentEmployeeWorkflows")
  documents                    EmployeeDocument[]              @relation("AssignmentDocuments")
  terminationEffects           EmployeeTerminationAssignment[]
  rehiredAfterTerminations     EmployeeTermination[]           @relation("TerminationRehireAssignment")

  @@unique([id, employeeId])
  @@index([employeeId, status, startDate, endDate])
  @@index([employeeId, isPrimary, startDate, endDate])
  @@index([positionId, status, startDate, endDate])
  @@index([managerAssignmentId])
}

model User {
  id                           String                             @id @default(uuid()) @db.Uuid
  payrollRetroRequirements     PayrollRetroRequirement[]          @relation("PayrollRetroRequirementCreator")
  payrollRetroResolutions      PayrollRetroResolution[]           @relation("PayrollRetroResolutionActor")
  benefitPlansCreated          BenefitPlan[]                      @relation("BenefitPlanAuthor")
  benefitRatesCreated          BenefitRate[]                      @relation("BenefitRateAuthor")
  benefitRulesCreated          BenefitEligibilityRule[]           @relation("BenefitRuleAuthor")
  benefitDependentsCreated     BenefitDependent[]                 @relation("BenefitDependentAuthor")
  benefitEnrollmentsCreated    BenefitEnrollment[]                @relation("BenefitEnrollmentAuthor")
  personId                     String                             @unique @db.Uuid
  email                        String                             @unique
  passwordHash                 String?
  status                       UserStatus                         @default(INVITED)
  emailVerifiedAt              DateTime?                          @db.Timestamptz(6)
  mustChangePassword           Boolean                            @default(false)
  failedLoginAttempts          Int                                @default(0)
  lockedUntil                  DateTime?                          @db.Timestamptz(6)
  lastLoginAt                  DateTime?                          @db.Timestamptz(6)
  passwordChangedAt            DateTime?                          @db.Timestamptz(6)
  createdAt                    DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                           @updatedAt @db.Timestamptz(6)
  archivedAt                   DateTime?                          @db.Timestamptz(6)
  person                       Person                             @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions                     AuthSession[]
  accountTokens                AccountToken[]
  auditLogs                    AuditLog[]                         @relation("AuditActor")
  roleAssignments              RoleAssignment[]                   @relation("AssignmentUser")
  terminationsRecorded         EmployeeTermination[]              @relation("TerminationRecorder")
  terminationsCancelled        EmployeeTermination[]              @relation("TerminationCanceller")
  terminationGrantRequests     EmployeeTerminationGrantDecision[] @relation("TerminationGrantRequester")
  terminationGrantReviews      EmployeeTerminationGrantDecision[] @relation("TerminationGrantReviewer")
  createdAssignments           RoleAssignment[]                   @relation("AssignmentCreator")
  revokedAssignments           RoleAssignment[]                   @relation("AssignmentRevoker")
  requestedTimeCorrections     TimeCorrectionRequest[]            @relation("TimeCorrectionRequestor")
  reviewedTimeCorrections      TimeCorrectionRequest[]            @relation("TimeCorrectionReviewer")
  timeAdjustments              TimeAdjustment[]                   @relation("TimeAdjustmentActor")
  submittedTimesheets          Timesheet[]                        @relation("TimesheetSubmitter")
  approvedTimesheets           Timesheet[]                        @relation("TimesheetApprover")
  lockedTimesheets             Timesheet[]                        @relation("TimesheetLocker")
  reopenedTimesheets           Timesheet[]                        @relation("TimesheetReopener")
  reviewedAttendanceExceptions AttendanceException[]              @relation("AttendanceExceptionReviewer")
  recordedAttendanceSignOuts   AttendanceSignOut[]                @relation("AttendanceSignOutRecorder")
  voidedAttendanceSignOuts     AttendanceSignOut[]                @relation("AttendanceSignOutVoider")
  reviewedTimesheetSegments    TimesheetSegment[]                 @relation("TimesheetSegmentReviewer")
  timesheetEvents              TimesheetEvent[]                   @relation("TimesheetEventActor")
  publishedSchedules           Schedule[]                         @relation("SchedulePublisher")
  scheduleConflictOverrides    ScheduleConflictOverride[]         @relation("ScheduleConflictOverrider")
  scheduledShiftRevisions      ScheduledShiftRevision[]           @relation("ScheduledShiftRevisionAuthor")
  leaveLedgerEntries           LeaveLedgerEntry[]                 @relation("LeaveLedgerAuthor")
  leaveRequestsRequested       LeaveRequest[]                     @relation("LeaveRequestRequester")
  leaveRequestsDecided         LeaveRequest[]                     @relation("LeaveRequestDecider")
  leaveRequestEvents           LeaveRequestEvent[]                @relation("LeaveRequestEventActor")
  leaveAmendments              LeaveRequestAmendment[]            @relation("LeaveAmendmentActor")
  compensationRecords          CompensationRecord[]               @relation("CompensationAuthor")
  registeredAttendanceDevices  AttendanceDevice[]                 @relation("AttendanceDeviceRegistrar")
  revokedAttendanceDevices     AttendanceDevice[]                 @relation("AttendanceDeviceRevoker")
  issuedAttendanceCredentials  AttendanceCredential[]             @relation("AttendanceCredentialIssuer")
  revokedAttendanceCredentials AttendanceCredential[]             @relation("AttendanceCredentialRevoker")
  recordedAttendanceSignIns    AttendanceSignIn[]                 @relation("AttendanceSignInRecorder")
  voidedAttendanceSignIns      AttendanceSignIn[]                 @relation("AttendanceSignInVoider")
  createdPayrollRuns           PayrollRun[]                       @relation("PayrollRunCreator")
  payrollEarningLines          PayrollEarningLine[]               @relation("PayrollEarningLineAuthor")
  payrollDeductionLines        PayrollDeductionLine[]             @relation("PayrollDeductionLineAuthor")
  payrollContributionLines     PayrollEmployerContributionLine[]  @relation("PayrollContributionLineAuthor")
  createdPayrollAdjustments    PayrollAdjustment[]                @relation("PayrollAdjustmentAuthor")
  cancelledPayrollAdjustments  PayrollAdjustment[]                @relation("PayrollAdjustmentCanceller")
  approvedPayrollRuns          PayrollRun[]                       @relation("PayrollRunApprover")
  calculatedPayrollRuns        PayrollRun[]                       @relation("PayrollRunCalculator")
  compensationClosures         CompensationRecordClosure[]        @relation("CompensationClosureActor")
  finalizedPayrollRuns         PayrollRun[]                       @relation("PayrollRunFinalizer")
  voidedPayrollRuns            PayrollRun[]                       @relation("PayrollRunVoider")
  recruitmentInterviews        RecruitmentInterviewer[]           @relation("RecruitmentInterviewerUser")
  workflowTemplateTasksOwned   WorkflowTemplateTask[]             @relation("WorkflowTemplateTaskOwner")
  employeeWorkflowTasksOwned   EmployeeWorkflowTask[]             @relation("EmployeeWorkflowTaskOwner")
  notificationsReceived        Notification[]                     @relation("NotificationRecipient")
  notificationPreferences      NotificationPreference[]           @relation("NotificationPreferenceUser")
  googleOAuthStates            GoogleOAuthState[]                 @relation("GoogleOAuthStateInitiator")

  @@index([status])
}

model AuthSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @db.Uuid
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?
  previousTokenValidUntil  DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt               DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt                DateTime  @db.Timestamptz(6)
  revokedAt                DateTime? @db.Timestamptz(6)
  revokedReason            String?
  ipAddress                String?
  userAgent                String?
  user                     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model AccountToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      AccountTokenType
  tokenHash String           @unique
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt DateTime         @db.Timestamptz(6)
  usedAt    DateTime?        @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type, expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String
  entityType    String?
  entityId      String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([correlationId])
  @@index([occurredAt])
}

model Organization {
  id                         String                            @id @default(uuid()) @db.Uuid
  name                       String
  code                       String                            @unique
  description                String?
  sortOrder                  Int                               @default(0)
  archivedAt                 DateTime?                         @db.Timestamptz(6)
  createdAt                  DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                          @updatedAt @db.Timestamptz(6)
  units                      OrganizationalUnit[]              @relation("OrganizationUnits")
  departments                Department[]                      @relation("OrganizationDepartments")
  teams                      Team[]                            @relation("OrganizationTeams")
  jobTitles                  JobTitle[]                        @relation("OrganizationJobTitles")
  positions                  Position[]                        @relation("OrganizationPositions")
  workLocations              WorkLocation[]                    @relation("OrganizationWorkLocations")
  physicalSites              PhysicalSite[]                    @relation("OrganizationPhysicalSites")
  roles                      Role[]                            @relation("OrganizationRoles")
  assignments                RoleAssignment[]                  @relation("AssignmentOrganization")
  timePolicies               TimeAttendancePolicy[]            @relation("TimePolicyOrganization")
  timePeriods                TimePeriod[]
  schedules                  Schedule[]                        @relation("OrganizationSchedules")
  schedulePolicies           SchedulePolicy[]                  @relation("SchedulePolicyOrganization")
  scheduleTemplates          ScheduleTemplate[]                @relation("OrganizationScheduleTemplates")
  /// IANA timezone of the organization: the fallback after a position's WorkLocation timezone
  /// when converting local dates (leave days, holidays) to instants. Never silently UTC.
  timezone                   String?
  benefitPlans               BenefitPlan[]                     @relation("OrganizationBenefitPlans")
  performanceCompetencies    PerformanceCompetency[]           @relation("OrganizationPerformanceCompetencies")
  performanceScales          PerformanceRatingScale[]          @relation("OrganizationPerformanceScales")
  performanceTemplates       PerformanceTemplate[]             @relation("OrganizationPerformanceTemplates")
  performanceCycles          PerformanceCycle[]                @relation("OrganizationPerformanceCycles")
  performanceGoals           PerformanceGoal[]                 @relation("OrganizationPerformanceGoals")
  performanceEvidenceSources PerformanceEvidenceSource[]       @relation("OrganizationPerformanceEvidenceSources")
  performanceEvidence        PerformanceEvidence[]             @relation("OrganizationPerformanceEvidence")
  holidays                   OrganizationHoliday[]             @relation("OrganizationHolidays")
  leaveTypes                 LeaveType[]                       @relation("OrganizationLeaveTypes")
  leavePolicies              LeavePolicy[]                     @relation("LeavePolicyOrganization")
  payGroups                  PayGroup[]                        @relation("OrganizationPayGroups")
  compensationRecords        CompensationRecord[]              @relation("CompensationOrganization")
  attendanceDevices          AttendanceDevice[]
  payrollCalendars           PayrollCalendar[]                 @relation("PayrollCalendarOrganization")
  payrollPeriods             PayrollPeriod[]                   @relation("PayrollPeriodOrganization")
  payrollRuns                PayrollRun[]                      @relation("PayrollRunOrganization")
  payrollAdjustments         PayrollAdjustment[]               @relation("PayrollAdjustmentOrganization")
  recruitmentStages          RecruitmentStage[]                @relation("OrganizationRecruitmentStages")
  jobOpenings                JobOpening[]                      @relation("OrganizationJobOpenings")
  recruitmentCandidates      RecruitmentCandidate[]            @relation("OrganizationRecruitmentCandidates")
  recruitmentIntakeSources   RecruitmentIntakeSource[]         @relation("OrganizationRecruitmentIntakeSources")
  workflowTemplates          WorkflowTemplate[]                @relation("OrganizationWorkflowTemplates")
  employeeWorkflows          EmployeeWorkflow[]                @relation("OrganizationEmployeeWorkflows")
  documentTypes              DocumentType[]                    @relation("OrganizationDocumentTypes")
  employeeDocuments          EmployeeDocument[]                @relation("OrganizationEmployeeDocuments")
  policyDocuments            PolicyDocument[]                  @relation("OrganizationPolicyDocuments")
  documentRequirements       DocumentRequirement[]             @relation("OrganizationDocumentRequirements")
  documentStoredObjects      DocumentStoredObject[]            @relation("OrganizationDocumentStoredObjects")
  notificationTemplates      NotificationTemplate[]            @relation("OrganizationNotificationTemplates")
  notifications              Notification[]                    @relation("OrganizationNotifications")
  notificationSettings       OrganizationNotificationSetting[] @relation("OrganizationNotificationSettings")
  notificationPolicy         OrganizationNotificationPolicy?   @relation("OrganizationNotificationPolicy")
  googleConnections          GoogleWorkspaceConnection[]       @relation("OrganizationGoogleConnections")
  googleOAuthStates          GoogleOAuthState[]                @relation("OrganizationGoogleOAuthStates")
  googleFormBindings         GoogleFormBinding[]               @relation("OrganizationGoogleFormBindings")
  moduleSettings             OrganizationModuleSetting[]       @relation("OrganizationModuleSettings")
  settings                   OrganizationSetting[]             @relation("OrganizationSettings")
  settingChanges             OrganizationSettingChange[]       @relation("OrganizationSettingChanges")
  branding                   OrganizationBranding?             @relation("OrganizationBranding")

  @@index([archivedAt, sortOrder])
}

model OrganizationalUnit {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @db.Uuid
  parentUnitId      String?                  @db.Uuid
  name              String
  code              String
  description       String?
  sortOrder         Int                      @default(0)
  archivedAt        DateTime?                @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)
  organization      Organization             @relation("OrganizationUnits", fields: [organizationId], references: [id], onDelete: Restrict)
  parentUnit        OrganizationalUnit?      @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: Restrict)
  benefitRules      BenefitEligibilityRule[] @relation("BenefitRuleUnit")
  childUnits        OrganizationalUnit[]     @relation("UnitHierarchy")
  departments       Department[]             @relation("UnitDepartments")
  teams             Team[]                   @relation("UnitTeams")
  positions         Position[]               @relation("UnitPositions")
  scopedAssignments RoleAssignment[]         @relation("AssignmentUnit")
  timePolicies      TimeAttendancePolicy[]   @relation("TimePolicyUnit")
  schedules         Schedule[]               @relation("UnitSchedules")
  schedulePolicies  SchedulePolicy[]         @relation("SchedulePolicyUnit")
  holidays          OrganizationHoliday[]    @relation("HolidayUnit")
  leavePolicies     LeavePolicy[]            @relation("LeavePolicyUnit")
  jobOpenings       JobOpening[]             @relation("UnitJobOpenings")

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, sortOrder])
  @@index([organizationId, parentUnitId])
  @@index([parentUnitId])
}

model Department {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  organizationalUnitId String?                  @db.Uuid
  name                 String
  code                 String
  description          String?
  sortOrder            Int                      @default(0)
  archivedAt           DateTime?                @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)
  organization         Organization             @relation("OrganizationDepartments", fields: [organizationId], references: [id], onDelete: Restrict)
