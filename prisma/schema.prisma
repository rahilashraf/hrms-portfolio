  actor                  User                   @relation("TimeAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  correctionRequest      TimeCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  timeEntry              TimeEntry?             @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  breakEntry             BreakEntry?            @relation(fields: [breakEntryId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment?  @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)

  @@index([employeeId, appliedAt])
  @@index([timeEntryId, appliedAt])
  @@index([breakEntryId, appliedAt])
}

