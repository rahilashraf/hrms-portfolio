model TimeEntry {
  id                       String                        @id @default(uuid()) @db.Uuid
  employeeId               String                        @db.Uuid
  employmentAssignmentId   String                        @db.Uuid
  clockInAt                DateTime                      @db.Timestamptz(6)
  clockOutAt               DateTime?                     @db.Timestamptz(6)
  timezone                 String
  workDate                 DateTime                      @db.Date
  status                   TimeEntryStatus               @default(OPEN)
  source                   TimeEntrySource               @default(LIVE_CLOCK)
  createdAt                DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                      @updatedAt @db.Timestamptz(6)
  archivedAt               DateTime?                     @db.Timestamptz(6)
  /// Expected-work link (Phase 7): the published ScheduledShift this attendance was matched to and
  /// the immutable published revision its interpretation consumed. Both set or both null.
  scheduledShiftId         String?                       @db.Uuid
  scheduledShiftRevisionId String?                       @db.Uuid
  employee                 Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment     EmploymentAssignment          @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  scheduledShift           ScheduledShift?               @relation("TimeEntryScheduledShift", fields: [scheduledShiftId], references: [id], onDelete: Restrict)
  scheduledShiftRevision   ScheduledShiftRevision?       @relation("TimeEntryScheduledShiftRevision", fields: [scheduledShiftRevisionId, scheduledShiftId], references: [id, scheduledShiftId], onDelete: Restrict)
  punches                  TimePunch[]
  breaks                   BreakEntry[]
  exceptions               AttendanceException[]
  correctionRequests       TimeCorrectionRequest[]
  adjustments              TimeAdjustment[]
  assignmentCoverages      TimeEntryAssignmentCoverage[]

  @@unique([id, employeeId])
  @@unique([id, employeeId, employmentAssignmentId])
  @@index([employeeId, status, clockInAt])
  @@index([employmentAssignmentId, workDate])
  @@index([workDate])
  @@index([scheduledShiftId])
  @@index([scheduledShiftRevisionId])
}

/// Multi-assignment attendance: every assignment one physical TimeEntry covers, its payroll
/// owner (TimeEntry.employmentAssignmentId) included. The TimeEntry stays the only source of
/// elapsed minutes and pays only its owner; secondary coverage never adds worked time.
/// Append-only (corrections set removedAt); one active row per entry and assignment (partial
/// unique index), same employee (FKs) and same organization as the owner (trigger), in SQL.
model TimeEntryAssignmentCoverage {
  id                     String               @id @default(uuid()) @db.Uuid
  timeEntryId            String               @db.Uuid
  employeeId             String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  removedAt              DateTime?            @db.Timestamptz(6)
  timeEntry              TimeEntry            @relation(fields: [timeEntryId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Restrict)
  employmentAssignment   EmploymentAssignment @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([timeEntryId])
  @@index([employmentAssignmentId, timeEntryId])
}

model BreakEntry {
  id                 String                  @id @default(uuid()) @db.Uuid
  timeEntryId        String                  @db.Uuid
  startAt            DateTime                @db.Timestamptz(6)
  endAt              DateTime?               @db.Timestamptz(6)
  payType            BreakPayType?
  removedAt          DateTime?               @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  timeEntry          TimeEntry               @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  correctionRequests TimeCorrectionRequest[]
  adjustments        TimeAdjustment[]

  @@index([timeEntryId, startAt])
}

model TimePunch {
  id                     String               @id @default(uuid()) @db.Uuid
  employeeId             String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  timeEntryId            String?              @db.Uuid
  type                   TimePunchType
  occurredAt             DateTime             @db.Timestamptz(6)
  timezone               String
  source                 TimePunchSource      @default(LIVE_CLOCK)
  /// Phase 9.5 — the trusted kiosk that captured a KIOSK punch (set iff source = KIOSK).
  attendanceDeviceId     String?              @db.Uuid
  metadata               Json?
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  attendanceDevice       AttendanceDevice?    @relation(fields: [attendanceDeviceId], references: [id], onDelete: Restrict)
  employee               Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  /// A punch belongs to one entry of the same employee. Its employmentAssignmentId is the raw
  /// assignment recorded when it occurred and may intentionally differ from the entry's corrected
  /// assignment; it never follows entry corrections (punches are immutable evidence).
  timeEntry              TimeEntry?           @relation(fields: [timeEntryId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Restrict)

  @@index([employeeId, occurredAt])
  @@index([employmentAssignmentId, occurredAt])
  @@index([timeEntryId])
  @@index([attendanceDeviceId, occurredAt])
}

model AttendanceException {
  id                       String                               @id @default(uuid()) @db.Uuid
  employeeId               String                               @db.Uuid
  employmentAssignmentId   String?                              @db.Uuid
  timeEntryId              String?                              @db.Uuid
  /// Phase 9.5 — a presence exception's sign-in (never together with timeEntryId).
  attendanceSignInId       String?                              @db.Uuid
  type                     AttendanceExceptionType
  severity                 AttendanceExceptionSeverity
  workflowImpact           AttendanceExceptionWorkflowImpact
  status                   AttendanceExceptionStatus            @default(OPEN)
  resolutionMethod         AttendanceExceptionResolutionMethod?
  detectedAt               DateTime                             @default(now()) @db.Timestamptz(6)
  resolvedAt               DateTime?                            @db.Timestamptz(6)
  reason                   String?
  metadata                 Json?
  createdAt                DateTime                             @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                             @updatedAt @db.Timestamptz(6)
  employee                 Employee                             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment     EmploymentAssignment?                @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  timeEntry                TimeEntry?                           @relation(fields: [timeEntryId, employeeId, employmentAssignmentId], references: [id, employeeId, employmentAssignmentId], onDelete: Restrict)
  attendanceSignIn         AttendanceSignIn?                    @relation(fields: [attendanceSignInId, employeeId, employmentAssignmentId], references: [id, employeeId, employmentAssignmentId], onDelete: Restrict)
  /// Batch 4C — a manager's review (RESOLVED or DISMISSED): who, and their note (both or neither).
  resolvedByUserId         String?                              @db.Uuid
  resolutionNote           String?
  /// Batch 4C — NO_SHOW only: the shift, and the revision it was detected on.
  scheduledShiftId         String?                              @db.Uuid
  scheduledShiftRevisionId String?                              @db.Uuid
  resolvedBy               User?                                @relation("AttendanceExceptionReviewer", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  scheduledShift           ScheduledShift?                      @relation("ScheduledShiftNoShows", fields: [scheduledShiftId, employmentAssignmentId], references: [id, employmentAssignmentId], onDelete: Restrict)
  scheduledShiftRevision   ScheduledShiftRevision?              @relation("ScheduledShiftRevisionNoShows", fields: [scheduledShiftRevisionId, scheduledShiftId], references: [id, scheduledShiftId], onDelete: Restrict)

  @@index([employeeId, status, detectedAt])
  @@index([attendanceSignInId, type, status])
  @@index([timeEntryId, type, status])
  @@index([employmentAssignmentId, detectedAt])
  @@index([scheduledShiftId])
}

model TimeCorrectionRequest {
  id                           String                @id @default(uuid()) @db.Uuid
  employeeId                   String                @db.Uuid
  requestorUserId              String                @db.Uuid
  reviewerUserId               String?               @db.Uuid
  timeEntryId                  String?               @db.Uuid
  breakEntryId                 String?               @db.Uuid
  employmentAssignmentId       String?               @db.Uuid
  targetEmploymentAssignmentId String?               @db.Uuid
  type                         TimeCorrectionType
  status                       TimeCorrectionStatus  @default(PENDING)
  reason                       String
  reviewerNote                 String?
  requestedValues              Json
  currentValues                Json?
  requestedAt                  DateTime              @default(now()) @db.Timestamptz(6)
  reviewedAt                   DateTime?             @db.Timestamptz(6)
  cancelledAt                  DateTime?             @db.Timestamptz(6)
  createdAt                    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime              @updatedAt @db.Timestamptz(6)
  employee                     Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestor                    User                  @relation("TimeCorrectionRequestor", fields: [requestorUserId], references: [id], onDelete: Restrict)
  reviewer                     User?                 @relation("TimeCorrectionReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  timeEntry                    TimeEntry?            @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
  breakEntry                   BreakEntry?           @relation(fields: [breakEntryId], references: [id], onDelete: Restrict)
  employmentAssignment         EmploymentAssignment? @relation("TimeCorrectionAffectedAssignment", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  targetEmploymentAssignment   EmploymentAssignment? @relation("TimeCorrectionTargetAssignment", fields: [targetEmploymentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  adjustment                   TimeAdjustment?

  @@index([employeeId, status, requestedAt])
  @@index([timeEntryId, status])
  /// Batch 8: notification producer cursor.
  @@index([reviewedAt, id])
  @@index([breakEntryId, status])
  @@index([employmentAssignmentId, status])
}

model TimeAdjustment {
  id                     String                 @id @default(uuid()) @db.Uuid
  correctionRequestId    String?                @unique @db.Uuid
  employeeId             String                 @db.Uuid
  actorUserId            String                 @db.Uuid
  timeEntryId            String?                @db.Uuid
  breakEntryId           String?                @db.Uuid
  employmentAssignmentId String?                @db.Uuid
  type                   TimeCorrectionType
  source                 TimeAdjustmentSource
  reason                 String
  previousValues         Json
