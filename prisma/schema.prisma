}

model TimesheetSegment {
  id                     String                 @id @default(uuid()) @db.Uuid
  timesheetId            String                 @db.Uuid
  employmentAssignmentId String                 @db.Uuid
  status                 TimesheetSegmentStatus @default(PENDING)
  reviewedByUserId       String?                @db.Uuid
  reviewedAt             DateTime?              @db.Timestamptz(6)
  reviewerNote           String?
  grossMinutes           Int                    @default(0)
  paidBreakMinutes       Int                    @default(0)
  unpaidBreakMinutes     Int                    @default(0)
  policyDeductionMinutes Int                    @default(0)
  netWorkedMinutes       Int                    @default(0)
  approvedWorkedMinutes  Int                    @default(0)
  calculatedAt           DateTime?              @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)
  timesheet              Timesheet              @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment   @relation(fields: [employmentAssignmentId], references: [id], onDelete: Restrict)
  reviewedBy             User?                  @relation("TimesheetSegmentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([timesheetId, employmentAssignmentId])
  @@index([employmentAssignmentId, status])
}

model TimesheetEvent {
  id          String             @id @default(uuid()) @db.Uuid
  timesheetId String             @db.Uuid
  segmentId   String?            @db.Uuid
  actorUserId String?            @db.Uuid
  type        TimesheetEventType
  note        String?
  metadata    Json?
  occurredAt  DateTime           @default(now()) @db.Timestamptz(6)
  timesheet   Timesheet          @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  actor       User?              @relation("TimesheetEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([timesheetId, occurredAt])
  @@index([segmentId, occurredAt])
  /// Batch 8: notification producer cursor.
  @@index([occurredAt, id])
}

model TimeAttendancePolicy {
  id                     String                              @id @default(uuid()) @db.Uuid
  scopeType              TimeAttendancePolicyScopeType
  organizationId         String?                             @db.Uuid
  organizationalUnitId   String?                             @db.Uuid
  departmentId           String?                             @db.Uuid
  teamId                 String?                             @db.Uuid
  employmentAssignmentId String?                             @db.Uuid
  inheritanceMode        TimeAttendancePolicyInheritanceMode @default(INHERIT)
  effectiveFrom          DateTime                            @db.Date
  effectiveTo            DateTime?                           @db.Date
  config                 Json                                @default("{}")
  createdAt              DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                            @updatedAt @db.Timestamptz(6)
  archivedAt             DateTime?                           @db.Timestamptz(6)
  organization           Organization?                       @relation("TimePolicyOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit     OrganizationalUnit?                 @relation("TimePolicyUnit", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department             Department?                         @relation("TimePolicyDepartment", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                   Team?                               @relation("TimePolicyTeam", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment?               @relation(fields: [employmentAssignmentId], references: [id], onDelete: Restrict)

  @@index([scopeType, effectiveFrom, effectiveTo])
  @@index([organizationId, effectiveFrom])
  @@index([organizationalUnitId, effectiveFrom])
  @@index([departmentId, effectiveFrom])
  @@index([teamId, effectiveFrom])
  @@index([employmentAssignmentId, effectiveFrom])
}

// ─── Phase 7: Scheduling ─────────────────────────────────────────────────────

model Schedule {
  id                   String              @id @default(uuid()) @db.Uuid
  scopeType            ScheduleScopeType
  organizationId       String              @db.Uuid
  organizationalUnitId String?             @db.Uuid
  departmentId         String?             @db.Uuid
  teamId               String?             @db.Uuid
  name                 String
  periodStart          DateTime            @db.Date
  periodEnd            DateTime            @db.Date
  type                 ScheduleType
  status               ScheduleStatus      @default(DRAFT)
  publishedAt          DateTime?           @db.Timestamptz(6)
  publishedByUserId    String?             @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  organization         Organization        @relation("OrganizationSchedules", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit   OrganizationalUnit? @relation("UnitSchedules", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department           Department?         @relation("DepartmentSchedules", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                 Team?               @relation("TeamSchedules", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  publishedBy          User?               @relation("SchedulePublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  shifts               ScheduledShift[]

  @@index([organizationId, status, periodStart, periodEnd])
  @@index([organizationId, scopeType, status])
  @@index([organizationId, organizationalUnitId, status])
  @@index([organizationId, departmentId, status])
  @@index([organizationId, teamId, status])
  /// Batch 8: notification producer cursor.
  @@index([publishedAt, id])
}

model ScheduledShift {
  id                      String                       @id @default(uuid()) @db.Uuid
  scheduleId              String                       @db.Uuid
  employmentAssignmentId  String                       @db.Uuid
  workLocationId          String?                      @db.Uuid
  workDate                DateTime                     @db.Date
  startsAt                DateTime                     @db.Timestamptz(6)
  endsAt                  DateTime                     @db.Timestamptz(6)
  timezone                String
  status                  ScheduledShiftStatus         @default(ACTIVE)
  sourceType              ScheduledShiftSourceType     @default(MANUAL)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(6)
  schedule                Schedule                     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  employmentAssignment    EmploymentAssignment         @relation("AssignmentScheduledShifts", fields: [employmentAssignmentId], references: [id], onDelete: Restrict)
  workLocation            WorkLocation?                @relation("WorkLocationScheduledShifts", fields: [workLocationId], references: [id], onDelete: Restrict)
  conflictOverrides       ScheduleConflictOverride[]   @relation("ConflictOverrideShift")
  conflictOverrideTargets ScheduleConflictOverride[]   @relation("ConflictOverrideConflictingShift")
  revisions               ScheduledShiftRevision[]     @relation("ScheduledShiftRevisions")
  timeEntries             TimeEntry[]                  @relation("TimeEntryScheduledShift")
  attendanceSignIns       AttendanceSignIn[]           @relation("AttendanceSignInScheduledShift")
  noShowExceptions        AttendanceException[]        @relation("ScheduledShiftNoShows")
  /// Generation provenance (sourceType PATTERN only): the pattern and rule that produced this
  /// occurrence, its stable identity, and when the generator last wrote it. Kept on publication.
  sourcePatternId         String?                      @db.Uuid
  sourcePatternRuleId     String?                      @db.Uuid
  sourceOccurrenceKey     String?                      @unique
  generatedAt             DateTime?                    @db.Timestamptz(6)
  sourcePattern           EmployeeSchedulePattern?     @relation("PatternGeneratedShifts", fields: [sourcePatternId], references: [id], onDelete: Restrict)
  sourcePatternRule       EmployeeSchedulePatternRule? @relation("PatternRuleGeneratedShifts", fields: [sourcePatternRuleId], references: [id], onDelete: Restrict)

  @@unique([id, employmentAssignmentId])
  @@index([scheduleId, workDate])
  @@index([scheduleId, employmentAssignmentId, workDate])
  @@index([employmentAssignmentId, workDate])
  @@index([employmentAssignmentId, startsAt, endsAt])
  @@index([workLocationId])
  @@index([workDate, status])
  @@index([sourcePatternId, workDate])
  @@index([sourcePatternRuleId])
}

/// An accepted override of a computed WARNING conflict. Conflicts themselves are computed, not
/// stored; a row is valid only while the recomputed conflict still produces the same conflictKey.
model ScheduleConflictOverride {
  id                 String               @id @default(uuid()) @db.Uuid
  scheduledShiftId   String               @db.Uuid
  conflictingShiftId String?              @db.Uuid
  conflictType       ScheduleConflictType
  conflictKey        String
  reason             String
  metadata           Json
  overriddenByUserId String               @db.Uuid
  overriddenAt       DateTime             @default(now()) @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  scheduledShift     ScheduledShift       @relation("ConflictOverrideShift", fields: [scheduledShiftId], references: [id], onDelete: Restrict)
  conflictingShift   ScheduledShift?      @relation("ConflictOverrideConflictingShift", fields: [conflictingShiftId], references: [id], onDelete: SetNull)
  overriddenBy       User                 @relation("ScheduleConflictOverrider", fields: [overriddenByUserId], references: [id], onDelete: Restrict)

  @@unique([scheduledShiftId, conflictKey])
  @@index([conflictingShiftId, conflictKey])
  @@index([overriddenByUserId, overriddenAt])
}

/// Immutable published expected-work history. Each row is a full snapshot of a ScheduledShift
/// after one published change, so "what was expected after revision N" is answered directly
/// without replaying AuditLog deltas. ScheduledShift remains the current operational state.
/// Rows are append-only: the application never updates or deletes them.
model ScheduledShiftRevision {
  id                     String                     @id @default(uuid()) @db.Uuid
  scheduledShiftId       String                     @db.Uuid
  revisionNumber         Int
  revisionType           ScheduledShiftRevisionType
  employmentAssignmentId String                     @db.Uuid
  workLocationId         String?                    @db.Uuid
  workDate               DateTime                   @db.Date
  startsAt               DateTime                   @db.Timestamptz(6)
  endsAt                 DateTime                   @db.Timestamptz(6)
  timezone               String
  status                 ScheduledShiftStatus
  sourceType             ScheduledShiftSourceType
  reason                 String?
  changedByUserId        String                     @db.Uuid
  changedAt              DateTime                   @default(now()) @db.Timestamptz(6)
  scheduledShift         ScheduledShift             @relation("ScheduledShiftRevisions", fields: [scheduledShiftId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment       @relation("AssignmentScheduledShiftRevisions", fields: [employmentAssignmentId], references: [id], onDelete: Restrict)
  workLocation           WorkLocation?              @relation("WorkLocationScheduledShiftRevisions", fields: [workLocationId], references: [id], onDelete: Restrict)
  changedBy              User                       @relation("ScheduledShiftRevisionAuthor", fields: [changedByUserId], references: [id], onDelete: Restrict)
  timeEntries            TimeEntry[]                @relation("TimeEntryScheduledShiftRevision")
  attendanceSignIns      AttendanceSignIn[]         @relation("AttendanceSignInScheduledShiftRevision")

  noShowExceptions AttendanceException[] @relation("ScheduledShiftRevisionNoShows")

  @@unique([scheduledShiftId, revisionNumber])
  @@unique([id, scheduledShiftId])
  @@index([employmentAssignmentId, workDate])
  @@index([workLocationId])
  @@index([changedByUserId, changedAt])
  /// Batch 8: notification producer cursor.
  @@index([changedAt, id])
}

/// A reusable, organization-level N-week recurrence preset. Applying it copies its rules into an
/// EmployeeSchedulePattern; templates never drive patterns or shifts live.
model ScheduleTemplate {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  name           String
  description    String?
  rotationWeeks  Int
  archivedAt     DateTime?                 @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(6)
  organization   Organization              @relation("OrganizationScheduleTemplates", fields: [organizationId], references: [id], onDelete: Restrict)
  rules          ScheduleTemplateRule[]    @relation("ScheduleTemplateRules")
  patterns       EmployeeSchedulePattern[] @relation("SchedulePatternSourceTemplate")

  @@index([organizationId, archivedAt, name])
}

/// One recurring local wall-clock interval in a template rotation. weekIndex is 0-based;
/// endLocalTime <= startLocalTime ends on the following local day.
model ScheduleTemplateRule {
  id                 String            @id @default(uuid()) @db.Uuid
  scheduleTemplateId String            @db.Uuid
  weekIndex          Int
  dayOfWeek          ScheduleDayOfWeek
  startLocalTime     DateTime          @db.Time(0)
  endLocalTime       DateTime          @db.Time(0)
  workLocationId     String?           @db.Uuid
  /// Fallback IANA timezone, used only when the WorkLocation has none.
  timezone           String?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  scheduleTemplate   ScheduleTemplate  @relation("ScheduleTemplateRules", fields: [scheduleTemplateId], references: [id], onDelete: Restrict)
  workLocation       WorkLocation?     @relation("WorkLocationScheduleTemplateRules", fields: [workLocationId], references: [id], onDelete: Restrict)

  @@index([scheduleTemplateId, weekIndex, dayOfWeek])
  @@index([workLocationId])
}

/// An effective-dated recurring work pattern for exactly one EmploymentAssignment. Periods of
/// one assignment never overlap. Rows are history: started patterns are only ever ended.
/// weekIndex 0 is the Monday-to-Sunday week starting on anchorDate (a Monday).
model EmployeeSchedulePattern {
  id                     String                        @id @default(uuid()) @db.Uuid
  employmentAssignmentId String                        @db.Uuid
  name                   String?
  effectiveFrom          DateTime                      @db.Date
  effectiveTo            DateTime?                     @db.Date
  rotationWeeks          Int
  anchorDate             DateTime                      @db.Date
  /// Provenance only: the template the rules were copied from. Never inherited live.
  sourceTemplateId       String?                       @db.Uuid
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(6)
  employmentAssignment   EmploymentAssignment          @relation("AssignmentSchedulePatterns", fields: [employmentAssignmentId], references: [id], onDelete: Restrict)
  sourceTemplate         ScheduleTemplate?             @relation("SchedulePatternSourceTemplate", fields: [sourceTemplateId], references: [id], onDelete: Restrict)
  rules                  EmployeeSchedulePatternRule[] @relation("EmployeeSchedulePatternRules")
  generatedShifts        ScheduledShift[]              @relation("PatternGeneratedShifts")

  @@index([employmentAssignmentId, effectiveFrom, effectiveTo])
  @@index([sourceTemplateId])
}

/// One recurring local wall-clock interval of a pattern; Batch 6 expands these into shifts.
model EmployeeSchedulePatternRule {
  id                        String                  @id @default(uuid()) @db.Uuid
  employeeSchedulePatternId String                  @db.Uuid
  weekIndex                 Int
  dayOfWeek                 ScheduleDayOfWeek
  startLocalTime            DateTime                @db.Time(0)
  endLocalTime              DateTime                @db.Time(0)
  workLocationId            String?                 @db.Uuid
  /// Fallback IANA timezone, used only when the WorkLocation has none.
  timezone                  String?
  sortOrder                 Int                     @default(0)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  employeeSchedulePattern   EmployeeSchedulePattern @relation("EmployeeSchedulePatternRules", fields: [employeeSchedulePatternId], references: [id], onDelete: Restrict)
  generatedShifts           ScheduledShift[]        @relation("PatternRuleGeneratedShifts")
  workLocation              WorkLocation?           @relation("WorkLocationSchedulePatternRules", fields: [workLocationId], references: [id], onDelete: Restrict)

  @@index([employeeSchedulePatternId, weekIndex, dayOfWeek])
  @@index([workLocationId])
}

/// Effective-dated scheduling policy for an organizational scope. Every setting is optional:
/// for each field, the most specific effective policy that sets it wins (team, department,
/// organizational units leaf to root, organization), then the built-in default. WorkLocation is
/// never a policy parent. Periods of one exact scope never overlap; rows are history.
model SchedulePolicy {
  id                           String                          @id @default(uuid()) @db.Uuid
  scopeType                    ScheduleScopeType
  organizationId               String                          @db.Uuid
  organizationalUnitId         String?                         @db.Uuid
  departmentId                 String?                         @db.Uuid
  teamId                       String?                         @db.Uuid
  name                         String?
  effectiveFrom                DateTime                        @db.Date
  effectiveTo                  DateTime?                       @db.Date
  generationHorizonDays        Int?
  defaultSchedulePeriod        SchedulePeriodType?
  autoCreateSchedules          Boolean?
  unscheduledWorkMode          UnscheduledWorkMode?
  clockInEarlyMinutes          Int?
  clockInLateMinutes           Int?
  overlapConflictSeverity      SchedulePolicyConflictSeverity?
  minimumRestMinutes           Int?
  maximumShiftDurationMinutes  Int?
  requireWorkLocation          Boolean?
  allowManagerConflictOverride Boolean?
  createdAt                    DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                        @updatedAt @db.Timestamptz(6)
  organization                 Organization                    @relation("SchedulePolicyOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit           OrganizationalUnit?             @relation("SchedulePolicyUnit", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department                   Department?                     @relation("SchedulePolicyDepartment", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                         Team?                           @relation("SchedulePolicyTeam", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, scopeType, effectiveFrom])
  @@index([organizationalUnitId, effectiveFrom])
  @@index([departmentId, effectiveFrom])
  @@index([teamId, effectiveFrom])
}

// ─── Phase 8: Organization calendar ──────────────────────────────────────────

enum HolidayKind {
  STATUTORY_HOLIDAY
  CLOSURE
}

/// A non-working local date for an organization, optionally limited to one unit (and its
/// descendants), department or team. Leave sizing excludes these days when its policy says so;
/// holidays never change published schedules or approved leave retroactively.
model OrganizationHoliday {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @db.Uuid
  organizationalUnitId String?             @db.Uuid
  departmentId         String?             @db.Uuid
  teamId               String?             @db.Uuid
  date                 DateTime            @db.Date
  name                 String
  kind                 HolidayKind
  archivedAt           DateTime?           @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  organization         Organization        @relation("OrganizationHolidays", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit   OrganizationalUnit? @relation("HolidayUnit", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department           Department?         @relation("HolidayDepartment", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                 Team?               @relation("HolidayTeam", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, date])
}

// ─── Phase 8: Leave & Absence ────────────────────────────────────────────────

enum LeaveClassification {
  PAID
  UNPAID
}

enum LeaveDisplayUnit {
  HOURS
  DAYS
}

enum LeavePolicyScopeType {
  ORGANIZATION
  ORGANIZATIONAL_UNIT
  DEPARTMENT
  TEAM
  EMPLOYMENT_ASSIGNMENT
}

enum LeaveAmountSource {
  SCHEDULE_THEN_STANDARD
  STANDARD_ONLY
}

enum LeaveAccrualMethod {
  NONE
  ANNUAL_GRANT
  PERIODIC
}

enum LeaveAccrualFrequency {
  MONTHLY
  SEMI_MONTHLY
  BIWEEKLY
}

enum LeaveCarryoverMode {
  NONE
  CAPPED
  UNLIMITED
}

enum LeaveLedgerEntryType {
  GRANT
  ACCRUAL
  USAGE
  ADJUSTMENT
  CARRYOVER_FORFEIT
  EXPIRY
  REVERSAL
}

enum LeaveLedgerSourceType {
  POLICY
  LEAVE_REQUEST
  MANUAL
  YEAR_END
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDayAmountSource {
  SCHEDULE
  STANDARD_DAY
  HOLIDAY_EXCLUDED
  NON_WORKDAY
  MANUAL_OVERRIDE
}

enum LeaveRequestEventType {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  AMENDED
}

enum LeaveAmendmentType {
  CANCEL
  SHORTEN
}

/// An organization-level leave type. Legal concepts (paid/unpaid, balance-tracked or not) are
/// configuration; no statutory entitlement is hard-coded.
model LeaveType {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  code           String
  name           String
  description    String?
  classification LeaveClassification
  tracksBalance  Boolean             @default(true)
  displayUnit    LeaveDisplayUnit    @default(DAYS)
  archivedAt     DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  organization   Organization        @relation("OrganizationLeaveTypes", fields: [organizationId], references: [id], onDelete: Restrict)
  policies       LeavePolicy[]
  accounts       LeaveAccount[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

/// Effective-dated entitlement rules of one leave type for one scope, optionally limited to
/// employment types. Resolution is whole-record: the most specific effective policy wins.
model LeavePolicy {
  id                              String                 @id @default(uuid()) @db.Uuid
  leaveTypeId                     String                 @db.Uuid
  organizationId                  String                 @db.Uuid
  scopeType                       LeavePolicyScopeType
  organizationalUnitId            String?                @db.Uuid
  departmentId                    String?                @db.Uuid
  teamId                          String?                @db.Uuid
  employmentAssignmentId          String?                @db.Uuid
  employmentTypes                 EmploymentType[]       @default([])
  name                            String?
  effectiveFrom                   DateTime               @db.Date
  effectiveTo                     DateTime?              @db.Date
  eligible                        Boolean                @default(true)
  waitingPeriodDays               Int                    @default(0)
  leaveYearStartMonth             Int                    @default(1)
  leaveYearStartDay               Int                    @default(1)
  amountSource                    LeaveAmountSource      @default(SCHEDULE_THEN_STANDARD)
  standardWorkdayMinutes          Int                    @default(480)
  standardWorkdays                ScheduleDayOfWeek[]    @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  excludeHolidays                 Boolean                @default(true)
  allowPartialDay                 Boolean                @default(true)
  accrualMethod                   LeaveAccrualMethod     @default(NONE)
  annualGrantMinutes              Int?
  accrualFrequency                LeaveAccrualFrequency?
  accrualMinutesPerPeriod         Int?
  accrualAnchorDate               DateTime?              @db.Date
  prorateFirstYear                Boolean                @default(false)
  maxBalanceMinutes               Int?
  negativeBalanceLimitMinutes     Int                    @default(0)
  carryoverMode                   LeaveCarryoverMode     @default(UNLIMITED)
  carryoverMaxMinutes             Int?
  carryoverExpiryDays             Int?
  employeeMayCancelApprovedFuture Boolean                @default(true)
  createdAt                       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime               @updatedAt @db.Timestamptz(6)
  leaveType                       LeaveType              @relation(fields: [leaveTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization                    Organization           @relation("LeavePolicyOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit              OrganizationalUnit?    @relation("LeavePolicyUnit", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department                      Department?            @relation("LeavePolicyDepartment", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                            Team?                  @relation("LeavePolicyTeam", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employmentAssignment            EmploymentAssignment?  @relation("LeavePolicyAssignment", fields: [employmentAssignmentId], references: [id], onDelete: Restrict)

  @@index([leaveTypeId, scopeType, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@index([employmentAssignmentId])
}

/// The balance anchor of one leave type for one EmploymentAssignment. It stores no balance:
/// balances are always derived from its append-only ledger. Its row is the balance lock.
model LeaveAccount {
  id                     String               @id @default(uuid()) @db.Uuid
  employeeId             String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  leaveTypeId            String               @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  employee               Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  leaveType              LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  entries                LeaveLedgerEntry[]
  requests               LeaveRequest[]

  @@unique([employmentAssignmentId, leaveTypeId])
  @@unique([id, employmentAssignmentId, leaveTypeId])
  @@index([employeeId])
  @@index([leaveTypeId])
}

/// Append-only balance history (UPDATE and DELETE are rejected by triggers). Corrections are
/// REVERSAL entries referencing the original; every job-posted entry carries a deterministic
/// idempotency key so retries never post twice.
model LeaveLedgerEntry {
  id                     String                @id @default(uuid()) @db.Uuid
  accountId              String                @db.Uuid
  employeeId             String                @db.Uuid
  employmentAssignmentId String                @db.Uuid
  leaveTypeId            String                @db.Uuid
  entryType              LeaveLedgerEntryType
  amountMinutes          Int
  effectiveDate          DateTime              @db.Date
  sourceType             LeaveLedgerSourceType
  policyId               String?               @db.Uuid
  leaveRequestId         String?               @db.Uuid
  leaveRequestDayId      String?               @db.Uuid
  reversesEntryId        String?               @unique @db.Uuid
  idempotencyKey         String                @unique
  reason                 String?
  createdByUserId        String?               @db.Uuid
  postedAt               DateTime              @default(now()) @db.Timestamptz(6)
  account                LeaveAccount          @relation(fields: [accountId, employmentAssignmentId, leaveTypeId], references: [id, employmentAssignmentId, leaveTypeId], onDelete: Restrict)
  reverses               LeaveLedgerEntry?     @relation("LeaveLedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy             LeaveLedgerEntry?     @relation("LeaveLedgerReversal")
  leaveRequest           LeaveRequest?         @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  leaveRequestDay        LeaveRequestDay?      @relation(fields: [leaveRequestDayId], references: [id], onDelete: Restrict)
  createdBy              User?                 @relation("LeaveLedgerAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([accountId, effectiveDate])
  @@index([employeeId, effectiveDate])
  @@index([leaveRequestId])
}

/// A leave request for one EmploymentAssignment and leave type over a local date range. Sizing
/// (its days) is server-computed and freezes at approval; approved leave is changed only by
/// amendments that reverse ledger usage, never by rewriting it.
model LeaveRequest {
  id                     String                  @id @default(uuid()) @db.Uuid
  employeeId             String                  @db.Uuid
  employmentAssignmentId String                  @db.Uuid
  leaveTypeId            String                  @db.Uuid
  accountId              String                  @db.Uuid
  status                 LeaveRequestStatus      @default(PENDING)
  startDate              DateTime                @db.Date
  endDate                DateTime                @db.Date
  startLocalTime         String?
  endLocalTime           String?
  timezone               String
  reason                 String?
  requestedMinutes       Int
  approvedMinutes        Int?
  requestedByUserId      String                  @db.Uuid
  submittedAt            DateTime                @default(now()) @db.Timestamptz(6)
  decidedByUserId        String?                 @db.Uuid
  decidedAt              DateTime?               @db.Timestamptz(6)
  decisionNote           String?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  employee               Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment    @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  account                LeaveAccount            @relation(fields: [accountId, employmentAssignmentId, leaveTypeId], references: [id, employmentAssignmentId, leaveTypeId], onDelete: Restrict)
  requestedBy            User                    @relation("LeaveRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy              User?                   @relation("LeaveRequestDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  days                   LeaveRequestDay[]
  events                 LeaveRequestEvent[]
  amendments             LeaveRequestAmendment[]
  ledgerEntries          LeaveLedgerEntry[]

  @@index([employmentAssignmentId, startDate, endDate])
  @@index([employeeId, status, startDate])
  @@index([status, startDate])
}

/// One local date of a request: its server-computed minutes and how they were derived, the
/// requested window, and the absence interval Time & Attendance consumes. Frozen at approval;
/// afterwards only cancellation by an amendment is recorded (set once).
model LeaveRequestDay {
  id                        String                 @id @default(uuid()) @db.Uuid
  requestId                 String                 @db.Uuid
  date                      DateTime               @db.Date
  minutes                   Int
  amountSource              LeaveDayAmountSource
  windowStart               DateTime               @db.Timestamptz(6)
  windowEnd                 DateTime               @db.Timestamptz(6)
  absenceStart              DateTime               @db.Timestamptz(6)
  absenceEnd                DateTime               @db.Timestamptz(6)
  scheduledShiftRevisionIds String[]               @default([]) @db.Uuid
  holidayName               String?
  overrideReason            String?
  cancelledByAmendmentId    String?                @db.Uuid
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  request                   LeaveRequest           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  cancelledByAmendment      LeaveRequestAmendment? @relation(fields: [cancelledByAmendmentId], references: [id], onDelete: Restrict)
  ledgerEntries             LeaveLedgerEntry[]

  @@unique([requestId, date])
  @@index([date])
}

model LeaveRequestEvent {
  id          String                @id @default(uuid()) @db.Uuid
  requestId   String                @db.Uuid
  type        LeaveRequestEventType
  actorUserId String?               @db.Uuid
  note        String?
  metadata    Json?
  occurredAt  DateTime              @default(now()) @db.Timestamptz(6)
  request     LeaveRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor       User?                 @relation("LeaveRequestEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
  /// Batch 8: notification producer cursor.
  @@index([occurredAt, id])
}

/// Cancellation or shortening of APPROVED leave: the days it cancelled and the reversals it posted.
model LeaveRequestAmendment {
  id               String             @id @default(uuid()) @db.Uuid
  requestId        String             @db.Uuid
  type             LeaveAmendmentType
  reason           String
  cancelledMinutes Int
  actorUserId      String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  request          LeaveRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor            User               @relation("LeaveAmendmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  cancelledDays    LeaveRequestDay[]

  @@index([requestId, createdAt])
}

/// Phase 9 — how a compensation rate is expressed. HOURLY: rateAmount is the amount per hour.
/// SALARY: rateAmount is interpreted by salaryArrangement.
enum CompensationPayBasis {
  HOURLY
  SALARY
}

enum CompensationSalaryArrangement {
  ANNUAL
  FIXED_PERIOD
  CONTRACT_TOTAL
}

/// Why a CompensationRecord exists: the first period of a timeline (or one filling a gap), a
/// real-world change effective from a date, or a correction replacing a mis-entered record.
enum CompensationRecordType {
  INITIAL
  CHANGE
  CORRECTION
}

/// Minimal payroll grouping (prepares Phase 10 Payroll). Deliberately holds no pay frequency,
/// calendar, tax, deduction, bank or pay-run settings.
model PayGroup {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  code                String
  name                String
  description         String?
  archivedAt          DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  organization        Organization         @relation("OrganizationPayGroups", fields: [organizationId], references: [id], onDelete: Restrict)
  compensationRecords CompensationRecord[]
  payrollCalendars    PayrollCalendar[]
  payrollPeriods      PayrollPeriod[]
  payrollRuns         PayrollRun[]
  payrollAdjustments  PayrollAdjustment[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
}

/// Phase 9 — one effective-dated compensation period of an EmploymentAssignment (inclusive
/// date-only range; effectiveTo null = until changed or the assignment ends). The timeline is
/// the set of records not superseded; it never overlaps and stays inside the assignment.
/// Records are never deleted or rewritten: a change closes the previous period (only ever
/// shortening its effectiveTo) and adds a new one; a correction marks the record superseded
/// and adds a replacement that references it (database-enforced).
model CompensationRecord {
  id                     String                                @id @default(uuid()) @db.Uuid
  employmentAssignmentId String                                @db.Uuid
  /// The assignment position's organization (pay groups must belong to it).
  organizationId         String                                @db.Uuid
  recordType             CompensationRecordType
  payBasis               CompensationPayBasis
  rateAmount             Decimal                               @db.Decimal(19, 4)
  /// SALARY only. Existing salary rows are ANNUAL; hourly rows keep this null.
  salaryArrangement      CompensationSalaryArrangement?
  salaryMonthlyAmount    Decimal?                              @db.Decimal(19, 4)
  salaryPaidMonths       Int?
  salaryContractAmount   Decimal?                              @db.Decimal(19, 4)
  salaryPeriodStart      DateTime?                             @db.Date
  salaryPeriodEnd        DateTime?                             @db.Date
  /// ISO-4217 code. Never inferred from the organization; never converted.
  currency               String                                @db.Char(3)
  effectiveFrom          DateTime                              @db.Date
  effectiveTo            DateTime?                             @db.Date
  payGroupId             String?                               @db.Uuid
  /// For a CORRECTION: the record it replaces.
  supersedesRecordId     String?                               @unique @db.Uuid
  /// Required for corrections; optional note for changes.
  reason                 String?
  /// Set (once) when a correction replaces this record; it then leaves the timeline.
  supersededAt           DateTime?                             @db.Timestamptz(6)
  createdByUserId        String?                               @db.Uuid
  createdAt              DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                              @updatedAt @db.Timestamptz(6)
  employmentAssignment   EmploymentAssignment                  @relation(fields: [employmentAssignmentId], references: [id], onDelete: Restrict)
  organization           Organization                          @relation("CompensationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  payGroup               PayGroup?                             @relation(fields: [payGroupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersedes             CompensationRecord?                   @relation("CompensationCorrection", fields: [supersedesRecordId], references: [id], onDelete: Restrict)
  supersededBy           CompensationRecord?                   @relation("CompensationCorrection")
  createdBy              User?                                 @relation("CompensationAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recruitmentHires       RecruitmentHire[]                     @relation("RecruitmentHireCompensation")
  closures               CompensationRecordClosure[]
  adjustmentSources      PayrollAdjustmentCompensationSource[]

  @@index([employmentAssignmentId, effectiveFrom])
  @@index([organizationId, payGroupId])
}

/// Security remediation M2 — append-only: who shortened a compensation record's end date, and
/// when. The record itself keeps only its latest end date; a database trigger refuses any change
/// of `effectiveTo` without a closure row written in the same transaction. Legacy closures are
/// backfilled from the audit trail (source LEGACY_AUDIT; closedByUserId null when that entry had
/// no actor).
model CompensationRecordClosure {
  id                     String             @id @default(uuid()) @db.Uuid
  compensationRecordId   String             @db.Uuid
  /// Copied from the record by the database (for lookups by assignment / organization).
  employmentAssignmentId String             @db.Uuid
  organizationId         String             @db.Uuid
  previousEffectiveTo    DateTime?          @db.Date
  newEffectiveTo         DateTime           @db.Date
  closedByUserId         String?            @db.Uuid
  /// APPLICATION (written with the change) or LEGACY_AUDIT (backfilled).
  source                 String
  /// The audit entry a legacy closure was taken from (no foreign key: audit retention).
  auditLogId             String?            @unique @db.Uuid
  transactionId          BigInt             @default(dbgenerated("txid_current()"))
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  compensationRecord     CompensationRecord @relation(fields: [compensationRecordId], references: [id], onDelete: Restrict)
  closedBy               User?              @relation("CompensationClosureActor", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@index([compensationRecordId])
  @@index([employmentAssignmentId])
  @@index([closedByUserId])
}

// ─── Phase 9.5: Attendance kiosk and sign-in mode ────────────────────────────

enum AttendanceDeviceStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// How an employee identifies at a kiosk. PIN now; QR_BADGE / NFC_BADGE later (random,
/// opaque, revocable tokens looked up by lookupHash) without changing attendance itself.
enum AttendanceCredentialType {
  PIN
}

enum AttendanceCredentialStatus {
  ACTIVE
  REVOKED
}

enum AttendanceSignInStatus {
  ACTIVE
  VOIDED
}

/// A trusted onsite attendance device (kiosk) at a PhysicalSite. Its secret is issued once at
/// enrollment (a one-time code entered at the device) and stored only as a SHA-256 hash; a
/// REVOKED device is final and holds no secret. Only an ACTIVE device accepts attendance.
model AttendanceDevice {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  physicalSiteId      String                 @db.Uuid
  name                String
  status              AttendanceDeviceStatus @default(ACTIVE)
  credentialHash      String?                @unique
  credentialIssuedAt  DateTime?              @db.Timestamptz(6)
  enrollmentCodeHash  String?                @unique
  enrollmentExpiresAt DateTime?              @db.Timestamptz(6)
  lastSeenAt          DateTime?              @db.Timestamptz(6)
  lastSeenIp          String?
  lastSeenUserAgent   String?
  createdByUserId     String?                @db.Uuid
  revokedAt           DateTime?              @db.Timestamptz(6)
  revokedByUserId     String?                @db.Uuid
  revokedReason       String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(6)
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  physicalSite        PhysicalSite           @relation(fields: [physicalSiteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy           User?                  @relation("AttendanceDeviceRegistrar", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy           User?                  @relation("AttendanceDeviceRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  punches             TimePunch[]
  signIns             AttendanceSignIn[]
  signOuts            AttendanceSignOut[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([physicalSiteId])
}

/// An employee's kiosk credential. A PIN is stored only as an argon2id hash and never returned;
/// a reset revokes the credential and issues a new one (history kept). At most one ACTIVE
/// credential per employee and type (database-enforced).
model AttendanceCredential {
  id              String                     @id @default(uuid()) @db.Uuid
  employeeId      String                     @db.Uuid
  type            AttendanceCredentialType
  status          AttendanceCredentialStatus @default(ACTIVE)
  secretHash      String?
  /// Future badges: SHA-256 of the random badge token, looked up directly.
  lookupHash      String?                    @unique
  failedAttempts  Int                        @default(0)
  lockedUntil     DateTime?                  @db.Timestamptz(6)
  lastUsedAt      DateTime?                  @db.Timestamptz(6)
  issuedAt        DateTime                   @default(now()) @db.Timestamptz(6)
  issuedByUserId  String?                    @db.Uuid
  revokedAt       DateTime?                  @db.Timestamptz(6)
  revokedByUserId String?                    @db.Uuid
  revokedReason   String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  issuedBy        User?                      @relation("AttendanceCredentialIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?                      @relation("AttendanceCredentialRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, type, status])
}

/// A completed presence fact (SIGN_IN_ONLY tracking): the employee attended a work occurrence
/// at signedInAt. It has no end and no duration, never becomes worked minutes, and is never a
/// TimeEntry. Optionally linked to the published shift (and the immutable revision) it
/// attended. Never deleted or edited: a mistake is voided (with a reason) and, if needed,
/// replaced by a linked MANUAL record (database-enforced).
model AttendanceSignIn {
  id                       String                  @id @default(uuid()) @db.Uuid
  employeeId               String                  @db.Uuid
  employmentAssignmentId   String                  @db.Uuid
  signedInAt               DateTime                @db.Timestamptz(6)
  timezone                 String
  workDate                 DateTime                @db.Date
  source                   TimePunchSource
  attendanceDeviceId       String?                 @db.Uuid
  workLocationId           String?                 @db.Uuid
  scheduledShiftId         String?                 @db.Uuid
  scheduledShiftRevisionId String?                 @db.Uuid
  /// Client-supplied per-interaction key: a retried or double-submitted sign-in returns the
  /// original instead of recording another.
  idempotencyKey           String?
  status                   AttendanceSignInStatus  @default(ACTIVE)
  voidedAt                 DateTime?               @db.Timestamptz(6)
  voidedByUserId           String?                 @db.Uuid
  voidReason               String?
  /// A correction: the voided sign-in this record replaces.
  replacesSignInId         String?                 @unique @db.Uuid
  /// MANUAL records: who recorded it and why.
  recordedByUserId         String?                 @db.Uuid
  reason                   String?
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  employee                 Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment     EmploymentAssignment    @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  attendanceDevice         AttendanceDevice?       @relation(fields: [attendanceDeviceId], references: [id], onDelete: Restrict)
  workLocation             WorkLocation?           @relation(fields: [workLocationId], references: [id], onDelete: Restrict)
  scheduledShift           ScheduledShift?         @relation("AttendanceSignInScheduledShift", fields: [scheduledShiftId], references: [id], onDelete: Restrict)
  scheduledShiftRevision   ScheduledShiftRevision? @relation("AttendanceSignInScheduledShiftRevision", fields: [scheduledShiftRevisionId, scheduledShiftId], references: [id, scheduledShiftId], onDelete: Restrict)
  replaces                 AttendanceSignIn?       @relation("AttendanceSignInCorrection", fields: [replacesSignInId], references: [id], onDelete: Restrict)
  replacedBy               AttendanceSignIn?       @relation("AttendanceSignInCorrection")
  recordedBy               User?                   @relation("AttendanceSignInRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedBy                 User?                   @relation("AttendanceSignInVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  exceptions               AttendanceException[]
  signOuts                 AttendanceSignOut[]

  @@unique([id, employeeId, employmentAssignmentId])
  @@unique([employeeId, idempotencyKey])
  @@index([employmentAssignmentId, workDate])
  @@index([employeeId, signedInAt])
  @@index([scheduledShiftId])
  @@index([workDate])
}

/// Batch 4D — the optional end of a presence sign-in (policy attendance.signOutEnabled, off by
/// default). A presence fact only: never payable time, never a TimeEntry. Append-only like
/// sign-ins: at most one ACTIVE sign-out per sign-in; a correction voids it and records another.
model AttendanceSignOut {
  id                     String                 @id @default(uuid()) @db.Uuid
  signInId               String                 @db.Uuid
  employeeId             String                 @db.Uuid
  employmentAssignmentId String                 @db.Uuid
  signedOutAt            DateTime               @db.Timestamptz(6)
  source                 TimePunchSource
  attendanceDeviceId     String?                @db.Uuid
  /// Client-supplied per-interaction key: a retried sign-out returns the original.
  idempotencyKey         String?
  /// MANUAL records: who recorded it and why.
  recordedByUserId       String?                @db.Uuid
  reason                 String?
  status                 AttendanceSignInStatus @default(ACTIVE)
  voidedAt               DateTime?              @db.Timestamptz(6)
  voidedByUserId         String?                @db.Uuid
  voidReason             String?
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  signIn                 AttendanceSignIn       @relation(fields: [signInId, employeeId, employmentAssignmentId], references: [id, employeeId, employmentAssignmentId], onDelete: Restrict)
  attendanceDevice       AttendanceDevice?      @relation(fields: [attendanceDeviceId], references: [id], onDelete: Restrict)
  recordedBy             User?                  @relation("AttendanceSignOutRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedBy               User?                  @relation("AttendanceSignOutVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@unique([employeeId, idempotencyKey])
  @@index([signInId])
  @@index([employmentAssignmentId, signedOutAt])
}

// ─── Phase 10: Payroll ──────────────────────────────────────────────────────
//
// Payroll is its own domain. It owns calendars, periods and runs; it consumes facts from Core HR,
// Compensation, Time, Leave, Scheduling and attendance presence and never rewrites them. Batch 1
// holds structure only: no calculations, snapshots, lines, adjustments or statutory data.
// PayrollPeriod is not a TimePeriod: the two lifecycles stay separate (linked in a later batch).

/// How a payroll calendar divides time into pay periods (no CUSTOM: payroll periods are regular).
enum PayrollCalendarCadence {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PayrollPeriodStatus {
  UPCOMING
  OPEN
  PROCESSING
  FINALIZED
}

/// FINALIZED and VOIDED are terminal: a finalized run is never rewritten (later source changes
/// become adjustments), a voided run is kept as history.
enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  FINALIZED
  VOIDED
}

enum PayrollValidationSeverity {
  ERROR
  WARNING
  INFO
}

/// Effective-dated pay-period rules of one pay group. A changed rule is a new calendar from a
/// date; periods already generated keep their own dates and timezone.
model PayrollCalendar {
  id                         String                       @id @default(uuid()) @db.Uuid
  /// The pay group's organization (denormalized so the pay group is proven to belong to it).
  organizationId             String                       @db.Uuid
  payGroupId                 String                       @db.Uuid
  cadence                    PayrollCalendarCadence
  /// IANA timezone in which period dates, pay dates and cutoffs are read. Never defaulted.
  timezone                   String
  /// Start of the first period of the series (SEMIMONTHLY: day 1 or 16; MONTHLY: day 1–28).
  anchorDate                 DateTime                     @db.Date
  /// Pay date = period end + this many days (negative: paid before the period ends).
  payDateOffsetDays          Int
  /// Processing cutoff = this many days before the pay date.
  processingCutoffOffsetDays Int
  effectiveFrom              DateTime                     @db.Date
  effectiveTo                DateTime?                    @db.Date
  /// How unpaid leave reduces a salary. UNCONFIGURED blocks calculation when it occurs: no
  /// rule is ever invented. HOURLY_EQUIVALENT: unpaid minutes x annual salary / standard hours.
  salaryUnpaidLeaveRule      PayrollSalaryUnpaidLeaveRule @default(UNCONFIGURED)
  salaryStandardAnnualHours  Decimal?                     @db.Decimal(7, 2)
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                     @updatedAt @db.Timestamptz(6)
  organization               Organization                 @relation("PayrollCalendarOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  payGroup                   PayGroup                     @relation(fields: [payGroupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  periods                    PayrollPeriod[]

  @@unique([payGroupId, effectiveFrom])
  @@unique([id, payGroupId])
  @@index([organizationId, payGroupId])
}

/// One pay period of a pay group, materialized from a calendar. Its dates, pay date, cutoff and
/// timezone are stored so later calendar changes never reinterpret history.
model PayrollPeriod {
  id                       String              @id @default(uuid()) @db.Uuid
  organizationId           String              @db.Uuid
  payGroupId               String              @db.Uuid
  payrollCalendarId        String              @db.Uuid
  periodStart              DateTime            @db.Date
  periodEnd                DateTime            @db.Date
  payDate                  DateTime            @db.Date
  processingCutoffAt       DateTime            @db.Timestamptz(6)
  timezone                 String
  status                   PayrollPeriodStatus @default(UPCOMING)
  /// The Time-owned TimePeriod of exactly these dates (pay groups with the same dates share one).
  timePeriodId             String              @db.Uuid
  /// When the employees' timesheets were last materialized in Time (none: not yet).
  timesheetsMaterializedAt DateTime?           @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(6)
  organization             Organization        @relation("PayrollPeriodOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  payGroup                 PayGroup            @relation(fields: [payGroupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  calendar                 PayrollCalendar     @relation(fields: [payrollCalendarId, payGroupId], references: [id, payGroupId], onDelete: Restrict)
  timePeriod               TimePeriod          @relation(fields: [timePeriodId, organizationId, periodStart, periodEnd], references: [id, organizationId, startDate, endDate], onDelete: Restrict)
  runs                     PayrollRun[]

  @@unique([payGroupId, periodStart])
  @@unique([payGroupId, periodEnd])
  @@unique([id, organizationId, payGroupId])
  @@index([organizationId, status, periodStart])
  @@index([timePeriodId])
}

/// One payroll run of a period, in one currency (no conversion in V1). At most one run per
/// period and currency is not VOIDED (partial unique index in the migration).
model PayrollRun {
  id                         String                            @id @default(uuid()) @db.Uuid
  organizationId             String                            @db.Uuid
  payrollPeriodId            String                            @db.Uuid
  payGroupId                 String                            @db.Uuid
  /// ISO-4217 code, as in Compensation. Never converted.
  currency                   String                            @db.Char(3)
  status                     PayrollRunStatus                  @default(DRAFT)
  calculationVersion         String?
  sourceFingerprint          String?
  calculatedAt               DateTime?                         @db.Timestamptz(6)
  approvedAt                 DateTime?                         @db.Timestamptz(6)
  /// Security remediation M2: who last calculated the run (null on legacy runs).
  calculatedByUserId         String?                           @db.Uuid
  approvedByUserId           String?                           @db.Uuid
  finalizedAt                DateTime?                         @db.Timestamptz(6)
  finalizedByUserId          String?                           @db.Uuid
  voidedAt                   DateTime?                         @db.Timestamptz(6)
  voidedByUserId             String?                           @db.Uuid
  voidReason                 String?
  createdByUserId            String                            @db.Uuid
  /// Totals of the latest calculation (gross earnings, employee deductions, employer
  /// contributions); null until calculated.
  grossAmount                Decimal?                          @db.Decimal(19, 2)
  deductionAmount            Decimal?                          @db.Decimal(19, 2)
  employerContributionAmount Decimal?                          @db.Decimal(19, 2)
  /// Statutory (tax, CPP, EI) deductions are not calculated in Phase 10: gross pay is complete,
  /// legal net pay is not. Only a statutory engine may ever set CALCULATED.
  statutoryStatus            PayrollStatutoryStatus            @default(NOT_CALCULATED)
  /// The salary unpaid-leave rule the calculation used (snapshot of the calendar's).
  salaryUnpaidLeaveRule      PayrollSalaryUnpaidLeaveRule?
  salaryStandardAnnualHours  Decimal?                          @db.Decimal(7, 2)
  createdAt                  DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                          @updatedAt @db.Timestamptz(6)
  organization               Organization                      @relation("PayrollRunOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  payGroup                   PayGroup                          @relation(fields: [payGroupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  period                     PayrollPeriod                     @relation(fields: [payrollPeriodId, organizationId, payGroupId], references: [id, organizationId, payGroupId], onDelete: Restrict)
  createdBy                  User                              @relation("PayrollRunCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  calculatedBy               User?                             @relation("PayrollRunCalculator", fields: [calculatedByUserId], references: [id], onDelete: Restrict)
  adjustmentsCancelledFrom   PayrollAdjustment[]               @relation("PayrollAdjustmentCancelledFromRun")
  approvedBy                 User?                             @relation("PayrollRunApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  finalizedBy                User?                             @relation("PayrollRunFinalizer", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  voidedBy                   User?                             @relation("PayrollRunVoider", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  employees                  PayrollRunEmployee[]
  validationIssues           PayrollValidationIssue[]
  earningLines               PayrollEarningLine[]
  compensationSnapshots      PayrollCompensationSnapshot[]
  timeSnapshots              PayrollTimeSnapshot[]
  leaveSnapshots             PayrollLeaveSnapshot[]
  presenceSnapshots          PayrollPresenceSnapshot[]
  deductionLines             PayrollDeductionLine[]
  contributionLines          PayrollEmployerContributionLine[]
  correctedBy                PayrollAdjustment[]               @relation("PayrollAdjustmentSourceRun")
  adjustments                PayrollAdjustment[]               @relation("PayrollAdjustmentRun")
  sourceClaims               PayrollSourceClaim[]
  benefitSnapshots           PayrollBenefitSnapshot[]
  retroRequirements          PayrollRetroRequirement[]
  retroResolutions           PayrollRetroResolution[]

  @@index([organizationId, status])
  @@index([payrollPeriodId, status])
  /// Batch 8: notification producer cursor.
  @@index([finalizedAt, id])
}

/// An employee's grouping inside a run (their eventual payslip). Totals arrive with calculations.
model PayrollRunEmployee {
  id                         String                   @id @default(uuid()) @db.Uuid
  payrollRunId               String                   @db.Uuid
  employeeId                 String                   @db.Uuid
  /// Identity as calculated (snapshot): the payslip never depends on later HR edits.
  employeeNumber             String
  displayName                String
  grossAmount                Decimal                  @default(0) @db.Decimal(19, 2)
  deductionAmount            Decimal                  @default(0) @db.Decimal(19, 2)
  employerContributionAmount Decimal                  @default(0) @db.Decimal(19, 2)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(6)
  run                        PayrollRun               @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee                   Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignments                PayrollRunAssignment[]
  validationIssues           PayrollValidationIssue[]

  @@unique([payrollRunId, employeeId])
  @@unique([id, payrollRunId])
  @@unique([id, payrollRunId, employeeId])
}

/// One employment assignment of the employee in the run: payroll stays assignment-centric.
model PayrollRunAssignment {
  id                         String                            @id @default(uuid()) @db.Uuid
  payrollRunId               String                            @db.Uuid
  payrollRunEmployeeId       String                            @db.Uuid
  /// Denormalized so the assignment is proven to be the run employee's own.
  employeeId                 String                            @db.Uuid
  employmentAssignmentId     String                            @db.Uuid
  /// The assignment as calculated (snapshot of Core HR facts).
  organizationId             String                            @db.Uuid
  positionId                 String                            @db.Uuid
  positionName               String
  employmentType             EmploymentType
  assignmentStatus           EmploymentAssignmentStatus
  assignmentStartDate        DateTime                          @db.Date
  assignmentEndDate          DateTime?                         @db.Date
  /// Attendance timezone Time resolved (null: unresolved).
  timezone                   String?
  /// Normalized hash of every source fact this assignment was calculated from.
  sourceFingerprint          String?
  grossAmount                Decimal                           @default(0) @db.Decimal(19, 2)
  deductionAmount            Decimal                           @default(0) @db.Decimal(19, 2)
  employerContributionAmount Decimal                           @default(0) @db.Decimal(19, 2)
  createdAt                  DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                          @updatedAt @db.Timestamptz(6)
  runEmployee                PayrollRunEmployee                @relation(fields: [payrollRunEmployeeId, payrollRunId, employeeId], references: [id, payrollRunId, employeeId], onDelete: Restrict)
  employmentAssignment       EmploymentAssignment              @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  validationIssues           PayrollValidationIssue[]
  earningLines               PayrollEarningLine[]
  compensationSnapshots      PayrollCompensationSnapshot[]
  timeSnapshots              PayrollTimeSnapshot[]
  leaveSnapshots             PayrollLeaveSnapshot[]
  presenceSnapshots          PayrollPresenceSnapshot[]
  deductionLines             PayrollDeductionLine[]
  contributionLines          PayrollEmployerContributionLine[]
  sourceClaims               PayrollSourceClaim[]
  benefitSnapshots           PayrollBenefitSnapshot[]

  @@unique([payrollRunEmployeeId, employmentAssignmentId])
  @@unique([id, payrollRunEmployeeId])
  @@unique([id, payrollRunId])
  @@unique([id, payrollRunId, employmentAssignmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

/// What kind of source a run pays: an assignment's approved worked time or salaried day on a
/// date, or a leave day.
enum PayrollSourceKind {
  WORKED_TIME
  SALARY_DAY
  LEAVE
  BENEFIT_DAY
}

/// Phase 10 hardening — the sources a live or finalized run pays. Each assignment's worked time
/// and salaried day of a date, and each leave day, is claimed by at most one run (partial unique
/// indexes in the migration): a run recalculating replaces its own claims, a voided run releases
/// them, a finalized run keeps them forever (a later correction is an adjustment, never a second
/// payment).
/// Batch 4A — a finalized payroll run paid time that has since been reopened. Finalized runs and
/// their claims are never rewritten; the corrected time needs an explicit retroactive adjustment
/// (payroll warns PRIOR_PERIOD_SOURCE_CHANGED against each such run until one answers it, or a
/// PayrollRetroResolution records that there is no difference to pay).
/// Append-only (trigger); one row per run, timesheet, assignment and paid version (partial unique
/// indexes in SQL: a second reopen of the same paid time adds nothing).
model PayrollRetroRequirement {
  id                     String               @id @default(uuid()) @db.Uuid
  payrollRunId           String               @db.Uuid
  timesheetId            String               @db.Uuid
  employeeId             String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  /// The timesheet version the finalized run paid, read from its own PayrollTimeSnapshot rows.
  /// Null when the run's snapshots don't name exactly one version of this timesheet (never
  /// guessed from the timesheet's current version).
  timesheetVersion       Int?
  /// The claimed work dates of this assignment in the reopened period.
  firstWorkDate          DateTime             @db.Date
  lastWorkDate           DateTime             @db.Date
  reason                 String
  createdByUserId        String               @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  run                    PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  timesheet              Timesheet            @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  createdBy              User                 @relation("PayrollRetroRequirementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([payrollRunId, timesheetId, employmentAssignmentId])
  @@index([employmentAssignmentId, payrollRunId])
  @@index([timesheetId])
}

/// Batch 4A — the retro calculation of a finalized run settled an assignment: its current sources
/// (sourceFingerprint) give exactly the finalized gross plus the run's retro adjustments
/// (adjustedAmount), either already (NO_ADJUSTMENT_REQUIRED) or with the adjustment it just
/// created (ADJUSTED). It answers the PRIOR_PERIOD_SOURCE_CHANGED warning only while both still
/// hold: a later change of the sources (new fingerprint) or of the adjustments (one cancelled)
/// brings the warning back. Written by the retro tool, audited (PAYROLL_RETRO_RESOLVED),
/// append-only (trigger), never duplicated (unique key).
model PayrollRetroResolution {
  id                     String               @id @default(uuid()) @db.Uuid
  payrollRunId           String               @db.Uuid
  employeeId             String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  sourceFingerprint      String
  /// Sum of the run's non-cancelled EARNING adjustments for the assignment, once settled.
  adjustedAmount         Decimal              @db.Decimal(19, 2)
  /// NO_ADJUSTMENT_REQUIRED or ADJUSTED.
  outcome                String
  reason                 String
  resolvedByUserId       String               @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  run                    PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  resolvedBy             User                 @relation("PayrollRetroResolutionActor", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employmentAssignmentId, sourceFingerprint, adjustedAmount])
  @@index([employmentAssignmentId, payrollRunId])
}

model PayrollSourceClaim {
  id                     String               @id @default(uuid()) @db.Uuid
  payrollRunId           String               @db.Uuid
  payrollRunAssignmentId String               @db.Uuid
  employmentAssignmentId String               @db.Uuid
  kind                   PayrollSourceKind
  workDate               DateTime             @db.Date
  /// LEAVE claims: the leave day paid.
  leaveRequestDayId      String?              @db.Uuid
  /// BENEFIT_DAY claims: the benefit election paid for (one claim per election and date).
  benefitEnrollmentId    String?              @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  run                    PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment @relation(fields: [payrollRunAssignmentId, payrollRunId, employmentAssignmentId], references: [id, payrollRunId, employmentAssignmentId], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([payrollRunAssignmentId, payrollRunId, employmentAssignmentId])
  @@index([employmentAssignmentId, workDate])
}

/// A finding of payroll validation, at run, employee or assignment level. `code` is a stable
/// machine-readable string (e.g. MISSING_COMPENSATION), deliberately not a Prisma enum;
/// metadata carries identifiers and context only, never pay amounts or personal data.
model PayrollValidationIssue {
  id                     String                    @id @default(uuid()) @db.Uuid
  payrollRunId           String                    @db.Uuid
  payrollRunEmployeeId   String?                   @db.Uuid
  payrollRunAssignmentId String?                   @db.Uuid
  severity               PayrollValidationSeverity
  code                   String
  message                String
  metadata               Json?
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  run                    PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runEmployee            PayrollRunEmployee?       @relation(fields: [payrollRunEmployeeId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  /// An assignment-level issue names the run employee too, and the assignment must be theirs.
  runAssignment          PayrollRunAssignment?     @relation(fields: [payrollRunAssignmentId, payrollRunEmployeeId], references: [id, payrollRunEmployeeId], onDelete: Restrict)

  @@index([payrollRunId, severity])
  @@index([payrollRunEmployeeId])
  @@index([payrollRunAssignmentId])
}

enum PayrollSalaryUnpaidLeaveRule {
  UNCONFIGURED
  HOURLY_EQUIVALENT
}

enum PayrollStatutoryStatus {
  NOT_CALCULATED
  CALCULATED
}

/// What a gross earning line pays. OVERTIME and VACATION_PAY will be added when calculated.
enum PayrollEarningType {
  REGULAR_HOURLY
  REGULAR_SALARY
  PAID_LEAVE
  UNPAID_LEAVE_REDUCTION
  MANUAL_EARNING
  RETRO_ADJUSTMENT
}

/// CALCULATED lines are replaced by every recalculation; MANUAL lines are entered (and only
/// ever reversed) by a payroll administrator; ADJUSTMENT lines carry a PayrollAdjustment.
enum PayrollLineOrigin {
  CALCULATED
  MANUAL
  ADJUSTMENT
}

enum PayrollQuantityUnit {
  MINUTES
  CALENDAR_DAYS
}

/// One gross earning of a run assignment, explainable on its own: quantity x rate = amount,
/// the rule (and version) that produced it, and the snapshot of the source it came from.
model PayrollEarningLine {
  id                     String                       @id @default(uuid()) @db.Uuid
  payrollRunId           String                       @db.Uuid
  payrollRunAssignmentId String                       @db.Uuid
  origin                 PayrollLineOrigin
  type                   PayrollEarningType
  description            String
  workDate               DateTime?                    @db.Date
  periodFrom             DateTime?                    @db.Date
  periodTo               DateTime?                    @db.Date
  quantity               Decimal?                     @db.Decimal(19, 4)
  quantityUnit           PayrollQuantityUnit?
  rateAmount             Decimal?                     @db.Decimal(19, 4)
  /// Money, 2 decimals, half-up rounded per line. Negative only for reductions and reversals.
  amount                 Decimal                      @db.Decimal(19, 2)
  currency               String                       @db.Char(3)
  calculationRule        String
  calculationRuleVersion Int
  compensationSnapshotId String?                      @db.Uuid
  timeSnapshotId         String?                      @db.Uuid
  leaveSnapshotId        String?                      @db.Uuid
  /// MANUAL lines: why and who.
  reason                 String?
  createdByUserId        String?                      @db.Uuid
  /// A MANUAL reversal of another manual line of the same run (lines are never edited).
  reversesLineId         String?                      @unique @db.Uuid
  /// ADJUSTMENT lines: the adjustment they carry.
  payrollAdjustmentId    String?                      @unique @db.Uuid
  createdAt              DateTime                     @default(now()) @db.Timestamptz(6)
  run                    PayrollRun                   @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment         @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  compensationSnapshot   PayrollCompensationSnapshot? @relation(fields: [compensationSnapshotId, payrollRunAssignmentId], references: [id, payrollRunAssignmentId], onDelete: Restrict)
  timeSnapshot           PayrollTimeSnapshot?         @relation(fields: [timeSnapshotId, payrollRunAssignmentId], references: [id, payrollRunAssignmentId], onDelete: Restrict)
  leaveSnapshot          PayrollLeaveSnapshot?        @relation(fields: [leaveSnapshotId, payrollRunAssignmentId], references: [id, payrollRunAssignmentId], onDelete: Restrict)
  createdBy              User?                        @relation("PayrollEarningLineAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reverses               PayrollEarningLine?          @relation("PayrollEarningLineReversal", fields: [reversesLineId], references: [id], onDelete: Restrict)
  reversedBy             PayrollEarningLine?          @relation("PayrollEarningLineReversal")
  adjustment             PayrollAdjustment?           @relation("PayrollAdjustmentEarningLine", fields: [payrollAdjustmentId], references: [id], onDelete: Restrict)
  correctedBy            PayrollAdjustment[]          @relation("PayrollAdjustmentSourceLine")

  @@index([payrollRunId, origin])
  @@index([payrollRunAssignmentId, type])
}

/// The compensation fact a run assignment was calculated with (immutable copy; ids only point
/// back at the source, so a finalized run stays explainable after any later change).
model PayrollCompensationSnapshot {
  id                     String                         @id @default(uuid()) @db.Uuid
  payrollRunId           String                         @db.Uuid
  payrollRunAssignmentId String                         @db.Uuid
  compensationRecordId   String                         @db.Uuid
  payBasis               CompensationPayBasis
  rateAmount             Decimal                        @db.Decimal(19, 4)
  salaryArrangement      CompensationSalaryArrangement?
  salaryMonthlyAmount    Decimal?                       @db.Decimal(19, 4)
  salaryPaidMonths       Int?
  salaryContractAmount   Decimal?                       @db.Decimal(19, 4)
  salaryPeriodStart      DateTime?                      @db.Date
  salaryPeriodEnd        DateTime?                      @db.Date
  currency               String                         @db.Char(3)
  effectiveFrom          DateTime                       @db.Date
  effectiveTo            DateTime?                      @db.Date
  payGroupId             String?                        @db.Uuid
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  run                    PayrollRun                     @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment           @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  earningLines           PayrollEarningLine[]

  @@unique([id, payrollRunAssignmentId])
  @@index([payrollRunAssignmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

/// One approved work date of the assignment as Time froze it at timesheet approval.
model PayrollTimeSnapshot {
  id                     String               @id @default(uuid()) @db.Uuid
  payrollRunId           String               @db.Uuid
  payrollRunAssignmentId String               @db.Uuid
  timePeriodId           String               @db.Uuid
  timesheetId            String               @db.Uuid
  timesheetSegmentId     String               @db.Uuid
  timesheetVersion       Int
  /// APPROVED or LOCKED.
  finalizationStatus     String
  workDate               DateTime             @db.Date
  approvedWorkedMinutes  Int
  grossMinutes           Int
  paidBreakMinutes       Int
  unpaidBreakMinutes     Int
  policyDeductionMinutes Int
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  run                    PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  earningLines           PayrollEarningLine[]

  @@unique([id, payrollRunAssignmentId])
  @@index([payrollRunAssignmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

/// One approved, uncancelled leave day with its frozen minutes and classification.
model PayrollLeaveSnapshot {
  id                        String               @id @default(uuid()) @db.Uuid
  payrollRunId              String               @db.Uuid
  payrollRunAssignmentId    String               @db.Uuid
  leaveRequestId            String               @db.Uuid
  leaveRequestDayId         String               @db.Uuid
  leaveTypeId               String               @db.Uuid
  leaveTypeCode             String
  classification            LeaveClassification
  date                      DateTime             @db.Date
  minutes                   Int
  scheduledShiftRevisionIds String[]             @default([]) @db.Uuid
  createdAt                 DateTime             @default(now()) @db.Timestamptz(6)
  run                       PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment             PayrollRunAssignment @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  earningLines              PayrollEarningLine[]

  @@unique([id, payrollRunAssignmentId])
  @@index([payrollRunAssignmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

/// A presence sign-in seen for review/compliance only: it never carries or implies duration.
model PayrollPresenceSnapshot {
  id                       String               @id @default(uuid()) @db.Uuid
  payrollRunId             String               @db.Uuid
  payrollRunAssignmentId   String               @db.Uuid
  attendanceSignInId       String               @db.Uuid
  signedInAt               DateTime             @db.Timestamptz(6)
  workDate                 DateTime             @db.Date
  scheduledShiftRevisionId String?              @db.Uuid
  createdAt                DateTime             @default(now()) @db.Timestamptz(6)
  run                      PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment            PayrollRunAssignment @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)

  @@index([payrollRunAssignmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

/// MANUAL: entered by a payroll administrator. STATUTORY: produced only by a statutory engine
/// (none exists in Phase 10). ADJUSTMENT: carries a PayrollAdjustment.
enum PayrollDeductionCategory {
  MANUAL
  STATUTORY
  ADJUSTMENT
  BENEFIT
}

enum PayrollContributionCategory {
  MANUAL
  STATUTORY
  BENEFIT
}

enum PayrollAdjustmentKind {
  EARNING
  DEDUCTION
}

/// PENDING until the run that carries it is finalized (APPLIED); CANCELLED never applies.
enum PayrollAdjustmentStatus {
  PENDING
  APPLIED
  CANCELLED
}

/// An employee deduction of a run assignment (positive: withheld). Never edited: a manual
/// deduction is undone by a reversing line.
model PayrollDeductionLine {
  id                     String                   @id @default(uuid()) @db.Uuid
  payrollRunId           String                   @db.Uuid
  payrollRunAssignmentId String                   @db.Uuid
  category               PayrollDeductionCategory
  code                   String?
  description            String
  amount                 Decimal                  @db.Decimal(19, 2)
  currency               String                   @db.Char(3)
  reason                 String?
  createdByUserId        String?                  @db.Uuid
  reversesLineId         String?                  @unique @db.Uuid
  payrollAdjustmentId    String?                  @unique @db.Uuid
  /// BENEFIT lines: the benefit snapshot they were calculated from.
  benefitSnapshotId      String?                  @db.Uuid
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  run                    PayrollRun               @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment     @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  createdBy              User?                    @relation("PayrollDeductionLineAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reverses               PayrollDeductionLine?    @relation("PayrollDeductionLineReversal", fields: [reversesLineId], references: [id], onDelete: Restrict)
  reversedBy             PayrollDeductionLine?    @relation("PayrollDeductionLineReversal")
  adjustment             PayrollAdjustment?       @relation("PayrollAdjustmentDeductionLine", fields: [payrollAdjustmentId], references: [id], onDelete: Restrict)
  benefitSnapshot        PayrollBenefitSnapshot?  @relation(fields: [benefitSnapshotId, payrollRunAssignmentId], references: [id, payrollRunAssignmentId], onDelete: Restrict)

  @@index([payrollRunId, category])
  @@index([payrollRunAssignmentId])
}

/// An employer contribution of a run assignment (generic; no statutory producer exists yet).
model PayrollEmployerContributionLine {
  id                     String                           @id @default(uuid()) @db.Uuid
  payrollRunId           String                           @db.Uuid
  payrollRunAssignmentId String                           @db.Uuid
  category               PayrollContributionCategory
  code                   String?
  description            String
  amount                 Decimal                          @db.Decimal(19, 2)
  currency               String                           @db.Char(3)
  reason                 String?
  createdByUserId        String?                          @db.Uuid
  reversesLineId         String?                          @unique @db.Uuid
  /// BENEFIT lines: the benefit snapshot they were calculated from.
  benefitSnapshotId      String?                          @db.Uuid
  createdAt              DateTime                         @default(now()) @db.Timestamptz(6)
  run                    PayrollRun                       @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment          PayrollRunAssignment             @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  createdBy              User?                            @relation("PayrollContributionLineAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reverses               PayrollEmployerContributionLine? @relation("PayrollContributionLineReversal", fields: [reversesLineId], references: [id], onDelete: Restrict)
  benefitSnapshot        PayrollBenefitSnapshot?          @relation(fields: [benefitSnapshotId, payrollRunAssignmentId], references: [id, payrollRunAssignmentId], onDelete: Restrict)
  reversedBy             PayrollEmployerContributionLine? @relation("PayrollContributionLineReversal")

  @@index([payrollRunId, category])
  @@index([payrollRunAssignmentId])
}

/// A difference to pay (or recover) in a later run: a retroactive source correction of a
/// finalized run, a missed payment, or the correction of a wrong line. The finalized run it
/// refers to is never rewritten; the next live run of the pay group and currency that pays
/// the assignment carries it (claims it), and finalizing that run applies it.
model PayrollAdjustment {
  id                     String                                @id @default(uuid()) @db.Uuid
  organizationId         String                                @db.Uuid
  payGroupId             String                                @db.Uuid
  employeeId             String                                @db.Uuid
  employmentAssignmentId String                                @db.Uuid
  currency               String                                @db.Char(3)
  kind                   PayrollAdjustmentKind
  /// Signed: positive pays more (EARNING) or withholds more (DEDUCTION); never zero.
  amount                 Decimal                               @db.Decimal(19, 2)
  description            String
  reason                 String
  status                 PayrollAdjustmentStatus               @default(PENDING)
  /// The finalized run (and line) being corrected, when there is one.
  sourceRunId            String?                               @db.Uuid
  sourceEarningLineId    String?                               @db.Uuid
  /// The assignment's source fingerprint a retro adjustment was computed from.
  sourceFingerprint      String?
  /// The live run carrying it (claimed at calculation), then the run that applied it.
  payrollRunId           String?                               @db.Uuid
  appliedAt              DateTime?                             @db.Timestamptz(6)
  cancelledAt            DateTime?                             @db.Timestamptz(6)
  cancelledByUserId      String?                               @db.Uuid
  cancelReason           String?
  createdByUserId        String                                @db.Uuid
  createdAt              DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                              @updatedAt @db.Timestamptz(6)
  organization           Organization                          @relation("PayrollAdjustmentOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  payGroup               PayGroup                              @relation(fields: [payGroupId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment                  @relation(fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  sourceRun              PayrollRun?                           @relation("PayrollAdjustmentSourceRun", fields: [sourceRunId], references: [id], onDelete: Restrict)
  sourceEarningLine      PayrollEarningLine?                   @relation("PayrollAdjustmentSourceLine", fields: [sourceEarningLineId], references: [id], onDelete: Restrict)
  run                    PayrollRun?                           @relation("PayrollAdjustmentRun", fields: [payrollRunId], references: [id], onDelete: Restrict)
  createdBy              User                                  @relation("PayrollAdjustmentAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// Security remediation M2: the live run a cancelled adjustment was removed from (set once,
  /// with the cancellation): its canceller changed that run's pay.
  cancelledFromRunId     String?                               @db.Uuid
  cancelledFromRun       PayrollRun?                           @relation("PayrollAdjustmentCancelledFromRun", fields: [cancelledFromRunId], references: [id], onDelete: Restrict)
  compensationSources    PayrollAdjustmentCompensationSource[]
  cancelledBy            User?                                 @relation("PayrollAdjustmentCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  earningLine            PayrollEarningLine?                   @relation("PayrollAdjustmentEarningLine")
  deductionLine          PayrollDeductionLine?                 @relation("PayrollAdjustmentDeductionLine")

  @@index([payGroupId, currency, status])
  @@index([employmentAssignmentId, status])
  @@index([sourceRunId])
  @@index([payrollRunId])
}

/// Security remediation M2 — the compensation records a retro adjustment was computed from (the
/// current records of its assignment when the retro tool ran). Append-only.
model PayrollAdjustmentCompensationSource {
  adjustmentId         String             @db.Uuid
  compensationRecordId String             @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  adjustment           PayrollAdjustment  @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  compensationRecord   CompensationRecord @relation(fields: [compensationRecordId], references: [id], onDelete: Restrict)

  @@id([adjustmentId, compensationRecordId])
  @@index([compensationRecordId])
}

// ─── Phase 11 — Benefits ─────────────────────────────────────────────────────

enum BenefitType {
  HEALTH
  DENTAL
  VISION
  LIFE
  DISABILITY
  RETIREMENT
  WELLNESS
  OTHER
}

/// DRAFT: being configured (no elections). ACTIVE: accepts elections. CLOSED: no new elections;
/// existing coverage continues until it is ended.
enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum BenefitCoverageLevel {
  EMPLOYEE_ONLY
  EMPLOYEE_SPOUSE
  EMPLOYEE_CHILDREN
  FAMILY
  CUSTOM
}

enum BenefitRateFrequency {
  PER_PAY_PERIOD
  MONTHLY
  ANNUAL
}

enum BenefitRecordType {
  INITIAL
  CHANGE
  CORRECTION
}

/// SPOUSE includes a common-law or domestic partner.
enum BenefitDependentRelationship {
  SPOUSE
  CHILD
  OTHER
}

enum BenefitElectionType {
  ENROLLED
  WAIVED
}

/// Phase 11 — an organization's benefit plan. Its code, organization and currency never change;
/// costs live in effective-dated BenefitRates per coverage option, never on the plan.
model BenefitPlan {
  id                          String                   @id @default(uuid()) @db.Uuid
  organizationId              String                   @db.Uuid
  code                        String
  name                        String
  description                 String?
  benefitType                 BenefitType
  /// Provider (carrier, administrator) metadata only: no carrier integration.
  providerName                String?
  providerReference           String?
  /// ISO-4217: every rate of the plan is in this currency.
  currency                    String                   @db.Char(3)
  status                      BenefitPlanStatus        @default(DRAFT)
  effectiveFrom               DateTime                 @db.Date
  effectiveTo                 DateTime?                @db.Date
  /// Indicator for payroll/reporting that the employer-paid cost is a taxable benefit. No tax
  /// is calculated.
  employerContributionTaxable Boolean                  @default(false)
  showEmployerCostToEmployee  Boolean                  @default(true)
  /// Children are eligible dependents up to (and including) this age; null: no age limit.
  dependentChildMaxAge        Int?
  createdByUserId             String?                  @db.Uuid
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                 @updatedAt @db.Timestamptz(6)
  archivedAt                  DateTime?                @db.Timestamptz(6)
  organization                Organization             @relation("OrganizationBenefitPlans", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                   User?                    @relation("BenefitPlanAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  options                     BenefitCoverageOption[]
  rates                       BenefitRate[]
  eligibilityRules            BenefitEligibilityRule[]
  enrollments                 BenefitEnrollment[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status, archivedAt])
}

/// A coverage tier of a plan (e.g. employee only, family); each has its own rates.
model BenefitCoverageOption {
  id            String               @id @default(uuid()) @db.Uuid
  planId        String               @db.Uuid
  code          String
  name          String
  coverageLevel BenefitCoverageLevel
  sortOrder     Int                  @default(0)
  archivedAt    DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  plan          BenefitPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  rates         BenefitRate[]
  enrollments   BenefitEnrollment[]

  @@unique([planId, code])
  @@unique([id, planId])
  @@index([planId, archivedAt, sortOrder])
}

/// Effective-dated cost of a coverage option. Never edited: a change closes the previous rate
/// and starts a new one; a correction supersedes a rate (it then leaves the timeline).
model BenefitRate {
  id               String                @id @default(uuid()) @db.Uuid
  planId           String                @db.Uuid
  optionId         String                @db.Uuid
  effectiveFrom    DateTime              @db.Date
  effectiveTo      DateTime?             @db.Date
  frequency        BenefitRateFrequency
  employeeAmount   Decimal               @db.Decimal(19, 2)
  employerAmount   Decimal               @db.Decimal(19, 2)
  recordType       BenefitRecordType
  supersedesRateId String?               @unique @db.Uuid
  supersededAt     DateTime?             @db.Timestamptz(6)
  reason           String?
  createdByUserId  String?               @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)
  plan             BenefitPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  option           BenefitCoverageOption @relation(fields: [optionId, planId], references: [id, planId], onDelete: Restrict)
  supersedes       BenefitRate?          @relation("BenefitRateCorrection", fields: [supersedesRateId], references: [id], onDelete: Restrict)
  supersededBy     BenefitRate?          @relation("BenefitRateCorrection")
  createdBy        User?                 @relation("BenefitRateAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([optionId, effectiveFrom])
  @@index([planId, effectiveFrom])
}

/// Who a plan is offered to over a date range. Criteria in one rule all apply (AND); a plan's
/// rules are alternatives (OR); a plan without rules is offered to every active assignment of
/// its organization. Criteria never change: a change ends the rule and starts another.
model BenefitEligibilityRule {
  id                   String              @id @default(uuid()) @db.Uuid
  planId               String              @db.Uuid
  organizationId       String              @db.Uuid
  effectiveFrom        DateTime            @db.Date
  effectiveTo          DateTime?           @db.Date
  organizationalUnitId String?             @db.Uuid
  includeSubunits      Boolean             @default(true)
  departmentId         String?             @db.Uuid
  positionId           String?             @db.Uuid
  /// Empty: any employment type.
  employmentTypes      EmploymentType[]    @default([])
  /// Days since the employee's hire date (inclusive of the hire date).
  minimumServiceDays   Int?
  createdByUserId      String?             @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  plan                 BenefitPlan         @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organizationalUnit   OrganizationalUnit? @relation("BenefitRuleUnit", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department           Department?         @relation("BenefitRuleDepartment", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  position             Position?           @relation("BenefitRulePosition", fields: [positionId], references: [id], onDelete: Restrict)
  createdBy            User?               @relation("BenefitRuleAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([planId, effectiveFrom])
  @@index([organizationId])
}

/// A dependent of an employee, kept only for benefits (not a Person, never a user). Archived,
/// never deleted, once referenced by an election.
model BenefitDependent {
  id                    String                       @id @default(uuid()) @db.Uuid
  employeeId            String                       @db.Uuid
  firstName             String
  lastName              String
  relationship          BenefitDependentRelationship
  dateOfBirth           DateTime?                    @db.Date
  relationshipStartDate DateTime?                    @db.Date
  relationshipEndDate   DateTime?                    @db.Date
  archivedAt            DateTime?                    @db.Timestamptz(6)
  createdByUserId       String?                      @db.Uuid
  createdAt             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(6)
  employee              Employee                     @relation("EmployeeBenefitDependents", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy             User?                        @relation("BenefitDependentAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  coverages             BenefitEnrollmentDependent[]

  @@unique([id, employeeId])
  @@index([employeeId, archivedAt])
}

/// One segment of an employee's election timeline for a plan: enrolled in an option, or waived.
/// Coverage belongs to the employee (one timeline per employee and plan, whatever their
/// assignments); the sponsoring assignment gives its organization scope and payroll context.
/// Never edited: a change ends the segment and starts another; a correction supersedes it.
/// Status (pending, active, ended, waived) is derived from the dates, never stored.
model BenefitEnrollment {
  id                        String                       @id @default(uuid()) @db.Uuid
  employeeId                String                       @db.Uuid
  employmentAssignmentId    String                       @db.Uuid
  organizationId            String                       @db.Uuid
  planId                    String                       @db.Uuid
  optionId                  String?                      @db.Uuid
  electionType              BenefitElectionType
  recordType                BenefitRecordType
  coverageStart             DateTime                     @db.Date
  coverageEnd               DateTime?                    @db.Date
  /// When the employee made (or HR recorded) the election.
  electedOn                 DateTime                     @db.Date
  reason                    String?
  /// Set when HR enrolled despite the eligibility rules, with why.
  eligibilityOverrideReason String?
  supersedesEnrollmentId    String?                      @unique @db.Uuid
  supersededAt              DateTime?                    @db.Timestamptz(6)
  supersessionReason        String?
  /// Batch 7C (C1): why coverage was ended (HR note; never in audit metadata).
  endReason                 String?
  createdByUserId           String?                      @db.Uuid
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                     @updatedAt @db.Timestamptz(6)
  employmentAssignment      EmploymentAssignment         @relation("AssignmentBenefitEnrollments", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  plan                      BenefitPlan                  @relation(fields: [planId, organizationId], references: [id, organizationId], onDelete: Restrict)
  option                    BenefitCoverageOption?       @relation(fields: [optionId, planId], references: [id, planId], onDelete: Restrict)
  supersedes                BenefitEnrollment?           @relation("BenefitEnrollmentCorrection", fields: [supersedesEnrollmentId], references: [id], onDelete: Restrict)
  supersededBy              BenefitEnrollment?           @relation("BenefitEnrollmentCorrection")
  createdBy                 User?                        @relation("BenefitEnrollmentAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  dependents                BenefitEnrollmentDependent[]

  @@unique([id, employeeId])
  @@index([employeeId, planId, coverageStart])
  @@index([employmentAssignmentId, coverageStart])
  @@index([planId, coverageStart])
  @@index([organizationId])
}

/// A dependent covered by an enrollment segment (both of the same employee). Immutable.
model BenefitEnrollmentDependent {
  id           String            @id @default(uuid()) @db.Uuid
  enrollmentId String            @db.Uuid
  employeeId   String            @db.Uuid
  dependentId  String            @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  enrollment   BenefitEnrollment @relation(fields: [enrollmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  dependent    BenefitDependent  @relation(fields: [dependentId, employeeId], references: [id, employeeId], onDelete: Restrict)

  @@unique([enrollmentId, dependentId])
  @@index([dependentId])
}

/// Phase 11 — the benefit facts (election, plan, option, rate) a run's BENEFIT deduction and
/// contribution lines were calculated from, frozen with the run.
model PayrollBenefitSnapshot {
  id                          String                            @id @default(uuid()) @db.Uuid
  payrollRunId                String                            @db.Uuid
  payrollRunAssignmentId      String                            @db.Uuid
  benefitEnrollmentId         String                            @db.Uuid
  planId                      String                            @db.Uuid
  planCode                    String
  planName                    String
  benefitType                 BenefitType
  optionId                    String                            @db.Uuid
  optionCode                  String
  coverageLevel               BenefitCoverageLevel
  rateId                      String                            @db.Uuid
  frequency                   BenefitRateFrequency
  employeeAmount              Decimal                           @db.Decimal(19, 2)
  employerAmount              Decimal                           @db.Decimal(19, 2)
  currency                    String                            @db.Char(3)
  employerContributionTaxable Boolean
  /// The covered dates of the fact (before pay-group ownership within the period).
  coveredFrom                 DateTime                          @db.Date
  coveredTo                   DateTime                          @db.Date
  createdAt                   DateTime                          @default(now()) @db.Timestamptz(6)
  run                         PayrollRun                        @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  runAssignment               PayrollRunAssignment              @relation(fields: [payrollRunAssignmentId, payrollRunId], references: [id, payrollRunId], onDelete: Restrict)
  deductionLines              PayrollDeductionLine[]
  contributionLines           PayrollEmployerContributionLine[]

  @@unique([id, payrollRunAssignmentId])
  @@index([payrollRunAssignmentId])
  @@index([benefitEnrollmentId])
  /// Phase 19: run-level reads (payroll run detail, recalculation, reporting).
  @@index([payrollRunId])
}

// ─── Phase 12 — Performance Management ─────────────────────────────────────────────────────

/// Lifecycle of reusable configuration (rating scales, templates): edited as DRAFT, frozen once
/// ACTIVE (a change is a new version), ARCHIVED to stop new use. History never depends on it:
/// cycles snapshot what they use.
enum PerformanceConfigStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Explicit, domain-specific template item types (not a generic form builder).
enum PerformanceItemType {
  /// Rated on a rating scale (optionally a competency).
  RATING
  /// A whole number between scaleMin and scaleMax.
  SCALE
  TEXT
  YES_NO
  /// Progress commentary on the review's linked goals.
  GOAL_PROGRESS
  /// Supporting evidence (e.g. an imported assessment) linked to the review.
  EVIDENCE_REFERENCE
}

enum PerformanceRespondent {
  SELF
  REVIEWER
  BOTH
}

enum PerformanceScoringMode {
  /// Comment-only or rated without a calculated score.
  NONE
  /// Weighted average of the reviewer's RATING items (weights total 100).
  WEIGHTED_AVERAGE
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/// Who reviews by default: the assignment's direct manager when the review is added (HR can
/// reassign), or nobody until HR assigns a reviewer.
enum PerformanceReviewerModel {
  DIRECT_MANAGER
  HR_ASSIGNED
}

enum PerformanceReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  /// The reviewer submitted; awaiting finalization.
  SUBMITTED
  /// Shared with the employee; content locked (corrections are explicit).
  FINALIZED
  ACKNOWLEDGED
  CLOSED
}

/// Status of one part (self review, reviewer review) of a review.
enum PerformancePartStatus {
  NOT_REQUIRED
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  /// Locked unsubmitted (the review was finalized or closed without it).
  NOT_SUBMITTED
}

enum PerformanceReviewerSource {
  DIRECT_MANAGER
  ASSIGNED
}

enum PerformanceReviewEventType {
  ADDED
  REVIEWER_CHANGED
  SELF_SUBMITTED
  REVIEWER_SUBMITTED
  SELF_REOPENED
  REVIEWER_REOPENED
  FINALIZED
  ACKNOWLEDGED
  CORRECTED
  CLOSED
}

enum PerformanceResponseRecordType {
  ORIGINAL
  CORRECTION
}

enum PerformanceCloseReason {
  COMPLETED
  NOT_ACKNOWLEDGED
  INCOMPLETE
}

enum PerformanceGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Where a piece of evidence comes from. Provider-neutral: GOOGLE_FORMS is one source among
/// others, never special-cased by the review lifecycle.
enum PerformanceEvidenceProvider {
  GOOGLE_FORMS
  MANUAL
  TRAINING
  CERTIFICATION
  OTHER
}

enum PerformanceEvidenceKind {
  ASSESSMENT
  TRAINING
  CERTIFICATION
  POLICY_ACKNOWLEDGEMENT
  OTHER
}

/// How a record arrived: entered by HR, imported through the ingestion API, or synchronized
/// by a provider adapter.
enum PerformanceEvidenceChannel {
  MANUAL
  IMPORT
  SYNC
}

enum PerformanceEvidenceStatus {
  ACTIVE
  /// Retracted (e.g. invalid or removed at the source); kept for history.
  WITHDRAWN
}

enum PerformanceIntakeStatus {
  /// No employee could be confidently matched: waiting for HR.
  PENDING_MATCH
  MATCHED
  REJECTED
}

/// An organization's competency (e.g. Communication, Classroom Management). Name edits never
/// change history: cycles snapshot the label.
model PerformanceCompetency {
  id              String                    @id @default(uuid()) @db.Uuid
  organizationId  String                    @db.Uuid
  code            String
  name            String
  description     String?
  category        String?
  createdByUserId String?                   @db.Uuid
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(6)
  archivedAt      DateTime?                 @db.Timestamptz(6)
  organization    Organization              @relation("OrganizationPerformanceCompetencies", fields: [organizationId], references: [id], onDelete: Restrict)
  templateItems   PerformanceTemplateItem[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
}

/// A reusable rating scale; its levels are frozen once ACTIVE.
model PerformanceRatingScale {
  id              String                        @id @default(uuid()) @db.Uuid
  organizationId  String                        @db.Uuid
  code            String
  name            String
  description     String?
  status          PerformanceConfigStatus       @default(DRAFT)
  createdByUserId String?                       @db.Uuid
  createdAt       DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                      @updatedAt @db.Timestamptz(6)
  activatedAt     DateTime?                     @db.Timestamptz(6)
  archivedAt      DateTime?                     @db.Timestamptz(6)
  organization    Organization                  @relation("OrganizationPerformanceScales", fields: [organizationId], references: [id], onDelete: Restrict)
  levels          PerformanceRatingScaleLevel[]
  templates       PerformanceTemplate[]
  templateItems   PerformanceTemplateItem[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model PerformanceRatingScaleLevel {
  id          String                 @id @default(uuid()) @db.Uuid
  scaleId     String                 @db.Uuid
  value       Int
  label       String
  description String?
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  scale       PerformanceRatingScale @relation(fields: [scaleId], references: [id], onDelete: Restrict)

  @@unique([scaleId, value])
}

/// A reusable review template: sections of explicit items. Content is editable only as DRAFT.
model PerformanceTemplate {
  id                   String                       @id @default(uuid()) @db.Uuid
  organizationId       String                       @db.Uuid
  code                 String
  name                 String
  description          String?
  status               PerformanceConfigStatus      @default(DRAFT)
  scoringMode          PerformanceScoringMode       @default(NONE)
  /// The overall rating scale (and the scale of weighted items).
  ratingScaleId        String?                      @db.Uuid
  overallRatingEnabled Boolean                      @default(false)
  createdByUserId      String?                      @db.Uuid
  createdAt            DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(6)
  activatedAt          DateTime?                    @db.Timestamptz(6)
  archivedAt           DateTime?                    @db.Timestamptz(6)
  organization         Organization                 @relation("OrganizationPerformanceTemplates", fields: [organizationId], references: [id], onDelete: Restrict)
  ratingScale          PerformanceRatingScale?      @relation(fields: [ratingScaleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sections             PerformanceTemplateSection[]
  items                PerformanceTemplateItem[]
  cycles               PerformanceCycle[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model PerformanceTemplateSection {
  id          String                    @id @default(uuid()) @db.Uuid
  templateId  String                    @db.Uuid
  title       String
  description String?
  sortOrder   Int
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(6)
  template    PerformanceTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items       PerformanceTemplateItem[]

  @@unique([id, templateId])
  @@index([templateId, sortOrder])
}

model PerformanceTemplateItem {
  id             String                     @id @default(uuid()) @db.Uuid
  templateId     String                     @db.Uuid
  sectionId      String                     @db.Uuid
  organizationId String                     @db.Uuid
  sortOrder      Int
  itemType       PerformanceItemType
  prompt         String
  helpText       String?
  respondent     PerformanceRespondent
  required       Boolean                    @default(false)
  /// WEIGHTED_AVERAGE templates: the weight of a reviewer RATING item (weights total 100).
  weight         Decimal?                   @db.Decimal(5, 2)
  competencyId   String?                    @db.Uuid
  ratingScaleId  String?                    @db.Uuid
  scaleMin       Int?
  scaleMax       Int?
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(6)
  template       PerformanceTemplate        @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  section        PerformanceTemplateSection @relation(fields: [sectionId, templateId], references: [id, templateId], onDelete: Restrict)
  competency     PerformanceCompetency?     @relation(fields: [competencyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ratingScale    PerformanceRatingScale?    @relation(fields: [ratingScaleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([templateId, sectionId, sortOrder])
  @@index([competencyId])
}

/// An organization's review cycle. Opening it freezes the template into the cycle's form
/// snapshot (PerformanceFormSection/Item); the review period and template never change after.
model PerformanceCycle {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @db.Uuid
  code                   String
  name                   String
  description            String?
  status                 PerformanceCycleStatus   @default(DRAFT)
  templateId             String                   @db.Uuid
  reviewerModel          PerformanceReviewerModel @default(DIRECT_MANAGER)
  selfReviewEnabled      Boolean                  @default(true)
  acknowledgementEnabled Boolean                  @default(true)
  periodStart            DateTime                 @db.Date
  periodEnd              DateTime                 @db.Date
  /// Reviews are written between windowStart and windowEnd (the lock date).
  windowStart            DateTime                 @db.Date
  windowEnd              DateTime                 @db.Date
  selfReviewDueDate      DateTime?                @db.Date
  reviewerDueDate        DateTime?                @db.Date
  /// Frozen at opening from the template.
  scoringMode            PerformanceScoringMode?
  overallRatingEnabled   Boolean?
  /// [{ value, label, description }] of the template's rating scale, frozen at opening.
  overallScaleLevels     Json?
  overallScaleName       String?
  openedAt               DateTime?                @db.Timestamptz(6)
  openedByUserId         String?                  @db.Uuid
  closedAt               DateTime?                @db.Timestamptz(6)
  closedByUserId         String?                  @db.Uuid
  archivedAt             DateTime?                @db.Timestamptz(6)
  createdByUserId        String?                  @db.Uuid
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  organization           Organization             @relation("OrganizationPerformanceCycles", fields: [organizationId], references: [id], onDelete: Restrict)
  template               PerformanceTemplate      @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  formSections           PerformanceFormSection[]
  formItems              PerformanceFormItem[]
  reviews                PerformanceReview[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

/// Immutable snapshot of a template section for one cycle.
model PerformanceFormSection {
  id          String                @id @default(uuid()) @db.Uuid
  cycleId     String                @db.Uuid
  sortOrder   Int
  title       String
  description String?
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  cycle       PerformanceCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  items       PerformanceFormItem[]

  @@unique([cycleId, sortOrder])
  @@unique([id, cycleId])
}

/// Immutable snapshot of a template item for one cycle: wording, competency label, scale
/// levels, weight and order exactly as reviewed.
model PerformanceFormItem {
  id             String                      @id @default(uuid()) @db.Uuid
  cycleId        String                      @db.Uuid
  sectionId      String                      @db.Uuid
  sortOrder      Int
  itemType       PerformanceItemType
  prompt         String
  helpText       String?
  respondent     PerformanceRespondent
  required       Boolean
  weight         Decimal?                    @db.Decimal(5, 2)
  /// For reporting only; the label below is what reviewers saw.
  competencyId   String?                     @db.Uuid
  competencyCode String?
  competencyName String?
  /// RATING: [{ value, label, description }].
  scaleLevels    Json?
  scaleMin       Int?
  scaleMax       Int?
  templateItemId String?                     @db.Uuid
  createdAt      DateTime                    @default(now()) @db.Timestamptz(6)
  cycle          PerformanceCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  section        PerformanceFormSection      @relation(fields: [sectionId, cycleId], references: [id, cycleId], onDelete: Restrict)
  responses      PerformanceReviewResponse[]
  evidenceLinks  PerformanceReviewEvidence[]

  @@unique([id, cycleId])
  @@unique([sectionId, sortOrder])
}

/// One employee's review in a cycle, tied to the employment assignment being evaluated. One
/// per (cycle, assignment). The reviewer is explicit; reviewer changes are kept as events.
model PerformanceReview {
  id                          String                             @id @default(uuid()) @db.Uuid
  cycleId                     String                             @db.Uuid
  organizationId              String                             @db.Uuid
  employeeId                  String                             @db.Uuid
  employmentAssignmentId      String                             @db.Uuid
  status                      PerformanceReviewStatus            @default(NOT_STARTED)
  selfStatus                  PerformancePartStatus
  reviewerStatus              PerformancePartStatus              @default(NOT_STARTED)
  reviewerEmployeeId          String?                            @db.Uuid
  /// The reviewer's assignment when assigned (their manager position at the time).
  reviewerAssignmentId        String?                            @db.Uuid
  reviewerSource              PerformanceReviewerSource?
  reviewerAssignedAt          DateTime?                          @db.Timestamptz(6)
  selfSubmittedAt             DateTime?                          @db.Timestamptz(6)
  selfSubmittedByUserId       String?                            @db.Uuid
  reviewerSubmittedAt         DateTime?                          @db.Timestamptz(6)
  reviewerSubmittedByUserId   String?                            @db.Uuid
  /// Who actually submitted the reviewer part (kept when reviewers change later).
  reviewerSubmittedEmployeeId String?                            @db.Uuid
  /// Backend-calculated (WEIGHTED_AVERAGE); advisory, never the rating itself.
  calculatedScore             Decimal?                           @db.Decimal(6, 2)
  overallRatingValue          Int?
  overallRatingLabel          String?
  finalizedAt                 DateTime?                          @db.Timestamptz(6)
  finalizedByUserId           String?                            @db.Uuid
  acknowledgedAt              DateTime?                          @db.Timestamptz(6)
  closedAt                    DateTime?                          @db.Timestamptz(6)
  closedByUserId              String?                            @db.Uuid
  closeReason                 PerformanceCloseReason?
  createdByUserId             String?                            @db.Uuid
  createdAt                   DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                           @updatedAt @db.Timestamptz(6)
  cycle                       PerformanceCycle                   @relation(fields: [cycleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employmentAssignment        EmploymentAssignment               @relation("AssignmentPerformanceReviews", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  reviewer                    Employee?                          @relation("PerformanceReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)
  responses                   PerformanceReviewResponse[]
  events                      PerformanceReviewEvent[]
  acknowledgements            PerformanceReviewAcknowledgement[]
  goalLinks                   PerformanceReviewGoal[]
  evidenceLinks               PerformanceReviewEvidence[]

  @@unique([cycleId, employmentAssignmentId])
  @@unique([id, employeeId])
  @@unique([id, cycleId])
  @@index([employeeId, status])
  @@index([reviewerEmployeeId, status])
  @@index([organizationId, status])
}

/// An answer to a form item by one respondent. Drafts are edited in place; submitted answers
/// are locked and only ever superseded (reopened edits, explicit corrections).
model PerformanceReviewResponse {
  id                   String                        @id @default(uuid()) @db.Uuid
  reviewId             String                        @db.Uuid
  cycleId              String                        @db.Uuid
  itemId               String                        @db.Uuid
  respondent           PerformanceRespondent
  ratingValue          Int?
  ratingLabel          String?
  numericValue         Int?
  booleanValue         Boolean?
  textValue            String?
  recordType           PerformanceResponseRecordType @default(ORIGINAL)
  lockedAt             DateTime?                     @db.Timestamptz(6)
  supersedesResponseId String?                       @unique @db.Uuid
  supersededAt         DateTime?                     @db.Timestamptz(6)
  correctionReason     String?
  authorUserId         String?                       @db.Uuid
  authorEmployeeId     String?                       @db.Uuid
  createdAt            DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                      @updatedAt @db.Timestamptz(6)
  review               PerformanceReview             @relation(fields: [reviewId, cycleId], references: [id, cycleId], onDelete: Restrict)
  item                 PerformanceFormItem           @relation(fields: [itemId, cycleId], references: [id, cycleId], onDelete: Restrict)
  supersedes           PerformanceReviewResponse?    @relation("PerformanceResponseRevision", fields: [supersedesResponseId], references: [id], onDelete: Restrict)
  supersededBy         PerformanceReviewResponse?    @relation("PerformanceResponseRevision")

  @@index([reviewId, itemId])
}

/// Append-only history of a review: reviewer identity changes, submissions, reopenings,
/// finalization, acknowledgement, corrections, closing. Reasons only; never review content.
model PerformanceReviewEvent {
  id              String                     @id @default(uuid()) @db.Uuid
  reviewId        String                     @db.Uuid
  type            PerformanceReviewEventType
  actorUserId     String?                    @db.Uuid
  actorEmployeeId String?                    @db.Uuid
  fromEmployeeId  String?                    @db.Uuid
  toEmployeeId    String?                    @db.Uuid
  fromStatus      PerformanceReviewStatus?
  toStatus        PerformanceReviewStatus?
  reason          String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  review          PerformanceReview          @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
}

/// The employee saw the finalized review (not necessarily agreement). A later correction
/// supersedes it and asks for a new acknowledgement.
model PerformanceReviewAcknowledgement {
  id             String            @id @default(uuid()) @db.Uuid
  reviewId       String            @db.Uuid
  employeeId     String            @db.Uuid
  userId         String            @db.Uuid
  comment        String?
  acknowledgedAt DateTime          @default(now()) @db.Timestamptz(6)
  supersededAt   DateTime?         @db.Timestamptz(6)
  review         PerformanceReview @relation(fields: [reviewId, employeeId], references: [id, employeeId], onDelete: Restrict)

  @@index([reviewId])
}

/// A performance goal of one employment assignment; may be linked into reviews of the same
/// assignment. Completed and cancelled goals are frozen.
model PerformanceGoal {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  employeeId             String                  @db.Uuid
  employmentAssignmentId String                  @db.Uuid
  title                  String
  description            String?
  measure                String?
  startDate              DateTime                @db.Date
  dueDate                DateTime?               @db.Date
  status                 PerformanceGoalStatus   @default(NOT_STARTED)
  progressPercent        Int?
  completionNotes        String?
  completedAt            DateTime?               @db.Timestamptz(6)
  cancelledAt            DateTime?               @db.Timestamptz(6)
  cancellationReason     String?
  createdByUserId        String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  organization           Organization            @relation("OrganizationPerformanceGoals", fields: [organizationId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment    @relation("AssignmentPerformanceGoals", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  reviewLinks            PerformanceReviewGoal[]

  @@unique([id, employeeId])
  @@index([employeeId, status])
  @@index([employmentAssignmentId, status])
  @@index([organizationId, status])
}

/// A goal linked into a review; at finalization the goal's state is frozen on the link.
model PerformanceReviewGoal {
  id               String                 @id @default(uuid()) @db.Uuid
  reviewId         String                 @db.Uuid
  goalId           String                 @db.Uuid
  employeeId       String                 @db.Uuid
  linkedByUserId   String?                @db.Uuid
  linkedAt         DateTime               @default(now()) @db.Timestamptz(6)
  unlinkedAt       DateTime?              @db.Timestamptz(6)
  unlinkedByUserId String?                @db.Uuid
  snapshotTitle    String?
  snapshotStatus   PerformanceGoalStatus?
  snapshotProgress Int?
  snapshottedAt    DateTime?              @db.Timestamptz(6)
  review           PerformanceReview      @relation(fields: [reviewId, employeeId], references: [id, employeeId], onDelete: Restrict)
  goal             PerformanceGoal        @relation(fields: [goalId, employeeId], references: [id, employeeId], onDelete: Restrict)

  @@index([reviewId])
  @@index([goalId])
}

/// A configured external source of evidence in one organization, e.g. the Google Form used
/// for the staff Code of Conduct quiz. Results from it belong to its organization only.
model PerformanceEvidenceSource {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @db.Uuid
  code                 String
  name                 String
  provider             PerformanceEvidenceProvider
  kind                 PerformanceEvidenceKind
  /// The provider's resource identifier (e.g. a Google Form id).
  externalResourceId   String?
  /// The latest known resource title; results keep their own title snapshot.
  resourceTitle        String?
  resourceUrl          String?
  /// A result passes at or above this percentage (snapshotted onto each result).
  passThresholdPercent Decimal?                    @db.Decimal(5, 2)
  lastSyncedAt         DateTime?                   @db.Timestamptz(6)
  lastSyncStatus       String?
  lastSyncMessage      String?
  createdByUserId      String?                     @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(6)
  archivedAt           DateTime?                   @db.Timestamptz(6)
  organization         Organization                @relation("OrganizationPerformanceEvidenceSources", fields: [organizationId], references: [id], onDelete: Restrict)
  evidence             PerformanceEvidence[]
  intakes              PerformanceEvidenceIntake[]
  googleFormBindings   GoogleFormBinding[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, provider])
}

/// A piece of performance evidence (e.g. a quiz result) about one employee. Immutable: a
/// corrected external result becomes a new revision superseding this one. Deduplicated by
/// (organization, provider, externalResourceId, externalResultId) among current revisions.
model PerformanceEvidence {
  id                     String                      @id @default(uuid()) @db.Uuid
  organizationId         String                      @db.Uuid
  employeeId             String                      @db.Uuid
  /// The assignment it concerns when known; employee-level evidence otherwise.
  employmentAssignmentId String?                     @db.Uuid
  sourceId               String?                     @db.Uuid
  provider               PerformanceEvidenceProvider
  kind                   PerformanceEvidenceKind
  channel                PerformanceEvidenceChannel
  /// Title as completed (meaningful even if the external form is renamed or deleted).
  title                  String
  externalResourceId     String?
  externalResultId       String?
  completedAt            DateTime                    @db.Timestamptz(6)
  score                  Decimal?                    @db.Decimal(10, 2)
  maxScore               Decimal?                    @db.Decimal(10, 2)
  percentage             Decimal?                    @db.Decimal(5, 2)
  passed                 Boolean?
  passThresholdPercent   Decimal?                    @db.Decimal(5, 2)
  resultUrl              String?
  /// When the source last changed the result (corrections are ordered by it).
  externalUpdatedAt      DateTime?                   @db.Timestamptz(6)
  contentHash            String?
  notes                  String?
  status                 PerformanceEvidenceStatus   @default(ACTIVE)
  withdrawnAt            DateTime?                   @db.Timestamptz(6)
  withdrawalReason       String?
  revision               Int                         @default(1)
  supersedesEvidenceId   String?                     @unique @db.Uuid
  supersededAt           DateTime?                   @db.Timestamptz(6)
  correctionReason       String?
  importedAt             DateTime                    @default(now()) @db.Timestamptz(6)
  recordedByUserId       String?                     @db.Uuid
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  organization           Organization                @relation("OrganizationPerformanceEvidence", fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee                    @relation("EmployeePerformanceEvidence", fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment?       @relation("AssignmentPerformanceEvidence", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  source                 PerformanceEvidenceSource?  @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supersedes             PerformanceEvidence?        @relation("PerformanceEvidenceRevision", fields: [supersedesEvidenceId], references: [id], onDelete: Restrict)
  supersededBy           PerformanceEvidence?        @relation("PerformanceEvidenceRevision")
  reviewLinks            PerformanceReviewEvidence[]
  intakes                PerformanceEvidenceIntake[]

  @@unique([id, employeeId])
  @@index([employeeId, completedAt])
  @@index([organizationId, provider])
  @@index([sourceId])
}

/// An external result that could not be confidently matched to an employee, held (with only
/// the normalized fields needed) until HR matches or rejects it. One per source result.
model PerformanceEvidenceIntake {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @db.Uuid
  sourceId            String                    @db.Uuid
  externalResultId    String
  /// Normalized (lower-case) respondent email as reported by the source, for matching.
  respondentEmail     String?
  respondentReference String?
  /// Normalized result fields (title, completedAt, score, maxScore, passed, url); never a
  /// raw response payload.
  result              Json
  status              PerformanceIntakeStatus   @default(PENDING_MATCH)
  reason              String
  evidenceId          String?                   @db.Uuid
  receivedAt          DateTime                  @default(now()) @db.Timestamptz(6)
  lastReceivedAt      DateTime                  @default(now()) @db.Timestamptz(6)
  resolvedAt          DateTime?                 @db.Timestamptz(6)
  resolvedByUserId    String?                   @db.Uuid
  resolutionNote      String?
  source              PerformanceEvidenceSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  evidence            PerformanceEvidence?      @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalResultId])
  @@index([organizationId, status])
}

/// Evidence linked to a review (optionally to an EVIDENCE_REFERENCE item). Links point at the
/// exact evidence revision reviewed; unlinking is recorded, never deleted.
model PerformanceReviewEvidence {
  id               String               @id @default(uuid()) @db.Uuid
  reviewId         String               @db.Uuid
  evidenceId       String               @db.Uuid
  employeeId       String               @db.Uuid
  cycleId          String               @db.Uuid
  formItemId       String?              @db.Uuid
  linkedByUserId   String?              @db.Uuid
  linkedAt         DateTime             @default(now()) @db.Timestamptz(6)
  unlinkedAt       DateTime?            @db.Timestamptz(6)
  unlinkedByUserId String?              @db.Uuid
  review           PerformanceReview    @relation(fields: [reviewId, employeeId], references: [id, employeeId], onDelete: Restrict)
  evidence         PerformanceEvidence  @relation(fields: [evidenceId, employeeId], references: [id, employeeId], onDelete: Restrict)
  formItem         PerformanceFormItem? @relation(fields: [formItemId, cycleId], references: [id, cycleId], onDelete: Restrict)

  @@index([reviewId])
  @@index([evidenceId])
}

// ─── Phase 13: Recruitment / Applicant Tracking ─────────────────────────────

enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  /// Every opening is filled by a hire (set by hire conversion; reopened when openings grow).
  FILLED
  CLOSED
  CANCELLED
}

enum JobOpeningEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  HIRE_RECORDED
}

/// What a stage means (configurable stages keep their own names and order).
enum RecruitmentStageKind {
  APPLIED
  SCREENING
  INTERVIEW
  ASSESSMENT
  REFERENCE_CHECK
  OFFER
  HIRED
  OTHER
}

enum RecruitmentCandidateStatus {
  ACTIVE
  /// Merged into another candidate (explicit, recorded); kept for history.
  MERGED
  ARCHIVED
}

enum RecruitmentSource {
  DIRECT
  REFERRAL
  JOB_BOARD
  AGENCY
  INTERNAL
  CAREERS_SITE
  EXTERNAL_FORM
  OTHER
}

enum RecruitmentApplicationStatus {
  ACTIVE
  WITHDRAWN
  REJECTED
  /// An offer was sent (or accepted) and is outstanding.
  OFFERED
  HIRED
}

enum RecruitmentScreeningOutcome {
  PENDING
  ADVANCE
  HOLD
  DO_NOT_ADVANCE
}

enum RecruitmentActivityType {
  APPLICATION_RECEIVED
  APPLICATION_UPDATED_EXTERNALLY
  STAGE_CHANGED
  SCREENING_RECORDED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  INTERVIEW_COMPLETED
  FEEDBACK_SUBMITTED
  FEEDBACK_REOPENED
  OFFER_CREATED
  OFFER_APPROVED
  OFFER_REVISED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_WITHDRAWN
  OFFER_EXPIRED
  APPLICATION_WITHDRAWN
  APPLICATION_REJECTED
  HIRED
  CANDIDATE_MERGED
  DOCUMENT_ADDED
  DOCUMENT_REMOVED
}

enum RecruitmentInterviewType {
  PHONE
  VIDEO
  IN_PERSON
  PANEL
  OTHER
}

enum RecruitmentInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RecruitmentRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
  NO_DECISION
}

enum RecruitmentFeedbackStatus {
  DRAFT
  SUBMITTED
}

enum RecruitmentOfferStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum RecruitmentDocumentKind {
  RESUME
  COVER_LETTER
  CERTIFICATE
  REFERENCE
  PORTFOLIO
  OTHER
}

/// Where a candidate document lives. The database keeps references and metadata only, never
/// file contents.
enum RecruitmentDocumentProvider {
  EXTERNAL_URL
  GOOGLE_DRIVE
  MANUAL_REFERENCE
}

enum RecruitmentIntakeProvider {
  GOOGLE_FORMS
  CAREERS_SITE
  MANUAL_IMPORT
  OTHER
}

enum RecruitmentIntakeStatus {
  /// Turned into (or attached to) an application.
  APPLIED
  /// No open opening could be determined: waiting for HR (unmatched opening queue).
  PENDING_OPENING
  REJECTED
}

/// An organization's ordered hiring stages. Names are snapshotted onto stage history, so
/// renaming or archiving a stage never rewrites what happened.
model RecruitmentStage {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  code            String
  name            String
  kind            RecruitmentStageKind
  sortOrder       Int
  createdByUserId String?                  @db.Uuid
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  archivedAt      DateTime?                @db.Timestamptz(6)
  organization    Organization             @relation("OrganizationRecruitmentStages", fields: [organizationId], references: [id], onDelete: Restrict)
  applications    RecruitmentApplication[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, sortOrder])
}

/// A job opening / requisition. Placement (unit, department, team, location) is the opening's
/// own authorization target; a Position may anchor it. Changes are kept as events.
model JobOpening {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @db.Uuid
  /// Requisition code, unique in the organization.
  code                    String
  title                   String
  description             String?
  positionId              String?                   @db.Uuid
  organizationalUnitId    String?                   @db.Uuid
  departmentId            String?                   @db.Uuid
  teamId                  String?                   @db.Uuid
  workLocationId          String?                   @db.Uuid
  /// Explicit hiring manager (reads the pipeline of this opening; never broader HR access).
  hiringManagerEmployeeId String?                   @db.Uuid
  /// The recruiter who owns the opening (ownership/filtering, not authorization).
  recruiterUserId         String?                   @db.Uuid
  employmentType          EmploymentType
  openingCount            Int                       @default(1)
  /// Hires recorded against the opening (maintained by hire conversion under a row lock).
  hiredCount              Int                       @default(0)
  expectedStartDate       DateTime?                 @db.Date
  postedOn                DateTime?                 @db.Date
  closesOn                DateTime?                 @db.Date
  /// Advertised range (HOURLY: per hour; SALARY: annual), informational only.
  compensationPayBasis    CompensationPayBasis?
  compensationMin         Decimal?                  @db.Decimal(19, 4)
  compensationMax         Decimal?                  @db.Decimal(19, 4)
  compensationCurrency    String?                   @db.Char(3)
  status                  JobOpeningStatus          @default(DRAFT)
  statusReason            String?
  openedAt                DateTime?                 @db.Timestamptz(6)
  closedAt                DateTime?                 @db.Timestamptz(6)
  createdByUserId         String?                   @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  organization            Organization              @relation("OrganizationJobOpenings", fields: [organizationId], references: [id], onDelete: Restrict)
  position                Position?                 @relation("PositionJobOpenings", fields: [positionId], references: [id], onDelete: Restrict)
  organizationalUnit      OrganizationalUnit?       @relation("UnitJobOpenings", fields: [organizationalUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department              Department?               @relation("DepartmentJobOpenings", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team                    Team?                     @relation("TeamJobOpenings", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workLocation            WorkLocation?             @relation("WorkLocationJobOpenings", fields: [workLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  hiringManager           Employee?                 @relation("JobOpeningHiringManager", fields: [hiringManagerEmployeeId], references: [id], onDelete: Restrict)
  events                  JobOpeningEvent[]
  applications            RecruitmentApplication[]
  intakeSources           RecruitmentIntakeSource[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([hiringManagerEmployeeId])
}

/// Append-only history of an opening: creation, field changes (names only) and status changes.
model JobOpeningEvent {
  id            String              @id @default(uuid()) @db.Uuid
  openingId     String              @db.Uuid
  type          JobOpeningEventType
  fromStatus    JobOpeningStatus?
  toStatus      JobOpeningStatus?
  changedFields String[]
  reason        String?
  actorUserId   String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  opening       JobOpening          @relation(fields: [openingId], references: [id], onDelete: Restrict)

  @@index([openingId, createdAt])
}

/// A Recruitment-owned identity in one organization. Not a Person, Employee or User; becomes
/// linked to a Person only through hire conversion. Deduplicated by normalized email.
model RecruitmentCandidate {
  id                    String                         @id @default(uuid()) @db.Uuid
  organizationId        String                         @db.Uuid
  firstName             String
  lastName              String
  preferredName         String?
  email                 String?
  /// lower(btrim(email)): the deduplication key (unique among unmerged candidates).
  normalizedEmail       String?
  phone                 String?
  location              String?
  source                RecruitmentSource              @default(DIRECT)
  /// Internal recruiter notes (never shown to hiring managers or interviewers).
  notes                 String?
  /// An internal candidate: the existing employee (reused on hire).
  internalEmployeeId    String?                        @db.Uuid
  /// Set by hire conversion: the Person this candidate became.
  personId              String?                        @db.Uuid
  status                RecruitmentCandidateStatus     @default(ACTIVE)
  /// Phase 19: set once by the data retention job (retention.rejectedCandidateMonths); the
  /// identity, contact details and notes are then redacted for good. Counts stay reportable.
  anonymizedAt          DateTime?                      @db.Timestamptz(6)
  mergedIntoCandidateId String?                        @db.Uuid
  mergedAt              DateTime?                      @db.Timestamptz(6)
  mergedByUserId        String?                        @db.Uuid
  createdByUserId       String?                        @db.Uuid
  createdAt             DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @db.Timestamptz(6)
  organization          Organization                   @relation("OrganizationRecruitmentCandidates", fields: [organizationId], references: [id], onDelete: Restrict)
  internalEmployee      Employee?                      @relation("RecruitmentInternalCandidates", fields: [internalEmployeeId], references: [id], onDelete: Restrict)
  person                Person?                        @relation("RecruitmentCandidatePerson", fields: [personId], references: [id], onDelete: Restrict)
  mergedInto            RecruitmentCandidate?          @relation("RecruitmentCandidateMerge", fields: [mergedIntoCandidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  mergedFrom            RecruitmentCandidate[]         @relation("RecruitmentCandidateMerge")
  applications          RecruitmentApplication[]
  activities            RecruitmentActivity[]
  documents             RecruitmentCandidateDocument[]
  hires                 RecruitmentHire[]
  intakeSubmissions     RecruitmentIntakeSubmission[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@index([internalEmployeeId])
}

/// A candidate's application to one opening. One live (ACTIVE/OFFERED/HIRED) application per
/// candidate and opening; withdrawn and rejected applications are kept.
model RecruitmentApplication {
  id                  String                         @id @default(uuid()) @db.Uuid
  organizationId      String                         @db.Uuid
  candidateId         String                         @db.Uuid
  openingId           String                         @db.Uuid
  stageId             String                         @db.Uuid
  status              RecruitmentApplicationStatus   @default(ACTIVE)
  source              RecruitmentSource              @default(DIRECT)
  sourceDetail        String?
  appliedAt           DateTime                       @db.Timestamptz(6)
  recruiterUserId     String?                        @db.Uuid
  stageEnteredAt      DateTime                       @default(now()) @db.Timestamptz(6)
  dispositionReason   String?
  dispositionAt       DateTime?                      @db.Timestamptz(6)
  dispositionByUserId String?                        @db.Uuid
  createdByUserId     String?                        @db.Uuid
  createdAt           DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                       @updatedAt @db.Timestamptz(6)
  candidate           RecruitmentCandidate           @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  opening             JobOpening                     @relation(fields: [openingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  stage               RecruitmentStage               @relation(fields: [stageId, organizationId], references: [id, organizationId], onDelete: Restrict)
  screening           RecruitmentScreening?
  transitions         RecruitmentStageTransition[]
  interviews          RecruitmentInterview[]
  offers              RecruitmentOffer[]
  hire                RecruitmentHire?
  activities          RecruitmentActivity[]
  documents           RecruitmentCandidateDocument[]
  intakeSubmissions   RecruitmentIntakeSubmission[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([openingId, status, stageId])
  @@index([candidateId])
}

/// Structured human screening of an application (no automated scoring). Editable while the
/// application is live; each recording is kept as an activity.
model RecruitmentScreening {
  id                         String                      @id @default(uuid()) @db.Uuid
  applicationId              String                      @unique @db.Uuid
  outcome                    RecruitmentScreeningOutcome @default(PENDING)
  meetsMinimumQualifications Boolean?
  workAuthorizationConfirmed Boolean?
  requiredCertificationsHeld Boolean?
  availableFrom              DateTime?                   @db.Date
  notes                      String?
  screenedByUserId           String?                     @db.Uuid
  screenedAt                 DateTime?                   @db.Timestamptz(6)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  application                RecruitmentApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
}

/// Append-only stage history: every move with the stage names as they were.
model RecruitmentStageTransition {
  id            String                 @id @default(uuid()) @db.Uuid
  applicationId String                 @db.Uuid
  fromStageId   String?                @db.Uuid
  fromStageName String?
  toStageId     String                 @db.Uuid
  toStageName   String
  note          String?
  actorUserId   String?                @db.Uuid
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
}

/// The candidate-facing recruitment timeline (append-only). Type and identifiers only: never
/// feedback content, compensation or internal notes. Distinct from the audit log.
model RecruitmentActivity {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  candidateId    String                  @db.Uuid
  applicationId  String?                 @db.Uuid
  type           RecruitmentActivityType
  /// A short, non-sensitive description (e.g. "Moved to Phone Screen").
  summary        String
  relatedId      String?                 @db.Uuid
  actorUserId    String?                 @db.Uuid
  occurredAt     DateTime                @default(now()) @db.Timestamptz(6)
  candidate      RecruitmentCandidate    @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  application    RecruitmentApplication? @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([candidateId, occurredAt])
  @@index([applicationId, occurredAt])
}

model RecruitmentInterview {
  id                 String                         @id @default(uuid()) @db.Uuid
  organizationId     String                         @db.Uuid
  applicationId      String                         @db.Uuid
  type               RecruitmentInterviewType
  title              String
  scheduledStart     DateTime                       @db.Timestamptz(6)
  durationMinutes    Int
  location           String?
  meetingUrl         String?
  status             RecruitmentInterviewStatus     @default(SCHEDULED)
  /// Feedback is expected by then (attention items); defaults to a day after the interview.
  feedbackDueAt      DateTime?                      @db.Timestamptz(6)
  completedAt        DateTime?                      @db.Timestamptz(6)
  cancelledAt        DateTime?                      @db.Timestamptz(6)
  cancellationReason String?
  createdByUserId    String?                        @db.Uuid
  createdAt          DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @db.Timestamptz(6)
  application        RecruitmentApplication         @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  interviewers       RecruitmentInterviewer[]
  feedback           RecruitmentInterviewFeedback[]

  @@index([applicationId, scheduledStart])
  @@index([organizationId, status, scheduledStart])
}

/// An explicitly assigned interviewer: the only way into an interview without recruitment.read.
model RecruitmentInterviewer {
  id               String               @id @default(uuid()) @db.Uuid
  interviewId      String               @db.Uuid
  userId           String               @db.Uuid
  assignedByUserId String?              @db.Uuid
  assignedAt       DateTime             @default(now()) @db.Timestamptz(6)
  removedAt        DateTime?            @db.Timestamptz(6)
  removedByUserId  String?              @db.Uuid
  interview        RecruitmentInterview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  user             User                 @relation("RecruitmentInterviewerUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([interviewId])
  @@index([userId, removedAt])
}

/// An interviewer's feedback. Submitted feedback is locked; an authorized reopening creates a
/// new revision (the submitted one is kept, superseded).
model RecruitmentInterviewFeedback {
  id                   String                        @id @default(uuid()) @db.Uuid
  interviewId          String                        @db.Uuid
  interviewerUserId    String                        @db.Uuid
  status               RecruitmentFeedbackStatus     @default(DRAFT)
  recommendation       RecruitmentRecommendation?
  /// 1–5 overall rating.
  rating               Int?
  strengths            String?
  concerns             String?
  comments             String?
  submittedAt          DateTime?                     @db.Timestamptz(6)
  revision             Int                           @default(1)
  supersedesFeedbackId String?                       @unique @db.Uuid
  supersededAt         DateTime?                     @db.Timestamptz(6)
  reopenReason         String?
  reopenedByUserId     String?                       @db.Uuid
  createdAt            DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                      @updatedAt @db.Timestamptz(6)
  interview            RecruitmentInterview          @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  supersedes           RecruitmentInterviewFeedback? @relation("RecruitmentFeedbackRevision", fields: [supersedesFeedbackId], references: [id], onDelete: Restrict)
  supersededBy         RecruitmentInterviewFeedback? @relation("RecruitmentFeedbackRevision")

  @@index([interviewId])
}

/// An offer to an applicant. Not a CompensationRecord: hire conversion may initialize one
/// through the Compensation domain. Terms are locked once approved.
model RecruitmentOffer {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @db.Uuid
  applicationId            String                 @db.Uuid
  positionId               String                 @db.Uuid
  workLocationId           String?                @db.Uuid
  employmentType           EmploymentType
  startDate                DateTime               @db.Date
  /// HOURLY: rateAmount per hour; SALARY: annual base (the Compensation pay bases).
  payBasis                 CompensationPayBasis
  rateAmount               Decimal                @db.Decimal(19, 4)
  currency                 String                 @db.Char(3)
  /// The last day the candidate may accept.
  expiresOn                DateTime?              @db.Date
  candidateTerms           String?
  internalNotes            String?
  status                   RecruitmentOfferStatus @default(DRAFT)
  approvedAt               DateTime?              @db.Timestamptz(6)
  approvedByUserId         String?                @db.Uuid
  sentAt                   DateTime?              @db.Timestamptz(6)
  sentByUserId             String?                @db.Uuid
  respondedAt              DateTime?              @db.Timestamptz(6)
  responseRecordedByUserId String?                @db.Uuid
  declineReason            String?
  withdrawnAt              DateTime?              @db.Timestamptz(6)
  withdrawalReason         String?
  expiredAt                DateTime?              @db.Timestamptz(6)
  createdByUserId          String?                @db.Uuid
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  application              RecruitmentApplication @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  position                 Position               @relation("PositionRecruitmentOffers", fields: [positionId], references: [id], onDelete: Restrict)
  workLocation             WorkLocation?          @relation("WorkLocationRecruitmentOffers", fields: [workLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  hire                     RecruitmentHire?

  @@unique([id, applicationId])
  @@index([applicationId, status])
  @@index([organizationId, status, expiresOn])
}

/// The permanent link from Recruitment to Core HR, written once by hire conversion.
model RecruitmentHire {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @db.Uuid
  applicationId          String                 @unique @db.Uuid
  offerId                String                 @unique @db.Uuid
  candidateId            String                 @db.Uuid
  openingId              String                 @db.Uuid
  personId               String                 @db.Uuid
  employeeId             String                 @db.Uuid
  employmentAssignmentId String                 @unique @db.Uuid
  compensationRecordId   String?                @unique @db.Uuid
  /// The candidate was an existing employee (the Employee was reused).
  internalCandidate      Boolean
  /// A new Person/Employee was created (false when an existing one was reused).
  createdEmployee        Boolean
  convertedByUserId      String?                @db.Uuid
  convertedAt            DateTime               @default(now()) @db.Timestamptz(6)
  application            RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  offer                  RecruitmentOffer       @relation(fields: [offerId, applicationId], references: [id, applicationId], onDelete: Restrict)
  candidate              RecruitmentCandidate   @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  person                 Person                 @relation("RecruitmentHirePerson", fields: [personId], references: [id], onDelete: Restrict)
  employee               Employee               @relation("RecruitmentHireEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment   @relation("RecruitmentHireAssignment", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  compensationRecord     CompensationRecord?    @relation("RecruitmentHireCompensation", fields: [compensationRecordId], references: [id], onDelete: Restrict)
  onboardingWorkflows    EmployeeWorkflow[]     @relation("RecruitmentHireOnboarding")
  employeeDocuments      EmployeeDocument[]     @relation("RecruitmentHireDocuments")

  @@unique([offerId, applicationId])
  @@index([organizationId, convertedAt])
  @@index([employeeId])
}

/// A reference to a candidate document (résumé, cover letter, certificate, …). Metadata and
/// a link or storage key only — never the file. Removal is recorded, never deleted.
model RecruitmentCandidateDocument {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @db.Uuid
  candidateId       String                      @db.Uuid
  applicationId     String?                     @db.Uuid
  kind              RecruitmentDocumentKind
  title             String
  provider          RecruitmentDocumentProvider
  externalUrl       String?
  /// The provider's file identifier (e.g. a Google Drive file id), when known.
  externalFileId    String?
  fileName          String?
  mimeType          String?
  addedByUserId     String?                     @db.Uuid
  addedAt           DateTime                    @default(now()) @db.Timestamptz(6)
  removedAt         DateTime?                   @db.Timestamptz(6)
  removedByUserId   String?                     @db.Uuid
  removalReason     String?
  candidate         RecruitmentCandidate        @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  application       RecruitmentApplication?     @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employeeDocuments EmployeeDocument[]          @relation("RecruitmentDocumentHandoffs")

  @@index([candidateId, removedAt])
  @@index([applicationId])
}

/// A configured external source of applications (e.g. the Google Form for teacher
/// applications). Submissions from it belong to its organization only.
model RecruitmentIntakeSource {
  id                 String                        @id @default(uuid()) @db.Uuid
  organizationId     String                        @db.Uuid
  code               String
  name               String
  provider           RecruitmentIntakeProvider
  externalResourceId String?
  resourceUrl        String?
  /// Submissions without an opening code go to this opening (when open).
  defaultOpeningId   String?                       @db.Uuid
  lastSyncedAt       DateTime?                     @db.Timestamptz(6)
  lastSyncStatus     String?
  lastSyncMessage    String?
  createdByUserId    String?                       @db.Uuid
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(6)
  archivedAt         DateTime?                     @db.Timestamptz(6)
  organization       Organization                  @relation("OrganizationRecruitmentIntakeSources", fields: [organizationId], references: [id], onDelete: Restrict)
  defaultOpening     JobOpening?                   @relation(fields: [defaultOpeningId, organizationId], references: [id, organizationId], onDelete: Restrict)
  submissions        RecruitmentIntakeSubmission[]
  googleFormBindings GoogleFormBinding[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

/// One external submission (e.g. a Google Form response), deduplicated per source response.
/// Keeps the normalized fields only — never a raw payload.
model RecruitmentIntakeSubmission {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  sourceId           String                  @db.Uuid
  externalResponseId String
  status             RecruitmentIntakeStatus
  /// Normalized candidate/application fields and answers.
  submission         Json
  contentHash        String
  submittedAt        DateTime                @db.Timestamptz(6)
  externalUpdatedAt  DateTime?               @db.Timestamptz(6)
  /// Times the content changed at the source after first receipt.
  correctionCount    Int                     @default(0)
  reason             String?
  candidateId        String?                 @db.Uuid
  applicationId      String?                 @db.Uuid
  receivedAt         DateTime                @default(now()) @db.Timestamptz(6)
  lastReceivedAt     DateTime                @default(now()) @db.Timestamptz(6)
  resolvedAt         DateTime?               @db.Timestamptz(6)
  resolvedByUserId   String?                 @db.Uuid
  source             RecruitmentIntakeSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  candidate          RecruitmentCandidate?   @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  application        RecruitmentApplication? @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([sourceId, externalResponseId])
  @@index([organizationId, status])
}

// ─── Phase 14: Onboarding & Offboarding ─────────────────────────────────────

enum EmployeeWorkflowKind {
  ONBOARDING
  OFFBOARDING
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowTaskCategory {
  PAPERWORK
  POLICY
  ACCOUNT_ACCESS
  EQUIPMENT
  ORIENTATION
  TRAINING
  PAYROLL
  BENEFITS
  MEETING
  RECORDS
  OTHER
}

/// Who completes a task: the employee themselves, their manager (resolved from the assignment's
/// reporting line when the workflow starts), HR (anyone with the workflow's manage permission)
/// or one specific user.
enum WorkflowTaskOwnerType {
  EMPLOYEE
  MANAGER
  HR
  SPECIFIC_USER
}

/// What a task's link points at. Provider-neutral: Google resources are references (ids and
/// links) a later Google Workspace integration can resolve; INTERNAL_DOCUMENT is an HRMS record.
enum WorkflowReferenceType {
  EXTERNAL_URL
  GOOGLE_FORM
  GOOGLE_DOC
  GOOGLE_DRIVE_FILE
  GOOGLE_DRIVE_FOLDER
  INTERNAL_DOCUMENT
  /// Phase 15: an organization policy document (its current published version is acknowledged).
  POLICY_DOCUMENT
  /// Phase 15: a required employee document type the employee provides (referenceExternalId is
  /// the DocumentType id).
  DOCUMENT_TYPE
}

/// A system action a task stands for (account provisioning or deactivation, access revocation,
/// equipment). Phase 14 never performs them automatically: a person completes the task; a
/// later integration may execute them through a contract.
enum WorkflowSystemAction {
  NONE
  PROVISION_HRMS_ACCOUNT
  DISABLE_HRMS_ACCOUNT
  PROVISION_EXTERNAL_ACCOUNT
  DISABLE_EXTERNAL_ACCOUNT
  REVOKE_BUILDING_ACCESS
  ISSUE_EQUIPMENT
  COLLECT_EQUIPMENT
}

enum EmployeeWorkflowStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmployeeWorkflowTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  WAIVED
  CANCELLED
}

enum WorkflowTaskCompletionSource {
  MANUAL
  /// Completed from an external submission (e.g. a Google Form response) through the contract.
  EXTERNAL
}

enum EmployeeWorkflowEventType {
  STARTED
  TASK_STARTED
  TASK_COMPLETED
  TASK_ACKNOWLEDGED
  TASK_WAIVED
  TASK_REOPENED
  TASK_REASSIGNED
  TASK_DUE_DATE_CHANGED
  TASK_CANCELLED
  COMPLETED
  REOPENED
  CANCELLED
}

/// An organization's reusable onboarding or offboarding checklist. Editing a template never
/// changes started workflows: each workflow keeps a frozen snapshot of its tasks.
model WorkflowTemplate {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  kind            EmployeeWorkflowKind
  code            String
  name            String
  description     String?
  status          WorkflowTemplateStatus @default(DRAFT)
  /// The template used when none is chosen (one active default per organization and kind).
  isDefault       Boolean                @default(false)
  createdByUserId String?                @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  activatedAt     DateTime?              @db.Timestamptz(6)
  archivedAt      DateTime?              @db.Timestamptz(6)
  organization    Organization           @relation("OrganizationWorkflowTemplates", fields: [organizationId], references: [id], onDelete: Restrict)
  tasks           WorkflowTemplateTask[]
  workflows       EmployeeWorkflow[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, kind, status])
}

model WorkflowTemplateTask {
  id                       String                 @id @default(uuid()) @db.Uuid
  templateId               String                 @db.Uuid
  organizationId           String                 @db.Uuid
  sortOrder                Int
  title                    String
  description              String?
  category                 WorkflowTaskCategory
  ownerType                WorkflowTaskOwnerType
  /// SPECIFIC_USER tasks: the owner.
  ownerUserId              String?                @db.Uuid
  /// Days from the workflow's anchor (start date / last day); negative is before it.
  dueOffsetDays            Int                    @default(0)
  required                 Boolean                @default(true)
  /// Completion needs a note or an evidence reference.
  evidenceRequired         Boolean                @default(false)
  /// Completion is the employee's acknowledgement of the statement below.
  acknowledgementRequired  Boolean                @default(false)
  acknowledgementStatement String?
  referenceType            WorkflowReferenceType?
  referenceUrl             String?
  /// The provider's resource id (a Google Form / Doc / Drive id) or an HRMS record id.
  referenceExternalId      String?
  referenceLabel           String?
  systemAction             WorkflowSystemAction   @default(NONE)
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)
  template                 WorkflowTemplate       @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ownerUser                User?                  @relation("WorkflowTemplateTaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([templateId, sortOrder])
}

/// One employee's onboarding or offboarding, attached to an employment assignment. Starting
/// offboarding never ends employment: Core HR stays authoritative for assignment end and
/// termination; the planned date only anchors due dates.
model EmployeeWorkflow {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  kind                   EmployeeWorkflowKind
  employeeId             String                  @db.Uuid
  employmentAssignmentId String                  @db.Uuid
  templateId             String?                 @db.Uuid
  /// Snapshot of the template as started.
  templateCode           String?
  templateName           String
  status                 EmployeeWorkflowStatus  @default(ACTIVE)
  /// Due dates count from this date: the start date (onboarding) or the last day (offboarding).
  anchorDate             DateTime                @db.Date
  /// Offboarding: the planned last day (Core HR's assignment end date is not changed by it).
  plannedEndDate         DateTime?               @db.Date
  /// Offboarding reason (sensitive; never shown to the employee or task owners).
  reason                 String?
  /// Set when the onboarding was started from a Phase 13 hire conversion.
  recruitmentHireId      String?                 @unique @db.Uuid
  startedByUserId        String?                 @db.Uuid
  startedAt              DateTime                @default(now()) @db.Timestamptz(6)
  completedAt            DateTime?               @db.Timestamptz(6)
  completedByUserId      String?                 @db.Uuid
  cancelledAt            DateTime?               @db.Timestamptz(6)
  cancelledByUserId      String?                 @db.Uuid
  cancellationReason     String?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  organization           Organization            @relation("OrganizationEmployeeWorkflows", fields: [organizationId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment    @relation("AssignmentEmployeeWorkflows", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  template               WorkflowTemplate?       @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recruitmentHire        RecruitmentHire?        @relation("RecruitmentHireOnboarding", fields: [recruitmentHireId], references: [id], onDelete: Restrict)
  tasks                  EmployeeWorkflowTask[]
  events                 EmployeeWorkflowEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, kind, status])
  @@index([employeeId, kind])
  @@index([employmentAssignmentId])
}

/// A task of one workflow: a frozen snapshot of the template task (wording, owner rule,
/// requirements, references) with its own lifecycle. Completed tasks reopen only explicitly.
model EmployeeWorkflowTask {
  id                        String                        @id @default(uuid()) @db.Uuid
  workflowId                String                        @db.Uuid
  organizationId            String                        @db.Uuid
  templateTaskId            String?                       @db.Uuid
  sortOrder                 Int
  title                     String
  description               String?
  category                  WorkflowTaskCategory
  ownerType                 WorkflowTaskOwnerType
  /// The responsible user (resolved at start; null for HR-pool tasks or an unresolved manager).
  ownerUserId               String?                       @db.Uuid
  dueDate                   DateTime?                     @db.Date
  required                  Boolean
  evidenceRequired          Boolean
  acknowledgementRequired   Boolean
  acknowledgementStatement  String?
  referenceType             WorkflowReferenceType?
  referenceUrl              String?
  referenceExternalId       String?
  referenceLabel            String?
  systemAction              WorkflowSystemAction
  status                    EmployeeWorkflowTaskStatus    @default(NOT_STARTED)
  startedAt                 DateTime?                     @db.Timestamptz(6)
  completedAt               DateTime?                     @db.Timestamptz(6)
  completedByUserId         String?                       @db.Uuid
  completionNote            String?
  evidenceReference         String?
  completionSource          WorkflowTaskCompletionSource?
  /// The external submission that completed it (deduplicates external completions).
  externalCompletionId      String?
  acknowledgedAt            DateTime?                     @db.Timestamptz(6)
  acknowledgedByUserId      String?                       @db.Uuid
  waivedAt                  DateTime?                     @db.Timestamptz(6)
  waivedByUserId            String?                       @db.Uuid
  waiverReason              String?
  cancelledAt               DateTime?                     @db.Timestamptz(6)
  reopenCount               Int                           @default(0)
  createdAt                 DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                      @updatedAt @db.Timestamptz(6)
  workflow                  EmployeeWorkflow              @relation(fields: [workflowId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ownerUser                 User?                         @relation("EmployeeWorkflowTaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  events                    EmployeeWorkflowEvent[]
  documentAcknowledgementId String?                       @db.Uuid
  documentAcknowledgement   DocumentAcknowledgement?      @relation("WorkflowTaskDocumentAcknowledgement", fields: [documentAcknowledgementId], references: [id], onDelete: Restrict)

  @@index([workflowId, sortOrder])
  @@index([ownerUserId, status])
  @@index([organizationId, status, dueDate])
}

/// Append-only timeline of a workflow and its tasks (statuses, reasons and notes; never
/// document contents).
model EmployeeWorkflowEvent {
  id          String                    @id @default(uuid()) @db.Uuid
  workflowId  String                    @db.Uuid
  taskId      String?                   @db.Uuid
  type        EmployeeWorkflowEventType
  fromStatus  String?
  toStatus    String?
  note        String?
  actorUserId String?                   @db.Uuid
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  workflow    EmployeeWorkflow          @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  task        EmployeeWorkflowTask?     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([workflowId, createdAt])
  @@index([taskId, createdAt])
}

// ─── Phase 15: Documents & Employee Records ─────────────────────────────────

/// System categories of organization-managed document types.
enum DocumentCategory {
  EMPLOYMENT_AGREEMENT
  OFFER_LETTER
  RESUME
  CERTIFICATION
  LICENSE
  BACKGROUND_CHECK
  HANDBOOK
  POLICY
  EVALUATION
  PAYROLL
  TAX
  IDENTIFICATION
  TRAINING_CERTIFICATE
  OTHER
}

/// Who may see a document beyond document managers: EMPLOYEE_VISIBLE (the employee and
/// document.read), MANAGER_VISIBLE (document.read only), HR_ONLY (document.confidential.read),
/// RESTRICTED (document.restricted.read).
enum DocumentConfidentiality {
  EMPLOYEE_VISIBLE
  MANAGER_VISIBLE
  HR_ONLY
  RESTRICTED
}

/// Where a document lives. The database keeps references and metadata only, never contents.
enum DocumentStorageProvider {
  GOOGLE_DRIVE
  EXTERNAL_URL
  INTERNAL_OBJECT_STORAGE
  MANUAL_REFERENCE
}

enum EmployeeDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum EmployeeDocumentSource {
  HR
  EMPLOYEE
  RECRUITMENT_HANDOFF
  ONBOARDING
}

/// The last known state of a version's external reference (maintained by a storage adapter).
enum DocumentReferenceStatus {
  UNKNOWN
  OK
  MISSING
  ACCESS_DENIED
}

enum PolicyDocumentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum DocumentAcknowledgementSource {
  SELF_SERVICE
  ONBOARDING_TASK
}

/// An organization's document type (configurable, with a system category).
model DocumentType {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  code                   String
  name                   String
  description            String?
  category               DocumentCategory
  defaultConfidentiality DocumentConfidentiality @default(HR_ONLY)
  /// Documents of this type carry an expiry date (certifications, licences, first aid…).
  expiryTracked          Boolean                 @default(false)
  /// The employee may provide documents of this type through self-service.
  employeeProvided       Boolean                 @default(false)
  createdByUserId        String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  archivedAt             DateTime?               @db.Timestamptz(6)
  organization           Organization            @relation("OrganizationDocumentTypes", fields: [organizationId], references: [id], onDelete: Restrict)
  documents              EmployeeDocument[]
  requirements           DocumentRequirement[]
  policies               PolicyDocument[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

/// An employee record (metadata). Its file references live in versions; corrections and
/// replacements are new versions, never overwrites.
model EmployeeDocument {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @db.Uuid
  employeeId             String                        @db.Uuid
  employmentAssignmentId String?                       @db.Uuid
  typeId                 String                        @db.Uuid
  title                  String
  description            String?
  confidentiality        DocumentConfidentiality
  status                 EmployeeDocumentStatus        @default(ACTIVE)
  source                 EmployeeDocumentSource
  /// Provenance of a Phase 13 hand-off (the candidate document it was copied from).
  recruitmentDocumentId  String?                       @db.Uuid
  recruitmentHireId      String?                       @db.Uuid
  /// The onboarding task it was provided for, when applicable.
  workflowTaskId         String?                       @db.Uuid
  createdByUserId        String?                       @db.Uuid
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(6)
  archivedAt             DateTime?                     @db.Timestamptz(6)
  archivedByUserId       String?                       @db.Uuid
  archiveReason          String?
  organization           Organization                  @relation("OrganizationEmployeeDocuments", fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee                      @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment?         @relation("AssignmentDocuments", fields: [employmentAssignmentId, employeeId], references: [id, employeeId], onDelete: Restrict)
  type                   DocumentType                  @relation(fields: [typeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recruitmentDocument    RecruitmentCandidateDocument? @relation("RecruitmentDocumentHandoffs", fields: [recruitmentDocumentId], references: [id], onDelete: Restrict)
  recruitmentHire        RecruitmentHire?              @relation("RecruitmentHireDocuments", fields: [recruitmentHireId], references: [id], onDelete: Restrict)
  versions               EmployeeDocumentVersion[]

  @@unique([id, organizationId])
  @@index([employeeId, status])
  @@index([organizationId, typeId, status])
}

/// One version of a document: its storage reference and dates. Immutable except for the
/// adapter-maintained reference status and its supersession by the next version.
model EmployeeDocumentVersion {
  id                 String                  @id @default(uuid()) @db.Uuid
  documentId         String                  @db.Uuid
  versionNumber      Int
  provider           DocumentStorageProvider
  externalUrl        String?
  /// Internal object-storage key (INTERNAL_OBJECT_STORAGE), never a file.
  storageKey         String?
  /// The provider's file id (e.g. a Google Drive file id).
  externalFileId     String?
  fileName           String?
  mimeType           String?
  sizeBytes          Int?
  issuedOn           DateTime?               @db.Date
  effectiveOn        DateTime?               @db.Date
  expiresOn          DateTime?               @db.Date
  note               String?
  referenceStatus    DocumentReferenceStatus @default(UNKNOWN)
  referenceCheckedAt DateTime?               @db.Timestamptz(6)
  createdByUserId    String?                 @db.Uuid
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  supersededAt       DateTime?               @db.Timestamptz(6)
  /// Batch 9: the uploaded file (INTERNAL_OBJECT_STORAGE), bound once by the server. NULL for
  /// links, Drive files, manual references and legacy hand-typed keys (never downloadable).
  storedObjectId     String?                 @unique @db.Uuid
  storedObject       DocumentStoredObject?   @relation("EmployeeDocumentVersionObject", fields: [storedObjectId], references: [id], onDelete: Restrict)
  document           EmployeeDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([expiresOn])
}

/// Batch 9 — the lifecycle of an uploaded file's stored object.
enum DocumentStoredObjectStatus {
  /// Row written before the bytes; the object may be partial or absent.
  UPLOADING
  /// Bytes written and verified (size, SHA-256, signature); not yet bound to a version.
  STORED
  /// Bound to exactly one document or policy version; never deleted.
  ATTACHED
  /// Unreferenced and past the cleanup period (or failed); its object is being removed.
  ABANDONED
  /// Refused (type, size, content or malware); its object is never kept.
  REJECTED
  /// The object was removed from storage; the row stays as the record.
  DELETED
}

/// Batch 9 — malware scanning. NOT_SCANNED is never presented as clean.
enum DocumentScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// Batch 9 — what an upload is for (its authorization and binding).
enum DocumentUploadPurpose {
  EMPLOYEE_DOCUMENT
  SELF_SERVICE
  POLICY_VERSION
}

/// Batch 9 — the durable ledger of uploaded objects: the server-generated key, the organization
/// and target the upload was authorized for, verified metadata (size, SHA-256, detected type),
/// scan state and lifecycle. A version references its object once; cleanup only ever removes
/// objects that were never attached.
model DocumentStoredObject {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @db.Uuid
  purpose          DocumentUploadPurpose
  /// The employee whose record (EMPLOYEE_DOCUMENT, SELF_SERVICE) the upload was authorized for.
  employeeId       String?                    @db.Uuid
  /// The existing document (a new version) or policy the upload was authorized for.
  documentId       String?                    @db.Uuid
  policyId         String?                    @db.Uuid
  /// The storage backend holding the object ('local' or 's3').
  backend          String
  /// Random, server-generated, never derived from client input.
  storageKey       String                     @unique
  status           DocumentStoredObjectStatus @default(UPLOADING)
  scanStatus       DocumentScanStatus         @default(NOT_SCANNED)
  /// A safe display name (sanitized); never used to place the object.
  fileName         String
  detectedMimeType String?
  sizeBytes        Int?
  sha256           String?
  rejectionCode    String?
  uploadedByUserId String                     @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  storedAt         DateTime?                  @db.Timestamptz(6)
  attachedAt       DateTime?                  @db.Timestamptz(6)
  abandonedAt      DateTime?                  @db.Timestamptz(6)
  deletedAt        DateTime?                  @db.Timestamptz(6)
  organization     Organization               @relation("OrganizationDocumentStoredObjects", fields: [organizationId], references: [id], onDelete: Restrict)
  employeeVersion  EmployeeDocumentVersion?   @relation("EmployeeDocumentVersionObject")
  policyVersion    PolicyDocumentVersion?     @relation("PolicyDocumentVersionObject")

  @@index([status, createdAt])
  @@index([organizationId, status])
}

/// An organization policy document (staff handbook, Code of Conduct, technology use…).
/// Each published version is acknowledged separately.
model PolicyDocument {
  id                      String                  @id @default(uuid()) @db.Uuid
  organizationId          String                  @db.Uuid
  typeId                  String?                 @db.Uuid
  code                    String
  title                   String
  description             String?
  status                  PolicyDocumentStatus    @default(DRAFT)
  acknowledgementRequired Boolean                 @default(true)
  /// Simple audience: everyone in the organization, optionally narrowed by employment type
  /// and/or department.
  audienceEmploymentType  EmploymentType?
  audienceDepartmentId    String?                 @db.Uuid
  createdByUserId         String?                 @db.Uuid
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(6)
  retiredAt               DateTime?               @db.Timestamptz(6)
  organization            Organization            @relation("OrganizationPolicyDocuments", fields: [organizationId], references: [id], onDelete: Restrict)
  type                    DocumentType?           @relation(fields: [typeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  audienceDepartment      Department?             @relation("DepartmentPolicyDocuments", fields: [audienceDepartmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  versions                PolicyDocumentVersion[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model PolicyDocumentVersion {
  id                       String                    @id @default(uuid()) @db.Uuid
  policyId                 String                    @db.Uuid
  organizationId           String                    @db.Uuid
  versionNumber            Int
  /// e.g. "2026" or "v3".
  versionLabel             String
  provider                 DocumentStorageProvider
  externalUrl              String?
  storageKey               String?
  externalFileId           String?
  fileName                 String?
  mimeType                 String?
  /// The exact statement employees acknowledge for this version.
  acknowledgementStatement String?
  effectiveOn              DateTime?                 @db.Date
  publishedAt              DateTime?                 @db.Timestamptz(6)
  publishedByUserId        String?                   @db.Uuid
  supersededAt             DateTime?                 @db.Timestamptz(6)
  referenceStatus          DocumentReferenceStatus   @default(UNKNOWN)
  referenceCheckedAt       DateTime?                 @db.Timestamptz(6)
  createdByUserId          String?                   @db.Uuid
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  policy                   PolicyDocument            @relation(fields: [policyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// Batch 9: the uploaded policy file and its size (see EmployeeDocumentVersion).
  storedObjectId           String?                   @unique @db.Uuid
  sizeBytes                Int?
  storedObject             DocumentStoredObject?     @relation("PolicyDocumentVersionObject", fields: [storedObjectId], references: [id], onDelete: Restrict)
  acknowledgements         DocumentAcknowledgement[]

  @@unique([policyId, versionNumber])
  @@unique([id, organizationId])
}

/// An employee's acknowledgement of one policy version (never of later versions). Immutable.
/// "Acknowledged" means received and read — not agreement unless the statement says so.
model DocumentAcknowledgement {
  id                   String                        @id @default(uuid()) @db.Uuid
  organizationId       String                        @db.Uuid
  policyVersionId      String                        @db.Uuid
  employeeId           String                        @db.Uuid
  acknowledgedByUserId String                        @db.Uuid
  /// The statement exactly as acknowledged.
  statement            String
  source               DocumentAcknowledgementSource
  acknowledgedAt       DateTime                      @default(now()) @db.Timestamptz(6)
  policyVersion        PolicyDocumentVersion         @relation(fields: [policyVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employee             Employee                      @relation("EmployeeDocumentAcknowledgements", fields: [employeeId], references: [id], onDelete: Restrict)
  workflowTasks        EmployeeWorkflowTask[]        @relation("WorkflowTaskDocumentAcknowledgement")

  @@unique([policyVersionId, employeeId])
  @@index([employeeId])
}

/// A required employee document for a simple context: the whole organization, or narrowed by
/// employment type, department and/or position.
model DocumentRequirement {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  typeId          String          @db.Uuid
  employmentType  EmploymentType?
  departmentId    String?         @db.Uuid
  positionId      String?         @db.Uuid
  note            String?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  archivedAt      DateTime?       @db.Timestamptz(6)
  organization    Organization    @relation("OrganizationDocumentRequirements", fields: [organizationId], references: [id], onDelete: Restrict)
  type            DocumentType    @relation(fields: [typeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department      Department?     @relation("DepartmentDocumentRequirements", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  position        Position?       @relation("PositionDocumentRequirements", fields: [positionId], references: [id], onDelete: Restrict)

  @@index([organizationId, archivedAt])
}

// ─── Phase 16 — Notifications & Communications ───────────────────────────────

/// Where a notification is delivered. In-app is always delivered; more channels (chat, SMS…)
/// are added as enum values with their own transport adapters.
enum NotificationChannel {
  IN_APP
  EMAIL
}

/// What a notification is about. SECURITY and HR_REQUIRED are mandatory categories: user
/// preferences and organization category settings never suppress them.
enum NotificationCategory {
  SECURITY
  HR_REQUIRED
  ONBOARDING
  DOCUMENTS
  PERFORMANCE
  RECRUITMENT
  LEAVE
  SCHEDULING
  /// Batch 8: time and attendance (corrections, timesheets), separate from SCHEDULING.
  TIME
  PAYROLL
  BENEFITS
  GENERAL
}

/// The domain that produced a notification.
enum NotificationSourceDomain {
  SYSTEM
  AUTH
  ONBOARDING
  DOCUMENTS
  PERFORMANCE
  RECRUITMENT
  LEAVE
  SCHEDULING
  PAYROLL
  BENEFITS
  TIME
}

enum NotificationTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum NotificationSuppressionReason {
  USER_PREFERENCE
  ORGANIZATION_CATEGORY_DISABLED
  ORGANIZATION_EMAIL_DISABLED
  RECIPIENT_INACTIVE
  /// Batch 8 (D2): no email provider (SMTP or Gmail) is configured; not the user's preference.
  EMAIL_PROVIDER_NOT_CONFIGURED
  /// Batch 8 (O1): the email waited past its maximum age (e.g. while the module was disabled).
  DELIVERY_EXPIRED
}

enum NotificationAttemptStatus {
  STARTED
  SUCCEEDED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  /// The worker's lease expired before it recorded a result (crash or timeout).
  ABANDONED
  /// Batch 8 (D1): the send timed out; the provider may or may not have accepted it.
  UNCERTAIN
}

/// A notification template. organizationId NULL is the system default of a notification type
/// (seeded by the API, idempotently); an organization's active template overrides it. Only the
/// system template's allowed variables may appear as {{name}} placeholders.
model NotificationTemplate {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String?                    @db.Uuid
  /// The notification type, e.g. 'onboarding.tasks-due'.
  key              String
  category         NotificationCategory
  subjectTemplate  String
  bodyTemplate     String
  allowedVariables String[]
  /// System templates only: notifications of this type ignore preferences.
  mandatory        Boolean                    @default(false)
  status           NotificationTemplateStatus @default(ACTIVE)
  version          Int                        @default(1)
  createdByUserId  String?                    @db.Uuid
  updatedByUserId  String?                    @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)
  archivedAt       DateTime?                  @db.Timestamptz(6)
  organization     Organization?              @relation("OrganizationNotificationTemplates", fields: [organizationId], references: [id], onDelete: Restrict)
  notifications    Notification[]

  @@index([organizationId, key, status])
}

/// One notification to one user in one organization (the in-app inbox row). Content is short
/// plain text rendered at publish time; the recipient's email address is never stored here.
model Notification {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @db.Uuid
  recipientUserId  String                   @db.Uuid
  type             String
  category         NotificationCategory
  mandatory        Boolean                  @default(false)
  title            String
  body             String
  /// A relative application path only (e.g. /onboarding), never an external URL.
  link             String?
  sourceDomain     NotificationSourceDomain
  sourceEntityType String?
  sourceEntityId   String?                  @db.Uuid
  /// Producer-chosen idempotency key: one notification per (organization, recipient, key).
  dedupeKey        String
  templateId       String?                  @db.Uuid
  templateVersion  Int?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  readAt           DateTime?                @db.Timestamptz(6)
  archivedAt       DateTime?                @db.Timestamptz(6)
  organization     Organization             @relation("OrganizationNotifications", fields: [organizationId], references: [id], onDelete: Restrict)
  recipient        User                     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  template         NotificationTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  deliveries       NotificationDelivery[]

  @@unique([organizationId, recipientUserId, dedupeKey])
  @@unique([id, organizationId])
  @@index([recipientUserId, createdAt])
  /// Phase 19: per-organization retention scan (retention.notificationMonths).
  @@index([organizationId, createdAt])
}

/// The delivery of a notification on one channel. In-app is SENT on creation; email is
/// claimed by the delivery worker and retried with backoff.
model NotificationDelivery {
  id               String                         @id @default(uuid()) @db.Uuid
  notificationId   String                         @db.Uuid
  organizationId   String                         @db.Uuid
  channel          NotificationChannel
  status           NotificationDeliveryStatus
  attemptCount     Int                            @default(0)
  nextAttemptAt    DateTime?                      @db.Timestamptz(6)
  /// While SENDING: when the claiming worker's lease ends (a crashed send is reclaimable).
  leaseExpiresAt   DateTime?                      @db.Timestamptz(6)
  sentAt           DateTime?                      @db.Timestamptz(6)
  lastErrorCode    String?
  suppressedReason NotificationSuppressionReason?
  createdAt        DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @db.Timestamptz(6)
  notification     Notification                   @relation(fields: [notificationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attempts         NotificationDeliveryAttempt[]

  @@unique([notificationId, channel])
  @@unique([id, organizationId])
  @@index([channel, status, nextAttemptAt])
  /// Batch 8: the organization delivery log (newest first, cursor paged).
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
}

/// One attempt to deliver (append-only: recorded STARTED, then completed exactly once). Error
/// details are a code and a short safe message: never the payload, addresses or secrets.
model NotificationDeliveryAttempt {
  id                String                    @id @default(uuid()) @db.Uuid
  deliveryId        String                    @db.Uuid
  organizationId    String                    @db.Uuid
  attemptNumber     Int
  status            NotificationAttemptStatus
  provider          String
  providerReference String?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime                  @default(now()) @db.Timestamptz(6)
  finishedAt        DateTime?                 @db.Timestamptz(6)
  delivery          NotificationDelivery      @relation(fields: [deliveryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([deliveryId, attemptNumber])
  /// Phase 19: per-organization retention scan (retention.deliveryLogMonths).
  @@index([organizationId, startedAt])
}

/// Batch 8 — the durable position of an event notification producer: every event at or before
/// (cursorAt, cursorId) has been published. Producers scan committed domain records after it,
/// up to a horizon behind any open transaction, and advance it only after an event's fan-out
/// is complete. Created at the horizon on first run (history is never notified).
model NotificationProducerCheckpoint {
  producerKey    String   @id
  cursorAt       DateTime @db.Timestamptz(6)
  cursorId       String   @db.Uuid
  bootstrappedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

/// A user's email preference for a category (in-app is always on). Mandatory categories have
/// no preference.
model NotificationPreference {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  category     NotificationCategory
  emailEnabled Boolean
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  user         User                 @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, category])
}

/// An organization's email setting for a category: it may disable non-mandatory email.
model OrganizationNotificationSetting {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  category        NotificationCategory
  emailEnabled    Boolean
  updatedByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  organization    Organization         @relation("OrganizationNotificationSettings", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, category])
}

/// An organization's email kill switch. Disabling email never suppresses mandatory notices
/// unless suppressMandatoryEmail records that explicit decision.
model OrganizationNotificationPolicy {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @unique @db.Uuid
  emailEnabled           Boolean      @default(true)
  suppressMandatoryEmail Boolean      @default(false)
  updatedByUserId        String?      @db.Uuid
  createdAt              DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(6)
  organization           Organization @relation("OrganizationNotificationPolicy", fields: [organizationId], references: [id], onDelete: Restrict)
}

// ─── Phase 16.5 — Google Workspace integrations ──────────────────────────────

/// How an organization's Google Workspace connection authenticates. OAUTH (authorization code
/// + PKCE, offline access, consented by a Workspace admin) is the default; SERVICE_ACCOUNT
/// (domain-wide delegation) is an optional advanced strategy.
enum GoogleConnectionMode {
  OAUTH
  SERVICE_ACCOUNT
}

enum GoogleConnectionStatus {
  ACTIVE
  /// Google refused the credentials (revoked consent, deleted key…): syncing stops until fixed.
  ERROR
  /// Kept for audit history; credentials wiped.
  DISCONNECTED
  /// The credentials cannot be decrypted (encryption key missing or rotated away).
  CREDENTIALS_UNAVAILABLE
}

/// What the connection may be used for; each maps to the minimal Google OAuth scopes.
enum GoogleCapability {
  FORMS
  DRIVE_METADATA
  GMAIL_SEND
  SHEETS_EXPORT
}

enum GoogleFormBindingTarget {
  PERFORMANCE_EVIDENCE
  RECRUITMENT_INTAKE
  ONBOARDING_TASKS
}

enum GoogleSyncTrigger {
  MANUAL
  SCHEDULED
}

enum GoogleSyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// An organization's connection to its Google Workspace. One non-disconnected connection per
/// organization. Credentials (the OAuth refresh token, or the minimal service-account key
/// material) are stored AES-256-GCM encrypted with only the key id beside them — never the key,
/// never an access token.
model GoogleWorkspaceConnection {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @db.Uuid
  mode                 GoogleConnectionMode
  status               GoogleConnectionStatus
  /// The Workspace (hosted) domain the connection belongs to.
  workspaceDomain      String?
  /// The consenting Workspace account (OAUTH) or the impersonated user (SERVICE_ACCOUNT).
  accountEmail         String?
  /// The service account's client email (SERVICE_ACCOUNT only).
  serviceAccountEmail  String?
  grantedScopes        String[]
  capabilities         GoogleCapability[]
  credentialCiphertext String?
  credentialKeyId      String?
  /// Incremented on every credential change (binds the ciphertext and the token cache).
  credentialVersion    Int                    @default(1)
  lastHealthCheckAt    DateTime?              @db.Timestamptz(6)
  lastHealthOk         Boolean?
  lastErrorCode        String?
  createdByUserId      String?                @db.Uuid
  connectedByUserId    String?                @db.Uuid
  connectedAt          DateTime               @default(now()) @db.Timestamptz(6)
  disconnectedByUserId String?                @db.Uuid
  disconnectedAt       DateTime?              @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  organization         Organization           @relation("OrganizationGoogleConnections", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

/// A one-time OAuth authorization request: the state is kept only as a SHA-256 hash, bound to
/// the organization, the initiating user and their browser; the PKCE verifier is encrypted.
model GoogleOAuthState {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  initiatedByUserId      String             @db.Uuid
  stateHash              String             @unique
  browserBindingHash     String
  codeVerifierCiphertext String
  codeVerifierKeyId      String
  requestedScopes        String[]
  capabilities           GoogleCapability[]
  expiresAt              DateTime           @db.Timestamptz(6)
  consumedAt             DateTime?          @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  organization           Organization       @relation("OrganizationGoogleOAuthStates", fields: [organizationId], references: [id], onDelete: Restrict)
  initiatedBy            User               @relation("GoogleOAuthStateInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

/// A Google Form feeding one domain contract of the organization (performance evidence source,
/// recruitment intake source, or onboarding task completion). A form is bound by at most one
/// organization. Uses the organization's current connection; never writes domain tables.
model GoogleFormBinding {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @db.Uuid
  formId               String
  /// The form title when bound (display only).
  formTitle            String?
  target               GoogleFormBindingTarget
  performanceSourceId  String?                    @db.Uuid
  recruitmentSourceId  String?                    @db.Uuid
  /// Validated, versioned question → contract field mapping.
  mapping              Json
  mappingSchemaVersion Int
  enabled              Boolean                    @default(true)
  /// Last processed response: its submission time (fixed 9-digit RFC 3339, comparable as text)
  /// and id. Advances only after the domain ingestion succeeded, monotonically.
  cursorSubmittedAt    String?
  cursorResponseId     String?
  lastSyncAt           DateTime?                  @db.Timestamptz(6)
  lastSuccessAt        DateTime?                  @db.Timestamptz(6)
  lastFailureAt        DateTime?                  @db.Timestamptz(6)
  lastErrorCode        String?
  consecutiveFailures  Int                        @default(0)
  /// Scheduled syncs wait until then after failures (exponential backoff).
  nextSyncAfter        DateTime?                  @db.Timestamptz(6)
  createdByUserId      String?                    @db.Uuid
  updatedByUserId      String?                    @db.Uuid
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  archivedAt           DateTime?                  @db.Timestamptz(6)
  organization         Organization               @relation("OrganizationGoogleFormBindings", fields: [organizationId], references: [id], onDelete: Restrict)
  performanceSource    PerformanceEvidenceSource? @relation(fields: [performanceSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recruitmentSource    RecruitmentIntakeSource?   @relation(fields: [recruitmentSourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  runs                 GoogleSyncRun[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([formId])
}

/// Append-only log of synchronization runs: counts and a safe error code only — never response
/// payloads, answers or respondent emails. At most one RUNNING run per binding.
model GoogleSyncRun {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  bindingId         String                  @db.Uuid
  target            GoogleFormBindingTarget
  trigger           GoogleSyncTrigger
  triggeredByUserId String?                 @db.Uuid
  status            GoogleSyncRunStatus
  startedAt         DateTime                @db.Timestamptz(6)
  leaseExpiresAt    DateTime                @db.Timestamptz(6)
  finishedAt        DateTime?               @db.Timestamptz(6)
  fetched           Int                     @default(0)
  accepted          Int                     @default(0)
  duplicates        Int                     @default(0)
  rejected          Int                     @default(0)
  errorCode         String?
  binding           GoogleFormBinding       @relation(fields: [bindingId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, startedAt])
  @@index([bindingId, startedAt])
}

// ─── Phase 18 — Admin configuration / feature management ─────────────────────

/// A disableable functional area of an organization. Core HR (organization structure,
/// employees, employment assignments, users, roles, authentication, audit) is never listed:
/// it cannot be disabled.
enum OrganizationModule {
  ATTENDANCE
  SCHEDULING
  LEAVE
  COMPENSATION
  PAYROLL
  BENEFITS
  PERFORMANCE
  RECRUITMENT
  ONBOARDING
  DOCUMENTS
  NOTIFICATIONS
  GOOGLE_WORKSPACE
  REPORTING
}

enum OrganizationSettingChangeKind {
  MODULE
  SETTING
}

/// Whether a module is enabled for an organization. No row = the module's default (enabled):
/// existing organizations keep their behaviour. Disabling never deletes or changes domain
/// data; it only refuses access (API, jobs) until re-enabled. `version` drives optimistic
/// concurrency (0 = no row yet).
model OrganizationModuleSetting {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  module          OrganizationModule
  enabled         Boolean
  version         Int                @default(1)
  updatedByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  organization    Organization       @relation("OrganizationModuleSettings", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, module])
}

/// A typed organization setting from the code registry (features-domain.ts): every write is
/// validated against the key's type and bounds; unknown keys are refused. `value` NULL means
/// "back to the registry default" (a reset keeps the row so versions never repeat).
model OrganizationSetting {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  key             String
  value           Json?
  schemaVersion   Int
  version         Int          @default(1)
  updatedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  organization    Organization @relation("OrganizationSettings", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}

/// Append-only change history of modules and settings (the admin area's "change history"):
/// safe values only (booleans, integers, enum values; NULL = default), never secrets.
model OrganizationSettingChange {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @db.Uuid
  kind           OrganizationSettingChangeKind
  /// The module name (MODULE) or setting key (SETTING).
  subject        String
  oldValue       Json?
  newValue       Json?
  /// The row version after the change.
  version        Int
  actorUserId    String?                       @db.Uuid
  /// Security remediation M2: the stated reason (required to disable payroll dual control).
  reason         String?
  changedAt      DateTime                      @default(now()) @db.Timestamptz(6)
  organization   Organization                  @relation("OrganizationSettingChanges", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, changedAt])
}

/// Phase 20 — an organization's branding: references (https URLs) to externally hosted images,
/// never binaries; colors as #RRGGBB. One row per organization; no row = the fallback (the
/// organization's name and the product's default look). `publicLoginEnabled` is the only way
/// any of it reaches the unauthenticated login page (GET /public/branding). `version` drives
/// optimistic concurrency (0 = no row yet).
model OrganizationBranding {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @db.Uuid
  displayName        String?
  shortName          String?
  logoUrl            String?
  iconUrl            String?
  loginLogoUrl       String?
  primaryColor       String?
  secondaryColor     String?
  loginSubtitle      String?
  websiteUrl         String?
  supportEmail       String?
  publicLoginEnabled Boolean      @default(false)
  version            Int          @default(1)
  updatedByUserId    String?      @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  organization       Organization @relation("OrganizationBranding", fields: [organizationId], references: [id], onDelete: Restrict)
}

/// Batch 5A — employee-wide termination history (additive; never deleted). terminationDate is the
/// last day of employment (inclusive). At most one SCHEDULED row per employee (partial unique
/// index). Applied rows are immutable except for the rehire link (trigger).
model EmployeeTermination {
  id                       String                             @id @default(uuid()) @db.Uuid
  employeeId               String                             @db.Uuid
  terminationDate          DateTime                           @db.Date
  status                   EmployeeTerminationStatus          @default(SCHEDULED)
  /// Restricted: shown only to employee-management users covering the employee (Batch 5A, R7).
  reason                   String?
  /// R6: a SYSTEM actor acknowledged that the employee's SYSTEM grants are kept.
  systemGrantsAcknowledged Boolean                            @default(false)
  recordedByUserId         String?                            @db.Uuid
  recordedAt               DateTime                           @default(now()) @db.Timestamptz(6)
  appliedAt                DateTime?                          @db.Timestamptz(6)
  /// IMMEDIATE (already past when recorded), MANUAL (due list) or AUTOMATIC (worker).
  appliedSource            String?
  cancelledAt              DateTime?                          @db.Timestamptz(6)
  cancelledByUserId        String?                            @db.Uuid
  cancellationReason       String?
  supersededById           String?                            @db.Uuid
  rehireAssignmentId       String?                            @db.Uuid
  rehiredAt                DateTime?                          @db.Timestamptz(6)
  createdAt                DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                           @updatedAt @db.Timestamptz(6)
  employee                 Employee                           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recordedBy               User?                              @relation("TerminationRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  cancelledBy              User?                              @relation("TerminationCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  supersededBy             EmployeeTermination?               @relation("TerminationSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes               EmployeeTermination[]              @relation("TerminationSupersession")
  rehireAssignment         EmploymentAssignment?              @relation("TerminationRehireAssignment", fields: [rehireAssignmentId], references: [id], onDelete: Restrict)
  assignments              EmployeeTerminationAssignment[]
  grantDecisions           EmployeeTerminationGrantDecision[]

  @@index([employeeId, status])
  @@index([status, terminationDate])
}

/// Security remediation M3 — the decision about one role grant of a terminated person, and what
/// the application did with it. A KEEP needs a reason and an expiry and is approved by someone
/// other than its requester; REVOKE decisions (always explicit for SYSTEM grants) and the
/// defaults written at application have no approval. A retained grant is an expiring
/// replacement (`retainedRoleAssignmentId`): RoleAssignment.expiresAt is immutable.
model EmployeeTerminationGrantDecision {
  id                       String                         @id @default(uuid()) @db.Uuid
  terminationId            String                         @db.Uuid
  roleAssignmentId         String                         @db.Uuid
  decision                 TerminationGrantDecisionKind
  status                   TerminationGrantDecisionStatus
  /// KEEP: the justification (never the termination reason).
  reason                   String?
  /// KEEP: the requested end of the retention.
  keepUntil                DateTime?                      @db.Timestamptz(6)
  /// Null for a default written at application (no one decided it).
  requestedByUserId        String?                        @db.Uuid
  requestedAt              DateTime                       @default(now()) @db.Timestamptz(6)
  reviewedByUserId         String?                        @db.Uuid
  reviewedAt               DateTime?                      @db.Timestamptz(6)
  reviewNote               String?
  appliedAt                DateTime?                      @db.Timestamptz(6)
  outcome                  TerminationGrantOutcome?
  retainedRoleAssignmentId String?                        @db.Uuid
  /// The retained grant has expired and the login was re-checked (lifecycle due job).
  expiryHandledAt          DateTime?                      @db.Timestamptz(6)
  createdAt                DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                       @updatedAt @db.Timestamptz(6)
  termination              EmployeeTermination            @relation(fields: [terminationId], references: [id], onDelete: Restrict)
  roleAssignment           RoleAssignment                 @relation("TerminationGrantSubject", fields: [roleAssignmentId], references: [id], onDelete: Restrict)
  retainedRoleAssignment   RoleAssignment?                @relation("TerminationGrantRetained", fields: [retainedRoleAssignmentId], references: [id], onDelete: Restrict)
  requestedBy              User?                          @relation("TerminationGrantRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy               User?                          @relation("TerminationGrantReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([terminationId, roleAssignmentId])
  @@index([roleAssignmentId])
  @@index([outcome, expiryHandledAt])
}

/// Batch 5A — one assignment affected by a termination, with what it was before (so a scheduled
/// termination can be cancelled exactly) and when the change took effect.
model EmployeeTerminationAssignment {
  id                     String                              @id @default(uuid()) @db.Uuid
  terminationId          String                              @db.Uuid
  employmentAssignmentId String                              @db.Uuid
  action                 EmployeeTerminationAssignmentAction
  previousStatus         EmploymentAssignmentStatus
  previousEndDate        DateTime?                           @db.Date
  appliedAt              DateTime?                           @db.Timestamptz(6)
  createdAt              DateTime                            @default(now()) @db.Timestamptz(6)
  termination            EmployeeTermination                 @relation(fields: [terminationId], references: [id], onDelete: Restrict)
  employmentAssignment   EmploymentAssignment                @relation(fields: [employmentAssignmentId], references: [id], onDelete: Restrict)

  @@unique([terminationId, employmentAssignmentId])
  @@index([employmentAssignmentId])
}
